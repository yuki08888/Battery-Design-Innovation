{"id": "33353c6d-1259-4bfc-acc7-7db47a645b97", "name": "バスバー非カット要求", "text": "バスバーはカットしないこと。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.807384", "ref": null}, "className": "Requirement"}
{"id": "6a12ee99-af32-4dac-9a19-e7dacb2e1c21", "name": "内部熱電対数量制限要求", "text": "漏液リスク回避のため、内部熱電対は3点とすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.807510", "ref": null}, "className": "Requirement"}
{"id": "f390ced1-49c6-4bf6-b946-847670536af5", "name": "評価条件決定要求", "text": "セル構造またはサーミスタ設置位置から内外温度差が拡大するモードがないかを予測して、評価条件を決定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.807632", "ref": null}, "className": "Requirement"}
{"id": "8215ed41-6897-454a-9d6a-f2f5b5cd1c92", "name": "パック内昇温速度確認要求", "text": "モジュール単品や、セル単品で実施する場合には、車室外の昇温速度が1℃/minの場合のパック内昇温速度を確認した上で評価を行うこと。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.807756", "ref": null}, "className": "Requirement"}
{"id": "fb0bf98d-072d-4d6b-8386-723143acbecb", "name": "7.A(LVH)昇温性能要求", "text": "7.A(LVH)における昇温性能は599.5Wとすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.807912", "ref": null}, "className": "Requirement"}
{"id": "69fcd18c-5ded-4f03-bd52-17bb2751c253", "name": "7.ASU#1(HVCH)および7.B(HVCH)昇温性能要求", "text": "7.ASU#1 (HVCH) および 7.B(HVCH) における昇温性能は7000Wとすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.808130", "ref": null}, "className": "Requirement"}
{"id": "17aeed7b-6f3a-4fe4-b5f1-5e5324df0fad", "name": "7.A車両昇温ヒーター動作要求（環境温度-15℃以下）", "text": "推定環境温度が-15℃以下の条件において、ヒーターON条件を-5℃、ヒーターOFF条件を-1℃とすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.808246", "ref": null}, "className": "Requirement"}
{"id": "4ce570ef-6907-4700-8932-82905a3f6184", "name": "7.A車両昇温ヒーター動作要求（環境温度-10℃以上）", "text": "推定環境温度が-10℃以上の条件において、ヒーターON条件を0℃、ヒーターOFF条件を4℃とすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.808362", "ref": null}, "className": "Requirement"}
{"id": "194d9d0f-a642-4567-b05c-8c56d5ec88bd", "name": "実車の昇温速度を模擬した検証の実施", "text": "実車の昇温速度を模擬した検証をLi7.Bで実施すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.808475", "ref": null}, "className": "Requirement"}
{"id": "f00fd95c-0b79-45d4-80b2-eccc794ccbd8", "name": "通電・冷却時の内外温度差管理要求", "text": "昇温＋充電（通電）時の発熱影響による内部温度上昇を考慮し、非通電時より大きくなる内外温度差を管理・制御すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.808595", "ref": null}, "className": "Requirement"}
{"id": "3e1f6cb7-ea62-45e8-81d7-eeba4dc79dd3", "name": "環境温度マイナス20度開始昇温充電特性要求", "text": "環境温度-20℃から開始し、15A通電、30A通電、およびDC充電パターンにおいて、水温/雰囲気温度、電流、トップカバー/内部温度、および内外温度差を測定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.808712", "ref": null}, "className": "Requirement"}
{"id": "df518b1b-9759-4127-bc6e-75c65c2f270e", "name": "環境温度マイナス10度開始昇温充電特性要求", "text": "環境温度-10℃から開始し、40A通電、80A通電、およびDC充電パターンにおいて、水温/雰囲気温度、電流、トップカバー/内部温度、および内外温度差を測定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.808819", "ref": null}, "className": "Requirement"}
{"id": "875df996-6317-4907-a0b9-c2638e493a6b", "name": "低温環境下大電流評価制限要求", "text": "低温(0℃以下)環境下ではLi析出の懸念があるため、大電流評価は未実施とすること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.808926", "ref": null}, "className": "Requirement"}
{"id": "0206736a-1581-4886-9c93-de8ae2c8059c", "name": "急速充電時の電流拡大による影響確認要求", "text": "急速充電電流の拡大する7.Bにおいては、電流による内外温度差が増大する懸念があるため、7.A評価条件に加え、電流値の拡大及び電流スイープによる影響確認を実施すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.809035", "ref": null}, "className": "Requirement"}
{"id": "12849a7d-c900-406c-a2a0-46f1bf40aa2d", "name": "環境温度25℃条件での電流別通電試験要求", "text": "環境温度25℃の条件下において、電流値（350A、450A、および150Aから400Aのスイープ）に応じた通電時のトップカバーと内部の温度変化、および内外温度差を評価すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.809169", "ref": null}, "className": "Requirement"}
{"id": "777c3116-02e9-478f-8de6-a6e2cc17b681", "name": "内外温度差の電流二乗値（I^2）相関確認要求", "text": "連続通電およびスイープ評価（負荷増・負荷減）において、電流の二乗値（I^2値）と内外温度差に相関があることを確認すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.809281", "ref": null}, "className": "Requirement"}
{"id": "10d46837-7cf9-4ac8-9f0a-57b9a772a55a", "name": "冷却器作動時の内外温度差評価要求", "text": "セルが高温状態において車両の冷却器が作動している場合、冷却による影響を含めた内外温度差の発生状況を評価すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.809386", "ref": null}, "className": "Requirement"}
{"id": "df24cb18-698c-4489-869e-989f8028b10f", "type": "containment", "sourceId": "926014b7-826f-4513-ba95-5f6a92912104", "targetId": "10d46837-7cf9-4ac8-9f0a-57b9a772a55a", "name": null, "description": null, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.809418", "ref": null}, "connectorType": null, "flowType": null, "guard": null, "edgeType": null, "sequenceOrder": null, "className": "Relationship"}
{"id": "95ca57c8-3bf0-4499-8e9b-d8b5b31da18a", "name": "通電時内外温度差とI^2値の相関管理要求", "text": "水温が同じ環境において、I^2値と内外温度差の相関を評価し、傾向を明確にすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.809480", "ref": null}, "className": "Requirement"}
{"id": "c20a0c28-3836-42e6-8ee5-a554cc7647fb", "name": "冷却水温度低下時の内外温度差拡大考慮要求", "text": "I^2値が同一であっても、冷却水温度が低い場合に内外温度差が拡大する特性を設計または制御に反映すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.809551", "ref": null}, "className": "Requirement"}
{"id": "12bb2429-6f75-44fc-9a92-99021b897782", "name": "通電冷却時の温度逆転挙動考慮要求", "text": "通電と冷却が同時に発生する場合、端子発熱の影響でトップカバー温度が高くなり、電極温度の方が低くなる温度挙動を考慮すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.809618", "ref": null}, "className": "Requirement"}
{"id": "a24edc58-30d2-4ffc-8e34-26b4c66c4e21", "name": "通電冷却時の内外温度差評価要求", "text": "通電により温度が変化し更に冷却される環境（環境温度30℃にて冷却水温0℃または-20℃、電流値150Aまたは250A）において、内外温度差の確認評価を実施すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.809685", "ref": null}, "className": "Requirement"}
{"id": "36003386-554a-4c11-99b4-d6b8f3d05ec2", "name": "特性同等性検証要求", "text": "通電+冷却条件（7.B）において、通電のみの条件（7.A）と同等の特性が得られるか検証すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.809782", "ref": null}, "className": "Requirement"}
{"id": "666672ea-abe3-4201-9d00-8f6b9db81921", "name": "急速充電時の内外温度差確認要求", "text": "急速充電模擬において、通電と冷却による電池の内外温度差を確認し評価すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.809848", "ref": null}, "className": "Requirement"}
{"id": "ca0a066a-5461-4a60-8a67-93889436630f", "name": "通電電流追従型内外温度差制御要求", "text": "7.Bにおいて、常温以上の領域での性能低下を避けるため、通電している電流値(50A, 150A, 250A, 400A, 409A)に応じて内外温度差の目標温度を変動させる制御を織り込むこと。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.809914", "ref": null}, "className": "Requirement"}
{"id": "6f785ca5-b114-4f25-95fb-23043c5fcdb6", "name": "模擬評価要求", "text": "実車の各種条件下で温度データ取得が出来ない際には、実車を模擬した状態で評価を実施すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.809981", "ref": null}, "className": "Requirement"}
{"id": "e4f55eda-ae25-4f40-b977-93590516a6d2", "type": "containment", "sourceId": "926014b7-826f-4513-ba95-5f6a92912104", "targetId": "6f785ca5-b114-4f25-95fb-23043c5fcdb6", "name": null, "description": null, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.810013", "ref": null}, "connectorType": null, "flowType": null, "guard": null, "edgeType": null, "sequenceOrder": null, "className": "Relationship"}
{"id": "e5b41c31-e545-4e93-abd8-23c62d260edd", "name": "ミニスタック防風設置要求", "text": "恒温槽からの冷却風等による局所的な冷却を防ぎ正確なサーミスタ温度測定を行うため、ミニスタック評価時には防風を取り付けて評価を行うこと。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.810046", "ref": null}, "className": "Requirement"}
{"id": "2df099b5-aee2-454d-af46-7b276acba0c3", "name": "底面冷却機能付与要求", "text": "実パック同様の底面冷却を考慮する際には、底面に熱伝導材を取り付けて冷却機能を付与した試験をすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.810113", "ref": null}, "className": "Requirement"}
{"id": "164eba64-e4aa-457f-a4e7-a477a43b4b7f", "name": "冷却条件合意要求", "text": "冷却条件については、温調設計と事前に議論し合意したもので試験を実施すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.810181", "ref": null}, "className": "Requirement"}
{"id": "fe874684-dee2-4b23-aab3-5ebf90f8edd5", "name": "環境温度変化評価における昇温条件適合要求", "text": "環境温度変化時の試験は、MBVの要求に合わせて外気の昇温速度を設定するのではなく、実際のパック内温度の推移に合わせた昇温条件で実施すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.810253", "ref": null}, "className": "Requirement"}
{"id": "528fd9f8-23d4-4ef8-b754-43b9de492ac6", "name": "昇温評価条件の遵守要求", "text": "環境温度および水温を振って昇温を実施し、指定された水温、環境温度、SOC、流量の条件（Li6.A_条件1：水温-20℃/環境温度-30℃/SOC18%/流量4.4L、Li6.A_条件2：水温-5℃/環境温度-30℃/SOC18%/流量4.4L、Li6.A_条件3：水温0℃/環境温度-30℃/SOC18%/流量4.4L、Li6.B：水温50℃/環境温度-10℃/SOC20%/流量6.0L）を満たすこと。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.810332", "ref": null}, "className": "Requirement"}
{"id": "ac28553e-dcd6-4863-81a0-05f1e71bf590", "name": "ソーク時内外温度差要求", "text": "ソーク条件において、電池の内部と外部の温度差は2℃以下とすること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.810397", "ref": null}, "className": "Requirement"}
{"id": "c5f301bc-7055-4989-92cd-f7f732989ccb", "name": "平衡時内外温度差評価要求", "text": "通電および冷却プレートからの熱引けによる影響を考慮し、電極体中央部、タブ付近、および缶底付近の各部位における平衡時の内外温度差および温度関係を正しく評価すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.810461", "ref": null}, "className": "Requirement"}
{"id": "f281ed4e-3146-475d-82cd-5cf515a91e37", "name": "通電＋冷却ON評価での温度上昇測定要求", "text": "通電および冷却をONにした特定の評価条件（水温、環境温度、SOC、電流パルス、流量）において、電池内の各部（電極体、タブ付近、集電体など）の温度上昇を測定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.810544", "ref": null}, "className": "Requirement"}
{"id": "43926683-d445-457a-8b3e-318c9c36be14", "name": "通電＋冷却ON時の内外温度差評価要求", "text": "通電および冷却をONにした条件において、冷却水流動直後のセル下面冷却影響やタブ付近の温度上昇を踏まえ、電池の内外温度差を評価すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.810609", "ref": null}, "className": "Requirement"}
{"id": "379367b6-6c7a-4ea5-86e5-f8e73c620d00", "name": "走行時冷却開始温度要求", "text": "走行中における冷却ONの作動温度は38℃とすること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.810703", "ref": null}, "className": "Requirement"}
{"id": "13d602d3-8207-425a-b7c5-2a1fb2a8b7b0", "name": "走行時冷却停止温度要求", "text": "走行中における冷却OFFの作動温度は36℃とすること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.810786", "ref": null}, "className": "Requirement"}
{"id": "8fb95744-57c2-4615-bc0e-e80b4032f3e5", "name": "Li6.B急速充電時保護要求", "text": "Li6.Bにおいて、35℃まで一時許容マップを拡大することに伴い、急速充電時（430A×冷却時など）に発生する最大10℃の内外温度差に対して保護不足とならないよう、追加保護を適用すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.810857", "ref": null}, "className": "Requirement"}
{"id": "2801b5d8-f3c6-4783-90b0-0e127ab9ef13", "name": "Li6.B・45PL DC充電中内外温度差計上要求", "text": "Li6.Bと45PLを組み合わせる際、3セルMOD試験データ（430A×0℃冷却時の内外温度差）および急速充電時の車両冷却性能を踏まえ、DC充電中に限定してMBVにて5.85℃の内外温度差を計上すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.810924", "ref": null}, "className": "Requirement"}
