{"id": "511b92d6-d9f9-4b43-a252-66788ff2b1fe", "name": "温度軸内外温度差オフセット要求", "text": "電池の温度を元にした定数設計（DC充電制御マップ）において、サーミスタ設置位置温度と電極内部温度の差を考慮し、温度軸を内外温度差に従ってオフセットすること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.806258", "ref": null}, "className": "Requirement"}
{"id": "7ef89271-b3b0-44f1-bfd7-11382a61ffea", "name": "起動禁止時間設定要求", "text": "起動禁止温度以下の社会において、起動禁止温度から起動可能温度に到達した後に設ける起動禁止時間（Ready-wait）を、内外温度差の影響を考慮して適切に設計すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.806607", "ref": null}, "className": "Requirement"}
{"id": "0f31a553-9455-4002-9527-da75a8c2187e", "name": "評価品素性確認要求", "text": "評価品の素性によって評価結果が異なってしまうため、評価品の素性は十分に確認を行うこと。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:22:51.806832", "ref": null}, "className": "Requirement"}
