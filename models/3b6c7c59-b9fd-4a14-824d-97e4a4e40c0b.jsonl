{"id": "0a8da293-e537-4200-b880-18d072815466", "name": "自己放電マップ規定要求", "text": "上下限含め保証可能な自己放電マップ（温度×SOC依存性）を規定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.270969", "ref": null}, "className": "Requirement"}
{"id": "77680591-d64f-4f53-a232-611506b79bf4", "name": "長期放置後出力維持要求", "text": "通常製品において、車両出荷から海上輸送を経てヤード長期放置された後であっても、走行に必要な出力を出せるSOCを維持すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.272939", "ref": null}, "className": "Requirement"}
{"id": "4e949fd1-fae9-4ba7-ae9e-603fd8c412ce", "name": "補給品輸送後SOC維持要求", "text": "補給品において、車両組付け時に仕向先港と同等以上のSOCを維持すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.274990", "ref": null}, "className": "Requirement"}
{"id": "c5bd0b9a-ec15-4e7f-9001-e0f6d5665323", "name": "均等化回路SOC収束要求", "text": "均等化回路でセルのSOCばらつきが収束可能なこと。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.278757", "ref": null}, "className": "Requirement"}
{"id": "f5b5b1a6-21d3-4483-9428-177f48528687", "name": "検査時SOC等提示要求", "text": "自己放電特性をもとに、受入検査および出荷検査のTIS向けにSOCまたはOCVを提示すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.280758", "ref": null}, "className": "Requirement"}
{"id": "321cdd10-5375-4c78-875a-23ef05da89b6", "name": "同等品質担保要求", "text": "3.B/3.Dと同等程度の電圧低下速度を目安とし、過検出とならない検査基準を設定して品質を担保すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.282600", "ref": null}, "className": "Requirement"}
{"id": "b4323f7b-6188-4366-af5b-547e31eed7f1", "name": "海外仕入先要求仕様書記載要求", "text": "新規仕入先（特に海外メーカー）への要求仕様書には、検査規格を含むすべての基準を記載すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.283435", "ref": null}, "className": "Requirement"}
{"id": "a00e611a-02c9-4163-aead-1aec62e5abda", "name": "物流・補給品前提早期提示要求", "text": "物流および補給品などの前提条件は、寿命試算等に影響するため、できるだけ早い時期に同時進行で提示すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.284990", "ref": null}, "className": "Requirement"}
{"id": "ff3bb1bc-1a92-4f12-91f5-be6d98fe2096", "name": "自走最低必要出力確保要求", "text": "仕向地港での自走に必要な出力（27PL最低必要出力12.9kW@-10℃）を満たすために、一定以上のSOCを維持すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.285813", "ref": null}, "className": "Requirement"}
{"id": "0b017966-a4ca-4c17-bf55-316aa9c2ddce", "name": "自走下限出力SOC維持要求", "text": "現地港滞留およびディーラー在庫期間を含む長期放置後に、自走下限出力が可能なSOCを維持すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.286827", "ref": null}, "className": "Requirement"}
{"id": "abdd3513-af03-475d-b965-74a619e73700", "name": "通常製品輸送保管環境適合要求", "text": "通常製品のセル出荷からモジュール出荷、車両出荷、海上輸送、ヤード長期放置に至る一連の輸送・保管プロセスにおいて、各フェーズの想定温度・日数・暗電流等の影響を考慮しても要求SOCを維持できること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.288302", "ref": null}, "className": "Requirement"}
{"id": "8642bb07-76d0-4401-95e8-30c2467c4d42", "name": "補給品輸送保管環境適合要求", "text": "補給品の車両出荷、海上輸送、倉庫長期放置に至る一連の輸送・保管プロセスにおいて、最悪条件を考慮しても要求SOCを維持できること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.289017", "ref": null}, "className": "Requirement"}
{"id": "f4e0f38d-a277-4294-bb95-ea94d29d3526", "name": "出荷下限SOC設定要求", "text": "各サプライヤーと調整の上、適切な出荷下限SOC（Li7.Aは下限33.5%、6.Aは下限14%）を設定すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.290859", "ref": null}, "className": "Requirement"}
{"id": "978d4878-78ca-4178-9f36-09961f7eecef", "name": "補給品長期放置後自走可能SOC維持要求", "text": "補給品としての電池パックにおいて、車両出荷から海上輸送を経て現地ヤードを含む合計548日間の長期放置後であっても、ディーラー到着時に走行下限出力可能SOC以上の容量を維持すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.291794", "ref": null}, "className": "Requirement"}
{"id": "27edbbec-230e-48a9-9f52-e9034dc47002", "name": "放置後到達SOC算出要求", "text": "電池セル自己放電量による電圧低下と負極表面の被膜形成に伴う容量ずれに基づき、拡散方程式を用いて放置後の到達SOCを算出すること。ただし材料ごとの挙動確認を行うこと。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.293000", "ref": null}, "className": "Requirement"}
{"id": "6303d651-6963-4843-b7c8-e9e93c710f8e", "name": "自己放電量積算要求", "text": "自己放電量の積算は、寿命試算と同様にマイナー則に従って実施すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.294858", "ref": null}, "className": "Requirement"}
{"id": "c27aff7c-e341-46b8-9c28-e63d90c9c898", "name": "均等化回路暗電流考慮要求", "text": "セル電圧均等化暗電流による電圧低下量は、暗電流I(A)と電池容量(Ah)から算出すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.295799", "ref": null}, "className": "Requirement"}
{"id": "1eaeff12-eed1-49f5-a1bc-7482f168f959", "type": "containment", "sourceId": "3b6c7c59-b9fd-4a14-824d-97e4a4e40c0b", "targetId": "c27aff7c-e341-46b8-9c28-e63d90c9c898", "name": null, "description": null, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.296747", "ref": null}, "connectorType": null, "flowType": null, "guard": null, "edgeType": null, "sequenceOrder": null, "className": "Relationship"}
{"id": "aaa1eb0d-99ca-4eb1-83fb-fca325182a8e", "name": "車両消費電力考慮要求", "text": "車両動作検査、自走、エアコン使用などによる消費を考慮してSOC低下量を算出すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.296861", "ref": null}, "className": "Requirement"}
{"id": "ceb685c1-ed44-40b8-be44-18f415405ee3", "name": "自己放電マップ提示要求", "text": "電池セル起因である自己放電ばらつきを算出するために、自己放電上下限（±3σ）仕様の自己放電マップ（SOC低下量×温度×SOC）を提示すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.297459", "ref": null}, "className": "Requirement"}
{"id": "d5a07b71-23e6-4ea1-b178-2ecb398b4dcc", "name": "電池データ提出要求", "text": "電池データ要求書上の全範囲（放置温度 -35℃から60℃、放置SOC 0%から100%）の格子点の自己放電マップデータを提出すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.297831", "ref": null}, "className": "Requirement"}
{"id": "25d598ee-37df-45c9-98a1-881c56462ed4", "type": "containment", "sourceId": "3b6c7c59-b9fd-4a14-824d-97e4a4e40c0b", "targetId": "d5a07b71-23e6-4ea1-b178-2ecb398b4dcc", "name": null, "description": null, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.298857", "ref": null}, "connectorType": null, "flowType": null, "guard": null, "edgeType": null, "sequenceOrder": null, "className": "Relationship"}
{"id": "4a16ac44-d111-4dc4-b765-85a99b28e015", "name": "安全率考慮マップ提示要求", "text": "NBVへは適切な安全率を持った自己放電の上下限MAPを提示すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.299124", "ref": null}, "className": "Requirement"}
{"id": "a92c4e14-bc9a-439e-b140-a553c7447acd", "name": "パック検査時電池セル抵抗規定要求", "text": "パック検査時における電池セル抵抗良品範囲を規定すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.300882", "ref": null}, "className": "Requirement"}
{"id": "24f6c30b-d7f4-41f9-8177-d9b52e7387ef", "name": "パック出荷時電圧およびSOC規定要求", "text": "パック出荷時における電池セル電圧およびSOC良品範囲を規定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.301835", "ref": null}, "className": "Requirement"}
{"id": "c809cfc5-10e1-4bf6-813f-de180bf969fa", "name": "電圧SOC変換規定要求", "text": "各検査における電池電圧と電池SOC変換のためのSOC-OCVを規定すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.303073", "ref": null}, "className": "Requirement"}
{"id": "a8154ccb-7557-4c25-a162-849d92405993", "name": "自己放電マップ条件取得要求", "text": "27PL Li7.A搭載セルにおいて、自己放電マップとして最低限指定された温度およびSOC条件（放置温度-15℃〜45℃かつ放置SOC10%〜30%の範囲、放置温度30℃〜40℃かつ放置SOC10%〜100%の範囲、放置温度10℃〜45℃かつ放置SOC10%〜40%の範囲）を取得すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.304886", "ref": null}, "className": "Requirement"}
{"id": "4802976a-84ad-43d9-bc6a-f9ea55768dee", "name": "自己放電マップ取得範囲要求", "text": "CENおよび±3σを取得すること。また、できるだけ広範囲で取得することを推奨する。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.305179", "ref": null}, "className": "Requirement"}
{"id": "e220d0ed-8ff0-46fe-a5dd-7ca1c60f2a21", "name": "550日放置後起動要求", "text": "HEV 550日放置後に充電可能であり、エンジンが始動できること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.306900", "ref": null}, "className": "Requirement"}
{"id": "c3e2a44a-6683-4057-8273-2a97cec5e9df", "name": "7.A自己放電量規格要求", "text": "7.A製品における自己放電量（電圧低下速度）の最終目標値をスタック平均+0.05mV/day（量産初期は+0.076mV/day）とすること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.307205", "ref": null}, "className": "Requirement"}
{"id": "5f5fdaf0-6178-479f-ba7b-67c2a9e3c016", "name": "3.D自己放電量規格要求", "text": "3.D製品における自己放電量（電圧低下速度）をスタック平均+0.05mV/dayとすること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.308906", "ref": null}, "className": "Requirement"}
{"id": "918fba95-86b9-4e7d-8cde-4398a26fa8a9", "name": "6.A自己放電量規格要求", "text": "6.A製品における自己放電量（電圧低下速度）をスタック平均+0.066mV/dayとすること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.309891", "ref": null}, "className": "Requirement"}
{"id": "41b84d75-78b1-4562-953d-7c4f6b5e797c", "name": "自己放電量3シグマ上限要求", "text": "3σ上限セルの自己放電量は、Table 3.5.1の「3.D実力相当」の値とすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.311050", "ref": null}, "className": "Requirement"}
{"id": "919595ab-2b6f-442c-8761-f0e9c4943ca7", "name": "SOCばらつき変動要求", "text": "各検査グループにおいて、30〜35℃、80%SOCで30日経過後のΔSOCのばらつき(Upper_+3σ - Lower_-3σ)は2.2%以下であること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.311892", "ref": null}, "className": "Requirement"}
{"id": "cf3e8a14-2ac0-42ab-9ba0-b75eb2955d04", "name": "品位基準上限セル要求", "text": "上限セルの自己放電量は、検査グループにおける平均OCV低下量 + 0.05mV/day以下とすること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.312785", "ref": null}, "className": "Requirement"}
