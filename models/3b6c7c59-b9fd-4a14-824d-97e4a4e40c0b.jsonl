{"id": "445317ab-36d6-4518-a4bd-1aaa2de03bd8", "name": "車両システム物流要件充足要求", "text": "車両、システム、および物流の各要件を満足すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:35:25.270546", "ref": null}, "className": "Requirement"}
