{"id": "06a32978-4c34-4c15-962f-b698c7ac7e59", "name": "要求", "description": "要求要素", "isReferenceModel": false, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:30:56.931942", "ref": null}, "className": "Package"}
{"id": "57deb38b-634e-4bee-b12f-7a28cfbf2c76", "name": "Li析出保護電圧制御要求", "text": "充電中にSOCおよび温度に応じたLi析出保護電圧に到達したことを検知した場合、充電電流を制限すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:31:52.828332", "ref": null}, "className": "Requirement"}
{"id": "718e3edd-2080-451a-a377-78f4c96a9fa5", "type": "containment", "sourceId": "06a32978-4c34-4c15-962f-b698c7ac7e59", "targetId": "57deb38b-634e-4bee-b12f-7a28cfbf2c76", "name": null, "description": null, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:31:52.828454", "ref": null}, "connectorType": null, "flowType": null, "guard": null, "edgeType": null, "sequenceOrder": null, "className": "Relationship"}
{"id": "c5d0fca6-0a96-4153-ad4e-ee8b80e76c89", "name": "Li析出無有害保護電圧設定要求", "text": "通電試験および急速充電試験後の電池解体評価に基づき、負極表面上に有害なLi析出が発生しない電圧をLi析出保護電圧として設定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:31:52.830486", "ref": null}, "className": "Requirement"}
{"id": "74d9dd30-385d-405d-9802-bf5d71b56f41", "name": "保護電圧安全率加味要求", "text": "Li析出保護電圧の設定時には、電池設計における安全率を加味すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:31:52.832501", "ref": null}, "className": "Requirement"}
{"id": "68a83305-71d2-458f-8e6b-5eeccec99b83", "name": "温度依存充電プロファイル取得要求", "text": "600sec/急速充電試験により得られたLi析出保護電圧に基づき、Li6.A電池セルの温度違いの充電プロファイルを取得すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:31:52.835363", "ref": null}, "className": "Requirement"}
{"id": "49100da6-c41c-430c-8c48-0dcf5be0098a", "name": "拡散抵抗算出要求", "text": "各温度およびSOCに応じて、充電CCV、OCV、および充電電流(I)から、式1（(充電CCV(t) - OCV(t)) / I = R）を用いて拡散抵抗(R)を算出すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:31:52.838423", "ref": null}, "className": "Requirement"}
{"id": "8c2dd79b-c81d-41b3-b9ec-01162d89ba91", "name": "到達温度適用要求", "text": "電池発熱による電圧制御の早期作動（早掛かり）を防ぐため、狙いSOCに対して通電後に到達した温度を正として適用すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:31:52.840614", "ref": null}, "className": "Requirement"}
{"id": "d9257f6e-47c5-4a61-ba72-75166e35afab", "name": "拡散抵抗マップへの必要範囲及び抵抗閾値の織り込み要求", "text": "拡散抵抗マップを作成するにあたり、SOC/温度の必要範囲（Li6.A電池では、一次許容マップ範囲0～25℃のマップ外結果も含め、必要に応じて内挿すること）およびΣD_抵抗閾値（Li6.A電池では抵抗倍率1.06倍を加味し、他電池では閾値に応じて変更すること）を反映させること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:31:52.842173", "ref": null}, "className": "Requirement"}
{"id": "f600738a-c6fe-4fd9-8f42-baa09b2146b4", "name": "パック実機充電異常挙動確認要求", "text": "パック実機における急速充電時に、各SOCに応じた温度/電流に対するCCV値に対して、CCVの早掛かり等の異常挙動が無いことを確認すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:31:52.843997", "ref": null}, "className": "Requirement"}
{"id": "68f74564-fdf1-4cf3-a995-d81d45ec5818", "name": "打点数の事前協議と決定要求", "text": "温度、電流、SOCの打点数は、MBVで準備しているソフトに応じて変わるため、事前協議を行い、打点数を事前に決定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:31:52.845997", "ref": null}, "className": "Requirement"}
{"id": "805b37e1-dd9d-471c-8e48-2d43093e1632", "name": "配線抵抗の織り込み要求", "text": "単セルからパックの配線抵抗分を加味して計算を行うこと。例としてLi6.A電池においては、17.27mΩ（96セル分）を単セル当たりに換算して織り込むこと。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:31:52.848020", "ref": null}, "className": "Requirement"}
{"id": "14fc92db-606e-4148-b777-64b843d2132b", "name": "制御誤差の織り込み要求（電池保護側設定）", "text": "SOC推定誤差、電流センサー誤差、電圧検出誤差、温度センサ誤差について、電池の保護側になるように誤差を織り込むこと。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:31:52.848468", "ref": null}, "className": "Requirement"}
{"id": "9615619e-69bc-4ae8-aa21-7851cdc3a725", "name": "劣化に応じたCCVガード値の設計または切り替え要求", "text": "セル劣化による電圧のCCVガード値到達を防ぐため、劣化に応じてCCVガード値を切り替えられる制御にするか、または初期品の拡散抵抗に経年劣化係数を乗じた値を元にCCVガード値を適合すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:31:52.850501", "ref": null}, "className": "Requirement"}
{"id": "0382174b-fbc6-4f85-9cf7-1b06539c9de4", "name": "CCVガードの電流制限回避要求", "text": "CCVガードは定数設計不備のポカヨケとするため、想定内の劣化状態においては電流制限がかからないように設計すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:31:52.852163", "ref": null}, "className": "Requirement"}
{"id": "aead257f-22a1-47b1-99d8-92bf9a665fd2", "name": "制御誤差込みのLi析出保護電圧設定要求", "text": "配線抵抗、制御誤差、およびSOC誤差（例：SOC20をSOC15として考慮）を加味して、制御誤差込みのLi析出保護電圧を設定すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:31:52.853086", "ref": null}, "className": "Requirement"}
{"id": "a6fe2304-42a8-4410-9769-6cf2b32a86a8", "name": "CCVガードの定義明確化要求", "text": "CCVガードが何を実現したい制御であるか、また導入によって低減されるリスクおよびリスクランクの変化を明確に定義すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:31:52.857103", "ref": null}, "className": "Requirement"}
{"id": "ce7ffe51-d8f3-405e-a3b7-fdcc49f4bab4", "name": "CCVガード導入に伴う安全背反評価要求", "text": "CCVガードの導入によって異常のあるセルを使い続けられるようになることに対する安全上の背反（ダイアグ検知不可のリスクなど）を評価し、異常時に安全にセルが機能停止するかを確認すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:31:52.860578", "ref": null}, "className": "Requirement"}
{"id": "0995ec53-e9fe-4231-854d-165a490adbea", "name": "CCVガード設計用拡散抵抗劣化係数の算出要求", "text": "CCVガードの設計において、全体抵抗ではなく、個別の拡散抵抗の劣化係数を考察し、その具体的な値を決定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:31:52.861415", "ref": null}, "className": "Requirement"}
