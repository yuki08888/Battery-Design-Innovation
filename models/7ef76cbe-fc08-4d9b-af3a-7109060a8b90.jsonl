{"id": "3f1b31c8-e30a-4254-b939-535760095b91", "name": "高温高湿試験温度要求", "text": "試験温度は、作動保証温度の上限温度である60℃とすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.464771", "ref": null}, "className": "Requirement"}
{"id": "ce53b719-197b-4ff7-88a4-724dfed7e4be", "name": "高温高湿試験湿度要求", "text": "試験湿度は、制御可能な最も高い湿度である95%RHとすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.465710", "ref": null}, "className": "Requirement"}
{"id": "95d5f166-c39a-45aa-a37b-329681501fa7", "name": "高温高湿試験保持時間要求", "text": "試験の保持時間は、バンコクにおける25年超の腐食負荷に相当する2000時間とすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.465895", "ref": null}, "className": "Requirement"}
{"id": "e06460cf-5322-440d-af65-531655bc0747", "name": "高温高湿試験電池SOC要求", "text": "試験時の電池SOCは、満充電かつシステム変更時の使用上限値を包含できる100%とすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.466003", "ref": null}, "className": "Requirement"}
{"id": "ea99d4af-b25d-40c2-b432-d08a9e594c04", "name": "高温高湿試験拘束要求", "text": "試験時の拘束条件は、スタック組付け時の負荷相当として、Li6.A/Bではセル厚みセンター定寸、Li7.A/Bでは3.0kNとすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.466111", "ref": null}, "className": "Requirement"}
{"id": "d0024963-d55d-40d8-8281-6dc86a7f2682", "name": "高温高湿負荷包含要求", "text": "高温高湿による腐食に対する負荷は、60℃95%RHに包含されること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.466219", "ref": null}, "className": "Requirement"}
