{"id": "2d265411-9998-4f6d-b7d7-de6a668ad1d6", "name": "膨化量計算制約", "description": "充電ないし劣化等による状態変化における、変化前後の拘束状態のセル厚みの差。", "inputNames": ["cell_thickness_initial", "cell_thickness_changed"], "outputNames": ["swelling_amount"], "parameters": {}, "code": "swelling_amount = cell_thickness_initial - cell_thickness_changed", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T09:07:11.568718", "ref": null}, "className": "ConstraintBlock"}
{"id": "83e70658-f202-42b4-9ed6-30ecb853ad15", "name": "充電膨化量計算制約", "description": "充電前のSOC αの拘束状態のセル厚みと充電後のSOC βの拘束状態のセル厚みの差。", "inputNames": ["cell_thickness_before_charge", "cell_thickness_after_charge"], "outputNames": ["charge_swelling_amount"], "parameters": {}, "code": "charge_swelling_amount = cell_thickness_before_charge - cell_thickness_after_charge", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T09:07:11.568994", "ref": null}, "className": "ConstraintBlock"}
{"id": "b17d4085-4af2-4e78-b9f4-dd2e75f3abbe", "name": "劣化膨化量計算制約", "description": "充放電サイクル前後の同一SOCにおけるセル厚みの差。", "inputNames": ["cell_thickness_before_cycle", "cell_thickness_after_cycle"], "outputNames": ["degradation_swelling_amount"], "parameters": {}, "code": "degradation_swelling_amount = cell_thickness_after_cycle - cell_thickness_before_cycle", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T09:07:11.569251", "ref": null}, "className": "ConstraintBlock"}
{"id": "bbf2f483-d4f6-4330-900b-e27f21168e07", "name": "スライド量算出制約", "description": "ある状態における図面定義荷重におけるセル厚みCと、充電ないしサイクル劣化による状態変化が生じた時の同荷重におけるセル厚みDとの差(D-C)をスライド量とする。", "inputNames": ["thickness_before", "thickness_after"], "outputNames": ["slide_amount"], "parameters": {}, "code": "slide_amount = thickness_after - thickness_before", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T09:07:11.569885", "ref": null}, "className": "ConstraintBlock"}
{"id": "78db05b2-fb2b-4ade-859f-d56fe62e0002", "name": "劣化スライド量算出制約", "description": "温度頻度およびアレニウスの式（温度依存の膨化速度）を加味して、各走行モデル・温度における劣化スライド量を算出する。", "inputNames": ["t_list", "dist_t_list", "eol_sum_i"], "outputNames": ["degradation_slide"], "parameters": {}, "code": "import math\n\n# E/R = -2357.72\n# A = 5.3906\n# text specifies: E_de = sum( exp( (E / (R*T)) + A ) * sqrt(EOL_sum_I) * distT )\n# Assuming inputs are lists/arrays of temperatures T (in K) and distT (temperature frequency in % as decimal or percent),\n# and a single scalar EOL_sum_I (total discharge in kAh).\n# Note: we use standard math library for exp and sqrt.\n\ne_over_r = -2357.72\na = 5.3906\n\n# Calculate the sum over all temperature bins\ntemp_sum = 0.0\nfor t_val, dist_val in zip(t_list, dist_t_list):\n    # exp( (E/R)*(1/T) + A ) * sqrt(eol_sum_i) * dist_val\n    # If dist_t_list is in percent (e.g., 10 for 10%), we might need to scale, but we follow the raw formula.\n    term = math.exp((e_over_r / t_val) + a) * math.sqrt(eol_sum_i) * dist_val\n    temp_sum += term\n\ndegradation_slide = temp_sum", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T09:07:11.571195", "ref": null}, "className": "ConstraintBlock"}
{"id": "a910c1a6-5d69-4a12-ae5c-c193e3684565", "name": "セル厚み計算制約", "description": "セル厚みを求めるための計算式", "inputNames": ["displacement_dg", "metal_plate_thickness", "displacement_center"], "outputNames": ["cell_thickness"], "parameters": {}, "code": "cell_thickness = displacement_dg - metal_plate_thickness - displacement_center", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T09:07:11.571308", "ref": null}, "className": "ConstraintBlock"}
{"id": "24586115-9b97-477f-ace2-575e2c02bb5a", "name": "セル膨化量計算制約", "description": "セルの膨化量を組付け時からの変位変化量より求める計算式（変位計1(複合材がつぶれた量)＋変位計2(拘束板が動いた量) = セルの膨化量）", "inputNames": ["delta_displacement_center", "delta_displacement_constraint_plate"], "outputNames": ["cell_expansion"], "parameters": {}, "code": "cell_expansion = delta_displacement_center + delta_displacement_constraint_plate", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T09:07:11.571419", "ref": null}, "className": "ConstraintBlock"}
{"id": "656de436-bb5d-434f-86ea-36a1cdd008a0", "name": "複合材変位定義制約", "description": "複合材変位を求めるための定義式", "inputNames": ["displacement_center"], "outputNames": ["composite_displacement"], "parameters": {}, "code": "composite_displacement = displacement_center", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T09:07:11.571538", "ref": null}, "className": "ConstraintBlock"}
{"id": "3c3aa2b1-e293-460a-b3a3-920bd5332c75", "name": "劣化膨化速度計算制約", "description": "劣化スライド量をEOL放電量（平方根換算値）で割ることで、劣化膨化速度を算出する計算式。", "inputNames": ["degradation_slide_amount", "eol_discharge_amount"], "outputNames": ["degradation_swelling_velocity"], "parameters": {}, "code": "degradation_swelling_velocity = degradation_slide_amount / eol_discharge_amount", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T09:07:11.571764", "ref": null}, "className": "ConstraintBlock"}
{"id": "b2a5368d-87b5-4e33-942f-41be7f2cddef", "name": "Totalスライド量計算制約", "description": "Totalスライド量は、充電スライド量と劣化スライド量の和である。", "inputNames": ["charge_slide_amount", "degradation_slide_amount"], "outputNames": ["total_slide_amount"], "parameters": {}, "code": "total_slide_amount = charge_slide_amount + degradation_slide_amount", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T09:07:11.571878", "ref": null}, "className": "ConstraintBlock"}
