{"id": "e152cf91-be4e-47a2-ba1d-5cb663520ea7", "name": "抵抗電圧変化制約", "description": "AC充電-10℃における抵抗測定時の電圧変化と電流の関係を表す制約。ΔV 抵抗 = ΔV ÷ 2Aに基づき算出する。", "inputNames": ["delta_v"], "outputNames": ["delta_v_resistance"], "parameters": {}, "code": "delta_v_resistance = delta_v / 2.0", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:06:38.980082", "ref": null}, "className": "ConstraintBlock"}
