{"id": "41ce15a3-2484-40e4-8816-dbe38f8d4a4f", "name": "充電最後の抵抗計算制約", "description": "充電最後の抵抗は、(充電終了直前電圧 - 充電終了直後電圧) ÷ 充電終了時の電流 で計算される。", "inputNames": ["voltage_before_end", "voltage_after_end", "current_at_end"], "outputNames": ["last_resistance"], "parameters": {}, "code": "last_resistance = (voltage_before_end - voltage_after_end) / current_at_end", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:06:38.978486", "ref": null}, "className": "ConstraintBlock"}
