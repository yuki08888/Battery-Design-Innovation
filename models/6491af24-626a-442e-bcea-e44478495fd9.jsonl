{"id": "0ad63c2f-e3dd-4470-903e-bffe2d10d1c4", "name": "合成電流計算制約", "description": "元の波形（リプル無し電流）にリプル波形を足し合わせて、リプル込電流（合成波形）を算出する。", "inputNames": ["base_current", "ripple_current"], "outputNames": ["combined_current"], "parameters": {}, "code": "combined_current = base_current + ripple_current", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:00:58.022672", "ref": null}, "className": "ConstraintBlock"}
