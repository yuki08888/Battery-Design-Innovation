{"id": "ea8d24c4-e064-4dcc-b510-dfd419f6e360", "name": "発煙発火危険性判定", "description": "現在のセル電圧が発煙発火閾値電圧以上になった場合に、発煙発火の危険（フラグ1）があると判定します。", "inputNames": ["current_voltage", "fire_threshold_voltage"], "outputNames": ["is_overcharged"], "parameters": {}, "code": "is_overcharged = 1 if current_voltage >= fire_threshold_voltage else 0", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:03:07.106267", "ref": null}, "className": "ConstraintBlock"}
