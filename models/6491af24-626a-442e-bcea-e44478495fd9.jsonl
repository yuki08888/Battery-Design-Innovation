{"id": "e1103bdd-1ba6-4bb7-904e-ba423cbf508a", "name": "モーター出力計算制約", "description": "モーターの回転数(rpm)とトルク(Nm)から、機械的な出力(W)を算出します。", "inputNames": ["rotational_speed", "motor_torque"], "outputNames": ["motor_output"], "parameters": {}, "code": "motor_output = (2 * 3.141592653589793 * rotational_speed / 60.0) * motor_torque", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:03:06.912661", "ref": null}, "className": "ConstraintBlock"}
