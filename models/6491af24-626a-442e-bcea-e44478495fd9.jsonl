{"id": "7b2e5621-5289-420e-917f-d4a6cb5f086e", "name": "発煙発火電圧閾値算出制約", "description": "発煙発火電圧閾値は、異常劣化閾値電圧などの基準電圧値から安全率としてのマージン電圧（0.05V）を減算して設計・算出される。", "inputNames": ["standard_threshold_voltage", "safety_margin_voltage"], "outputNames": ["safety_threshold_voltage"], "parameters": {}, "code": "safety_threshold_voltage = standard_threshold_voltage - safety_margin_voltage", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:00:58.013462", "ref": null}, "className": "ConstraintBlock"}
