{"id": "c337a764-1dcc-4d74-89e9-7fc179b99cc7", "name": "評価充電量算出制約", "description": "評価電流値と通電時間から、評価中にバッテリーに充電される総電気量（Ah）を計算します。", "inputNames": ["evaluation_current", "energization_time"], "outputNames": ["charge_amount"], "parameters": {}, "code": "charge_amount = evaluation_current * (energization_time / 3600.0)", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:03:12.682201", "ref": null}, "className": "ConstraintBlock"}
