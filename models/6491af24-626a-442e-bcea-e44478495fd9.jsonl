{"id": "6c901661-d675-4b7b-bd83-557eb5df9d8c", "name": "セル上限電圧超え時間計算制約", "description": "初期品の過充電電流に対する通電許容時間から、劣化度と安全率を加味して劣化後の通電許容時間（セル上限電圧超え時間）を算出する。", "inputNames": ["allowed_time_initial", "degradation_rate", "safety_margin"], "outputNames": ["allowed_time_deteriorated"], "parameters": {}, "code": "allowed_time_deteriorated = allowed_time_initial * (degradation_rate / 100.0) * (1.0 - safety_margin / 100.0)", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:00:58.020670", "ref": null}, "className": "ConstraintBlock"}
