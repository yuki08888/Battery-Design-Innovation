{"id": "d587e1b4-61a6-4b7d-a20b-0ab3e7da9d61", "name": "劣化末期許容通電時間算出制約", "description": "25年後劣化末期品における許容通電時間は、初期品の試験結果や計算値をもとに、電池容量劣化率および安全率（10%）を考慮して算出される。", "inputNames": ["calculated_time_initial", "capacity_degradation_rate", "safety_factor_rate"], "outputNames": ["allowable_time_degraded"], "parameters": {}, "code": "allowable_time_degraded = calculated_time_initial * (1.0 - capacity_degradation_rate) * (1.0 - safety_factor_rate)", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:00:58.018578", "ref": null}, "className": "ConstraintBlock"}
