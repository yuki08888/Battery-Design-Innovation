{"id": "ec14b979-99dd-44a7-93a5-235144c24a09", "name": "要求", "description": "要求要素", "isReferenceModel": false, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:59:23.650253", "ref": null}, "className": "Package"}
{"id": "4421b8f9-bf04-4e9b-bcf6-8dc760cc8029", "name": "充電・放電電流許容時間管理要求", "text": "充電および放電時において、電池セルが発煙に至らない電流許容時間（発煙時間）を適切に管理すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:00:23.727151", "ref": null}, "className": "Requirement"}
{"id": "383a8f57-2997-4168-9805-f044493f531e", "name": "セル上限電圧超え許容時間管理要求", "text": "電池セルが上限電圧を超えた状態における許容時間を適切に管理すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:00:23.729224", "ref": null}, "className": "Requirement"}
{"id": "6e747870-a331-425d-a632-4f43ff5dcc98", "name": "充電電流許容時間規定要求", "text": "全SOC/温度域、劣化、バラツキ下限を加味した電池にて異常過負荷充電電流が通電された際に、電池の安全性に影響が無い電流及びその時間を定義すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:00:23.731387", "ref": null}, "className": "Requirement"}
{"id": "2765b2f7-9235-4247-a747-df031093fec9", "name": "充電ダイアグ閾値安全性確保要求", "text": "システム充電最大電流400Aに対する充電ダイアグ440A閾値において、その安全性に影響を及ぼさない通電許容時間を制御設定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:00:23.733345", "ref": null}, "className": "Requirement"}
{"id": "ed7b7ef0-0235-47ad-918a-cb399d746299", "name": "過充電試験電池仕様要求", "text": "過充電試験には、25年劣化末期および下限品相当の電池仕様を適用すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:00:23.735249", "ref": null}, "className": "Requirement"}
{"id": "eaa5dbb8-85ea-48c9-9d90-4e56cc215651", "name": "過充電試験安全性要求", "text": "4.7V-10s過充電試験において発煙および発火がないこと。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:00:23.736376", "ref": null}, "className": "Requirement"}
{"id": "cfcd9be8-0ec9-460a-ba0f-5ef3fb9d2b99", "name": "発煙発火電圧閾値設計要求", "text": "発煙・発火電圧閾値は、安全率0.05Vを加味して4.65Vとすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:00:23.737382", "ref": null}, "className": "Requirement"}
{"id": "12c0c014-d65b-45a2-90eb-deb370cb1346", "name": "劣化末期許容通電時間要求", "text": "25年後劣化末期品における440A充電時の許容通電時間は、25年後の電池容量劣化率および安全率10%を考慮して60sとすること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:00:23.739412", "ref": null}, "className": "Requirement"}
{"id": "73507f1b-f5fb-40a2-a4ef-e5ad1b8f298a", "name": "放電電流許容時間規定要求", "text": "制御適合用のdata要求書向けに、発煙・発火に至らない放電電流許容時間を規定すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:00:23.741399", "ref": null}, "className": "Requirement"}
{"id": "1d220406-00b7-49c3-9317-917fa624503a", "name": "異常過負荷放電電流に対する安全性確認要求", "text": "990A-2secの異常過負荷電流が通電された際に、電池セルの安全性に影響が無いことを確認すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:00:23.743397", "ref": null}, "className": "Requirement"}
{"id": "914a924c-a801-47b3-a03f-0a831309187d", "name": "異常過負荷電流耐性要求", "text": "異常過負荷電流(990A-2sec)が流れても、電池安全性に問題がない（破裂・発火無き）こと。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:00:23.745399", "ref": null}, "className": "Requirement"}
{"id": "ef3fa831-def6-4505-abc0-fa41e5cdb341", "name": "電池データ要求書仕様", "text": "許容電流値が990A_2sec以上であること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:00:23.747403", "ref": null}, "className": "Requirement"}
{"id": "f11104f4-8949-4500-a0a2-b20c20918d48", "name": "劣化限界電圧からの上限電圧超え許容時間定義要求", "text": "セルの劣化限界電圧(4.33V)から発煙限界電圧(申請値4.65V)の間において、発煙・発火することなく充電できる許容時間を定義すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:00:23.749124", "ref": null}, "className": "Requirement"}
{"id": "121b1037-a898-4cbf-8357-6523e334c71e", "name": "発煙限界電圧からの上限電圧超え許容時間定義要求", "text": "セルの発煙発火限界電圧(申請値4.65V)から発煙発火限界電圧(実値4.70V)の間において、発煙・発火することなく充電できる許容時間を定義すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:00:23.750347", "ref": null}, "className": "Requirement"}
{"id": "0182de8f-a1af-4953-bc44-1094978f5f3f", "name": "許容時間閾値算出要求", "text": "劣化限界電圧からの上限電圧超え許容時間および発煙限界電圧からの上限電圧超え許容時間を、各充電電流ごとに算出すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:00:23.750614", "ref": null}, "className": "Requirement"}
{"id": "38a61e97-c8b7-4284-a026-dfd8d2f8d960", "name": "セル上限電圧超え許容時間要求", "text": "初期品電池に求めた過充電電流に対する通電許容時間に対して、25年後劣化度（本計算では64%）及び安全率10%を加味して計算した結果をセル上限電圧超え時間とすること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:00:23.751735", "ref": null}, "className": "Requirement"}
{"id": "46f5929a-12a6-40eb-9405-ffca6d6303f8", "type": "containment", "sourceId": "ec14b979-99dd-44a7-93a5-235144c24a09", "targetId": "38a61e97-c8b7-4284-a026-dfd8d2f8d960", "name": null, "description": null, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:00:23.751865", "ref": null}, "connectorType": null, "flowType": null, "guard": null, "edgeType": null, "sequenceOrder": null, "className": "Relationship"}
{"id": "6eed3535-0c1d-47bc-8d8f-6df230eecd59", "name": "通常時リプル電流特性影響評価要求", "text": "通常時、モーター負荷変動によるLC共振によって発生するリプル電流が電池セルへ及ぼす影響（電池特性、発熱影響、Li析出耐性）がないことを検証すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:00:23.753036", "ref": null}, "className": "Requirement"}
{"id": "58cee0f8-7009-499b-860a-a04269490c11", "name": "1kHz超リプル電流評価除外要求", "text": "1kHz以上の電流では電池の反応が起こらないため、Li析出耐性評価における1kHz以上のリプル電流の影響は考慮対象外とすること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:00:23.755026", "ref": null}, "className": "Requirement"}
{"id": "6371a648-b7c4-4f6f-a5a0-7da79cf13df1", "name": "1kHz以下リプル電流評価要求", "text": "Li析出耐性の影響確認は、1kHz以下のリプル電流を対象に実セル評価にて実施すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:00:23.757063", "ref": null}, "className": "Requirement"}
{"id": "5080c096-f4fa-466a-8364-e053d7ca30ff", "name": "電池特性・発熱影響机上検証要求", "text": "リプル電流による電池特性および発熱影響の確認は、机上計算により検証すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:00:23.759053", "ref": null}, "className": "Requirement"}
{"id": "1e19117a-548a-4ce0-b564-1aa720383b50", "name": "リプル電流負荷変動追従評価要求", "text": "インバータ設計から提示されるリプル電流特性マップに基づき、モーター回転数やトルクで変動する負荷変動に沿った評価を行うこと。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:00:23.761050", "ref": null}, "className": "Requirement"}
{"id": "260a9eff-ead3-4e11-98b4-3008b7c938c0", "name": "力行側最大リプル電流規定", "text": "力行側におけるリプル特性のプロットにおいて、最大リプル電流は223Appとすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:00:23.763090", "ref": null}, "className": "Requirement"}
{"id": "d48f28c5-dd49-4a6f-8858-bb3f253e38f8", "name": "回生側最大リプル電流規定", "text": "回生側におけるリプル特性のプロットにおいて、最大リプル電流は136Appとすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:00:23.764437", "ref": null}, "className": "Requirement"}
{"id": "d28bfa69-2772-4abd-a434-7728a39889ff", "name": "電池特性影響有意差要求", "text": "容量維持率・抵抗増加率共に、リップル有無による有意差無きこと。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:00:23.766579", "ref": null}, "className": "Requirement"}
{"id": "1b5024f9-78a3-4284-97ae-a60728a280d4", "name": "WOT時リプル熱影響要求", "text": "500A×60sec(WOT5回平均)のシステム要求、または655A×90secの評価電流において、サーミスタ部温度上昇がΔT=7℃以下であること、かつ40℃スタートでもWout制限が無いこと。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:00:23.768587", "ref": null}, "className": "Requirement"}
{"id": "e291dd46-dede-4eb3-bcdb-57cd2d97b882", "name": "回生時Li析出耐性検証要求", "text": "回生時のLi析出耐性を確認するため、要求仕様の電流値のうち、最も厳しい条件（Win_MAXで発生する250A付近の電流、252A×10sec）で評価すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:00:23.770602", "ref": null}, "className": "Requirement"}
{"id": "1436a826-a749-4054-b0b8-31a13a8fa946", "name": "リプル影響確認要求", "text": "リプルの有無がLi析出に影響するかを確認するため、Li析出の有無が分かれる電流値において、平均リプル電流を20Appとしたリプル有無による析出耐性の変化を評価すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:00:23.772623", "ref": null}, "className": "Requirement"}
