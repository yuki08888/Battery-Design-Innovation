{"id": "d750c84b-f324-405d-a9f9-6c19f9dfab8e", "name": "中国電池セル定格容量評価要求", "text": "中国におけるセルの定格容量測定において、充電は室温で企業が規定する充電方法に従い充電し、放電は1It(A)で企業が定める放電終止条件に到達するまで行うこと。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:25:27.928296", "ref": null}, "className": "Requirement"}
{"id": "b7cfefd8-54ec-44c6-9be1-1e3aaed8ceae", "name": "中国電池セル公称電圧評価要求", "text": "中国におけるセルの公称電圧は、規定の定格容量評価条件における1It(A)放電での平均放電電圧（Wh/Ah)とすること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:25:27.928477", "ref": null}, "className": "Requirement"}
{"id": "f1ec5884-946f-47ef-9963-7e2c045a620c", "name": "セル容量定義変更要求", "text": "中国以外の定格容量および公称電圧の申請値について、カタログ値やOMとの乖離等を防ぐため、IEC62660-1準拠の容量定義へと変更すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:25:27.928649", "ref": null}, "className": "Requirement"}
{"id": "2b31dd89-0c91-4197-8fc8-5551e74cddd2", "name": "HEV用セル測定条件要求", "text": "HEV用セルの測定条件において、放電条件の電流を1Cとすること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:25:27.928818", "ref": null}, "className": "Requirement"}
{"id": "e674c415-126b-4d32-a2e0-b55ce81fe3a8", "name": "PHEV・BEV用セル測定条件要求", "text": "PHEVおよびBEV用セルの測定条件において、放電条件の電流を1/3Cとすること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:25:27.928986", "ref": null}, "className": "Requirement"}
{"id": "1212f8b2-2b8c-4ef5-bc62-2a3d3bb78a2a", "name": "セル充電条件要求", "text": "各セルの測定における充電条件は、各セルで規定している充電条件とすること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:25:27.929155", "ref": null}, "className": "Requirement"}
{"id": "e7c1c084-bc1c-4169-a4e0-044fffa01c96", "name": "放電カット条件要求", "text": "放電条件のカット条件およびセル最低電圧は、電池システム仕様書に記載されたセルの常用の下限電圧とすること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:25:27.929325", "ref": null}, "className": "Requirement"}
{"id": "dc20075c-b3b4-494f-9f92-0788e04ba971", "name": "定格容量測定中平均電圧算出要求", "text": "定格容量測定中平均電圧は、定格容量測定時の5秒ごとの電圧の平均電圧とすること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:25:27.929550", "ref": null}, "className": "Requirement"}
