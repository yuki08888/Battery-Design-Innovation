{"id": "716c7360-9330-4ff8-b525-8f62771e60d2", "name": "拘束荷重整合性制約", "description": "電極捲回体の平板拘束荷重(kgf)と、弾性体再拘束荷重(kN)を同一単位(kgf)に揃えて比較し、その安全マージン（荷重差）を算出します。", "inputNames": ["restraining_force_kn", "flat_plate_restraining_force_kgf"], "outputNames": ["reconstraining_force_kgf", "margin_force_kgf"], "parameters": {}, "code": "reconstraining_force_kgf = restraining_force_kn * 1000 / 9.80665\nmargin_force_kgf = flat_plate_restraining_force_kgf - reconstraining_force_kgf", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:10:44.540626", "ref": null}, "className": "ConstraintBlock"}
