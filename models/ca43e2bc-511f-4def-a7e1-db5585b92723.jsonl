{"id": "101fae09-d369-4ae0-9437-eaf19e6c44e0", "name": "制御介入マージン算出", "description": "制御下限電圧と常用下限電圧の差を求め、システムが制御介入を開始するための電圧マージンを計算します。", "inputNames": ["control_min_voltage", "normal_min_voltage"], "outputNames": ["control_margin"], "parameters": {}, "code": "control_margin = control_min_voltage - normal_min_voltage", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:56:39.099938", "ref": null}, "className": "ConstraintBlock"}
