{"id": "456a1dc0-8a63-4858-99fb-5b55783ed5b1", "name": "満充電判定電圧閾値制約", "description": "DC充電時の満充電判定電圧に対して、許容されるリップル電圧比率を考慮した上限および下限の電圧閾値を算出します。", "inputNames": ["full_charge_voltage", "ripple_voltage_ratio"], "outputNames": ["upper_limit", "lower_limit"], "parameters": {}, "code": "upper_limit = full_charge_voltage * (1.0 + ripple_voltage_ratio)\nlower_limit = full_charge_voltage * (1.0 - ripple_voltage_ratio)", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:56:30.485660", "ref": null}, "className": "ConstraintBlock"}
