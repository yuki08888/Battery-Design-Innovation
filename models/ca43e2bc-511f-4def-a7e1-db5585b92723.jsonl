{"id": "f9791afe-6751-46ff-934b-dc25d135af67", "name": "DCR上昇率特性", "description": "正極遷移金属溶出によるセルの劣化や、セル電圧の低下・過放電状態がもたらす化学的ダメージにより、電池セルの直流内部抵抗(DCR)上昇率が増加する関係を定義します。", "inputNames": ["elution_amount", "cell_voltage"], "outputNames": ["dcr_increase_rate"], "parameters": {}, "code": "dcr_increase_rate = elution_amount * 2.5 + (100.0 - cell_voltage * 20.0) * 0.1", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:56:26.747909", "ref": null}, "className": "ConstraintBlock"}
