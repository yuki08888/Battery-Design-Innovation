{"id": "17f43a83-7c05-4968-b72f-9bc9ab3ef3ee", "name": "高電圧保護マージン制約", "description": "電池の使用上限電圧と高電圧ダイアグ閾値の差（マージン）を計算し、ダイアグ閾値が使用上限電圧未満に正しく設定されているか（安全マージンが確保されているか）を判定します。", "inputNames": ["high_voltage_diag_threshold", "upper_voltage_limit"], "outputNames": ["voltage_margin", "is_safe"], "parameters": {}, "code": "voltage_margin = upper_voltage_limit - high_voltage_diag_threshold\nis_safe = 1.0 if voltage_margin > 0 else 0.0", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:56:25.659084", "ref": null}, "className": "ConstraintBlock"}
