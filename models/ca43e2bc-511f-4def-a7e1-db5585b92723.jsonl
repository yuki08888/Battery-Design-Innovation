{"id": "8b007b67-5256-470e-abc8-cb2a39ac6e92", "name": "高電圧マージン制約", "description": "セル劣化限界電圧と高電圧ダイアグ閾値の間のマージン（差分）を算出し、過充電保護の設計安全マージンを評価します。", "inputNames": ["limit_voltage", "threshold_voltage"], "outputNames": ["overcharge_margin"], "parameters": {}, "code": "overcharge_margin = limit_voltage - threshold_voltage", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:56:24.874159", "ref": null}, "className": "ConstraintBlock"}
