{"id": "7d43300c-5507-47dd-9903-2b4575988377", "name": "サブCPU保護マージン制約", "description": "サブCPUのダイアグ閾値と保護値の間のマージン(許容幅)を算出します。ダイアグ判定が保護処理よりも先に適切に行われるための指標となります。", "inputNames": ["diag_threshold", "protection_value"], "outputNames": ["margin"], "parameters": {}, "code": "margin = diag_threshold - protection_value", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:56:34.339954", "ref": null}, "className": "ConstraintBlock"}
