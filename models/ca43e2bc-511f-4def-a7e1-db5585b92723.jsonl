{"id": "9fd2bd65-dd09-4f7a-b30d-04437dfe295c", "name": "銅溶出セーフティバッファ算出", "description": "セル劣化限界閾値と銅溶出限界閾値の間のセーフティバッファを算出します。", "inputNames": ["threshold_degradation", "threshold_copper_elution"], "outputNames": ["safety_margin"], "parameters": {}, "code": "safety_margin = threshold_degradation - threshold_copper_elution", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:56:39.092779", "ref": null}, "className": "ConstraintBlock"}
