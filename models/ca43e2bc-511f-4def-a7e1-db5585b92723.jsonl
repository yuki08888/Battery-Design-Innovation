{"id": "09a9f605-17fb-4d34-99f2-87bef3ca9aa3", "name": "VH過電圧検出閾値変動制約", "description": "VH（高電圧）監視において、過電圧検出の閾値に対して、図面値上のセンサー誤差および実力誤差が重畳した場合の、最悪値（検出が遅れる上限値）および最良値（不要検出する下限値）を算出します。", "inputNames": ["vh_overvoltage_threshold", "vh_sensor_error_spec", "vh_sensor_error_actual"], "outputNames": ["vh_overvoltage_worst_case", "vh_overvoltage_best_case", "vh_overvoltage_actual_worst", "vh_overvoltage_actual_best"], "parameters": {}, "code": "vh_overvoltage_worst_case = vh_overvoltage_threshold + vh_sensor_error_spec\nvh_overvoltage_best_case = vh_overvoltage_threshold - vh_sensor_error_spec\nvh_overvoltage_actual_worst = vh_overvoltage_threshold + vh_sensor_error_actual\nvh_overvoltage_actual_best = vh_overvoltage_threshold - vh_sensor_error_actual", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:56:38.013394", "ref": null}, "className": "ConstraintBlock"}
