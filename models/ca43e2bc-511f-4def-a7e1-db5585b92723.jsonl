{"id": "3ec84cb5-f7bd-4ce9-9d42-619165985a2f", "name": "安全限界マージン算出制約", "description": "安全限界上限電圧と電圧F_B（フィードバック）閾値の差から、システム設計上の電圧マージンを算出し、安全なマージンが確保されているか判定します。", "inputNames": ["safety_voltage_limit", "f_b_voltage_threshold"], "outputNames": ["upper_limit_margin", "system_margin_ok"], "parameters": {}, "code": "upper_limit_margin = safety_voltage_limit - f_b_voltage_threshold\nsystem_margin_ok = 1.0 if upper_limit_margin > 0 else 0.0", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:56:32.204971", "ref": null}, "className": "ConstraintBlock"}
