{"id": "2c87af55-d579-4439-95c3-08d332f95017", "name": "最大許容監視電圧制約", "description": "セルの過充電を防ぐため、保護閾値からセンサーの測定誤差とブロック内のセル間電圧ばらつきを差し引いた、安全に許容できる最大監視測定電圧を算出します。", "inputNames": ["threshold_voltage", "sensor_error", "voltage_variation"], "outputNames": ["max_allowable_voltage"], "parameters": {}, "code": "max_allowable_voltage = threshold_voltage - sensor_error - voltage_variation", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:56:34.341465", "ref": null}, "className": "ConstraintBlock"}
