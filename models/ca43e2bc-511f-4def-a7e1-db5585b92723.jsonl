{"id": "dfb2ecdb-fff7-4caf-8900-84786b7bdfcf", "name": "遷移金属溶出による容量回復率低下特性", "description": "正極の遷移金属溶出量が増加すると、活物質の構造劣化や負極上での析出に伴う皮膜形成などにより、電池セルの容量回復率が低下する関係をモデル化します。", "inputNames": ["elution_amount"], "outputNames": ["capacity_recovery_rate"], "parameters": {}, "code": "capacity_recovery_rate = max(0.0, min(100.0, 100.0 - (elution_amount * 1.5)))", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:56:26.743856", "ref": null}, "className": "ConstraintBlock"}
