{"id": "6c3caa72-43fe-4c36-8381-196c90f7ff38", "name": "安全限界上限電圧算出式", "description": "DC充電中の安全限界上限電圧の算出式。VH過電圧検出値＋VHセンサー誤差実力(合計4.524V)にパック内電圧ばらつき(0.126V)を加算して、安全限界上限電圧(4.65V)を決定する。", "inputNames": ["vh_sensor_error_total", "voltage_variation_pack"], "outputNames": ["safety_limit_upper_voltage"], "parameters": {}, "code": "safety_limit_upper_voltage = vh_sensor_error_total + voltage_variation_pack", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:53:28.195676", "ref": null}, "className": "ConstraintBlock"}
