{"id": "8f349020-1a96-4415-91cc-d25522401893", "name": "負極密度算出制約", "description": "負極の目付（面密度）を厚みで割ることで、負極の密度を算出します。", "inputNames": ["anode_basis_weight", "anode_thickness"], "outputNames": ["anode_density"], "parameters": {}, "code": "if anode_basis_weight is not None and anode_thickness is not None and anode_thickness > 0:\n    anode_density = anode_basis_weight / anode_thickness\nelse:\n    anode_density = 0.0", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T09:14:51.758937", "ref": null}, "className": "ConstraintBlock"}
