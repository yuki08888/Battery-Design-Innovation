{"id": "3e102fa1-621e-4563-a516-bbfbbb616127", "name": "最小摩擦係数算出制約", "description": "現在の拘束力F、捲回体質量、および目標Gから、滑りが発生しないためにシステムに要求される最小摩擦係数を算出します。", "inputNames": ["holding_force", "roll_mass", "target_g"], "outputNames": ["min_friction_coefficient"], "parameters": {}, "code": "min_friction_coefficient = holding_force / (roll_mass * target_g * 9.80665) if (roll_mass * target_g) > 0 else 0.0", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T09:14:52.628819", "ref": null}, "className": "ConstraintBlock"}
