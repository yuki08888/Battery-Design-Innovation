{"id": "5b041357-f148-40aa-af5a-6d87f78669c5", "name": "存在比率総和制約", "description": "全走行パターンの存在比率の合計が1.0（100%）に適合することを確認するための制約です。", "inputNames": ["la4_ratio", "hwy_ratio", "us06_ratio"], "outputNames": ["total_ratio"], "parameters": {}, "code": "total_ratio = la4_ratio + hwy_ratio + us06_ratio", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T09:14:59.544948", "ref": null}, "className": "ConstraintBlock"}
