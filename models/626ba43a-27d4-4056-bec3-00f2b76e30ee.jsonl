{"id": "923c64f5-a692-49c8-a5a9-2d4de337eb4e", "name": "正極充填密度算出制約", "description": "正極の目付（面密度）を厚みで割ることで、正極の充填密度を算出します。", "inputNames": ["cathode_basis_weight", "cathode_thickness"], "outputNames": ["cathode_density"], "parameters": {}, "code": "if cathode_basis_weight is not None and cathode_thickness is not None and cathode_thickness > 0:\n    cathode_density = cathode_basis_weight / cathode_thickness\nelse:\n    cathode_density = 0.0", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T09:14:51.761192", "ref": null}, "className": "ConstraintBlock"}
