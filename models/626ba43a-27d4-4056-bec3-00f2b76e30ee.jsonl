{"id": "314e449c-7f0b-4a6d-9213-9ac05ef60d02", "name": "最大引っ張り力制約", "description": "重石重量、静止摩擦係数、および重力加速度から、滑り出すために必要な最大引っ張り力（限界静止摩擦力）を算出します。", "inputNames": ["weight", "static_friction_coefficient"], "outputNames": ["maximum_pulling_force"], "parameters": {}, "code": "gravity_acceleration = 9.80665\nmaximum_pulling_force = weight * static_friction_coefficient * gravity_acceleration", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T09:14:53.432099", "ref": null}, "className": "ConstraintBlock"}
