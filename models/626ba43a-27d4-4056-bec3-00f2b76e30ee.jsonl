{"id": "e5b05378-3f3e-413b-a257-75d68ad90a0f", "name": "最小拘束力算出制約", "description": "捲回体質量と目標G（入力G）から、システムに求められる最低限の拘束力（最小拘束力F1）を算出します。G（重力加速度単位）をニュートンに換算するため 9.80665 を乗じています。", "inputNames": ["roll_mass", "target_g"], "outputNames": ["required_constraint_force"], "parameters": {}, "code": "required_constraint_force = roll_mass * target_g * 9.80665", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T09:14:52.617698", "ref": null}, "className": "ConstraintBlock"}
