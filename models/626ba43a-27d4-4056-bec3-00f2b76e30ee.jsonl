{"id": "7904f427-21df-4c6a-bd7d-562ff153341c", "name": "最低拘束荷重制約", "description": "振動時に電池セルを物理的に固定（電極体保持）し滑りや破損を防ぐために、必要な最低拘束荷重を算出します。加速度Gとセル質量、安全率から求めます。", "inputNames": ["base_acceleration_g", "cell_mass", "safety_factor"], "outputNames": ["required_clamping_force"], "parameters": {}, "code": "required_clamping_force = base_acceleration_g * cell_mass * safety_factor", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T09:14:58.785646", "ref": null}, "className": "ConstraintBlock"}
