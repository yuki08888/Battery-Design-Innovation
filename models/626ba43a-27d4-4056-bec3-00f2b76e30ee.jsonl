{"id": "e1309b67-e3bf-4125-89ec-ab4c02583db6", "name": "市場平均EOL放電量算出制約", "description": "各走行パターン（LA#4, HWY, US06）の存在比率とそれぞれの平均放電量から、加重平均を用いて市場平均EOL放電量を計算します。", "inputNames": ["la4_ratio", "hwy_ratio", "us06_ratio", "la4_discharge", "hwy_discharge", "us06_discharge"], "outputNames": ["calculated_eol_discharge"], "parameters": {}, "code": "calculated_eol_discharge = (la4_ratio * la4_discharge) + (hwy_ratio * hwy_discharge) + (us06_ratio * us06_discharge)", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T09:14:59.544275", "ref": null}, "className": "ConstraintBlock"}
