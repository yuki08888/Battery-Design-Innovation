{"id": "065e1bfa-0710-42af-9bcb-6c6716f71802", "name": "劣化限界電流の算出制約", "description": "劣化後の限界電流(IWin)を、初期の限界電流、SOH(健全度)、および抵抗上昇率を元に算出します。抵抗値が上昇するほど限界電流は低下します。", "inputNames": ["limit_current_initial", "soh", "resistance_increase_rate"], "outputNames": ["limit_current_degraded"], "parameters": {}, "code": "limit_current_degraded = limit_current_initial * soh * (1.0 / resistance_increase_rate)", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:44:09.363146", "ref": null}, "className": "ConstraintBlock"}
