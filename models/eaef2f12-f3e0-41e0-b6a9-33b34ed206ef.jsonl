{"id": "15d0aa31-6a50-4d66-bfc3-cc033880e538", "name": "拘束面圧算出制約", "description": "拘束荷重(kN)と接触面積(mm^2)から拘束面圧(MPa = N/mm^2)を算出します。", "inputNames": ["clamping_force", "contact_area"], "outputNames": ["retaining_pressure"], "parameters": {}, "code": "retaining_pressure = (clamping_force * 1000) / contact_area", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:44:09.552323", "ref": null}, "className": "ConstraintBlock"}
