{"id": "8ceb7393-4d73-4dd4-b112-654ce651e482", "name": "Li析出EOL最大電流制約", "description": "負極電位によるLi析出限界のEOL時最大電流を算出します。BOL(初期)のLi析出限界電流(I_Li_plating_BOL)を劣化抵抗上昇率(Rate)を加味した値で除算して算出します。", "inputNames": ["I_Li_plating_BOL", "Rate"], "outputNames": ["I_Li_plating_EOL"], "parameters": {}, "code": "I_Li_plating_EOL = I_Li_plating_BOL / (1 + Rate)", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:40:20.941948", "ref": null}, "className": "ConstraintBlock"}
