{"id": "94dbb791-a739-40e9-bc43-e74484b68a1f", "name": "内部抵抗推定制約", "description": "初期抵抗値、抵抗上昇率、およびガスの残留状態（0:なし, 1:軽微, 2:深刻）から現在の内部抵抗値を推定します。", "inputNames": ["initial_resistance", "resistance_growth_rate", "gas_status"], "outputNames": ["internal_resistance"], "parameters": {}, "code": "degradation_factor = 1.0 + (resistance_growth_rate / 100.0)\nif gas_status == 1.0:\n    degradation_factor += 0.2\nelif gas_status == 2.0:\n    degradation_factor += 0.5\n\ninternal_resistance = initial_resistance * degradation_factor", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:44:13.711742", "ref": null}, "className": "ConstraintBlock"}
