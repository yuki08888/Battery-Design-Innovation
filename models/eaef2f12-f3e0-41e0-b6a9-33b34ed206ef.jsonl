{"id": "d40eccc5-3697-41ff-8d11-9d8ee681d9eb", "name": "端子電圧降下制約", "description": "開路電圧、動作電流、および内部抵抗から、通電時のセル電圧（端子電圧）を算出します。", "inputNames": ["open_circuit_voltage", "operating_current", "internal_resistance"], "outputNames": ["cell_voltage"], "parameters": {}, "code": "voltage_drop = operating_current * internal_resistance\ncell_voltage = open_circuit_voltage - voltage_drop", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:44:13.719779", "ref": null}, "className": "ConstraintBlock"}
