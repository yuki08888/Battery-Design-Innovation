{"id": "3d00031a-4697-457c-ac39-9d66fe76df46", "name": "限界電流算出制約", "description": "通電時の限界電流(Ilim)を算出する計算式。前回値からの制限項と緩和項を用いて現在値を計算する。", "inputNames": ["ilim_prev", "alpha", "ic", "dt", "beta", "ilim0"], "outputNames": ["ilim_current"], "parameters": {}, "code": "ilim_current = ilim_prev - alpha * ic * dt - beta * ((ilim0 - ilim_prev) / ilim0) * dt", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:40:20.941040", "ref": null}, "className": "ConstraintBlock"}
