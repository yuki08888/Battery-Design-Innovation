{"id": "c5ee5407-f26c-437f-972c-f4e05c234dd2", "name": "過電圧EOL最大電流制約", "description": "過電圧によるEOL(寿命末期)時の最大電流を算出します。過電圧カットオフ電圧(V_cutoff)と開回路電圧(V0)の差を、EOL時の直流内部抵抗(DCR_EOL)に15%のマージンを乗じた値で除算して算出します。", "inputNames": ["V_cutoff", "V0", "DCR_EOL"], "outputNames": ["I_overvoltage_EOL"], "parameters": {}, "code": "I_overvoltage_EOL = (V_cutoff - V0) / (DCR_EOL * (1 + 0.15))", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:40:20.941792", "ref": null}, "className": "ConstraintBlock"}
