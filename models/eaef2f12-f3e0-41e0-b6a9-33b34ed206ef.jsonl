{"id": "6f8d0b32-4e19-4c79-8b71-fcbdc0ba274e", "name": "弾性変形量算出制約", "description": "拘束荷重(kN)と部材の弾性ばね定数(N/mm)から、拘束時の弾性変形量(mm)を算出します。", "inputNames": ["clamping_force", "elastic_stiffness"], "outputNames": ["elastic_deformation"], "parameters": {}, "code": "elastic_deformation = (clamping_force * 1000) / elastic_stiffness", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:44:09.565303", "ref": null}, "className": "ConstraintBlock"}
