{"id": "75133f00-d4ae-4688-88ed-d64866a033e3", "name": "セル内圧算出制約", "description": "バッテリーセルのガス発生量と剛性係数から現在のセル内圧を算出します。", "inputNames": ["initial_pressure", "gas_generation", "stiffness_factor"], "outputNames": ["internal_pressure"], "parameters": {}, "code": "# 内圧上昇特性: ガス発生量(L) * ガス剛性係数(kPa/L) + 初期内圧(kPa)\ninternal_pressure = initial_pressure + gas_generation * stiffness_factor", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:43:45.998886", "ref": null}, "className": "ConstraintBlock"}
