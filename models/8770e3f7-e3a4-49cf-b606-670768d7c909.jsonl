{"id": "420ed868-8bd1-482d-8db3-e2cb18351aa7", "name": "推定内圧計算式", "description": "ラミネート型セルのガス体積、残空間、溶解ガス量から推定内圧を算出する関係式。", "inputNames": ["V1", "V2", "V3"], "outputNames": ["P"], "parameters": {}, "code": "P = (V1 - V3) / V2", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:41:49.426341", "ref": null}, "className": "ConstraintBlock"}
