{"id": "53dc288a-330e-4113-a7a5-0065cf87047d", "name": "ガス溶解量計算式", "description": "セル温度、内圧、および係数から電解液中へのガス溶解量を算出する関係式。", "inputNames": ["alpha", "beta", "gamma", "T", "P"], "outputNames": ["V3"], "parameters": {}, "code": "import math\nV3 = alpha * math.exp(beta / T) * pow(P, gamma)", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:41:49.428154", "ref": null}, "className": "ConstraintBlock"}
