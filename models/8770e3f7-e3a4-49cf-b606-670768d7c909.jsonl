{"id": "e4249be7-e096-408b-8a79-86249a09822b", "name": "安全率制約", "description": "破断の制限ダメージとしきい値ダメージから安全率を計算する制約。テキストには「2倍（破断D＝1、D閾値＝0.5）」の記載がある。", "inputNames": ["limit_damage", "threshold_damage"], "outputNames": ["safety_factor"], "parameters": {}, "code": "safety_factor = limit_damage / threshold_damage", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:41:49.414818", "ref": null}, "className": "ConstraintBlock"}
