{"id": "092689d6-c003-4bd8-9f2e-51cda23ff900", "name": "年間平均走行距離算出制約", "description": "目標耐用年数（年）と目標走行距離（km）から、保証期間中に必要とされる年間平均走行距離（km/年）を算出します。", "inputNames": ["target_lifetime", "target_mileage"], "outputNames": ["annual_mileage"], "parameters": {}, "code": "annual_mileage = target_mileage / target_lifetime", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:43:42.975473", "ref": null}, "className": "ConstraintBlock"}
