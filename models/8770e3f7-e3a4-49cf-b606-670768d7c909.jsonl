{"id": "a6e6134c-2391-48e0-b62f-b553ac00b344", "name": "分解反応速度制約", "description": "電圧による分解反応速度を決定づける計算式。分解反応速度 r は、基準反応速度 r_0、活性化エネルギー Ea、電場効果係数 beta、ファラデー定数 F、電圧 V、気体定数 R、絶対温度 T から算出される。", "inputNames": ["r_0", "Ea", "beta", "F", "V", "R", "T"], "outputNames": ["r"], "parameters": {}, "code": "import math\nr = r_0 * math.exp(-(Ea - beta * F * V) / (R * T))", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:41:49.425849", "ref": null}, "className": "ConstraintBlock"}
