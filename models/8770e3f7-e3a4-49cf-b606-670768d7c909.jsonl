{"id": "12a30d55-ac56-403c-a204-390a4dafc569", "name": "年間平均走行距離算出制約", "description": "目標耐用年数（年）と目標走行距離（km）から、システムに求められる年間平均走行距離（km/年）を算出します。", "inputNames": ["target_lifetime", "target_mileage"], "outputNames": ["target_annual_mileage"], "parameters": {}, "code": "target_annual_mileage = target_mileage / target_lifetime", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:43:43.212338", "ref": null}, "className": "ConstraintBlock"}
