{"id": "6aee8ace-11be-4d0c-9630-181ac373048b", "name": "バンコク耐久試験時間換算制約", "description": "九州熊本の耐久試験時間から、バンコク25年相当の試験時間を、絶対湿度比、年数比、および温度上昇による化学反応速度の変化を考慮して算出する計算式。", "inputNames": ["kumamoto_time", "humidity_bangkok", "humidity_kumamoto", "target_years", "base_years", "temp_factor"], "outputNames": ["bangkok_time"], "parameters": {}, "code": "bangkok_time = kumamoto_time * (humidity_bangkok / humidity_kumamoto) * (target_years / base_years) / temp_factor", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:21:25.494221", "ref": null}, "className": "ConstraintBlock"}
