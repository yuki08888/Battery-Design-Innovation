{"id": "d09bc455-c0eb-4d84-b276-5c82f9cfebce", "name": "温湿度サイクル数算出制約", "description": "ニッケル水素電池モジュールのサイクル数をベースに、余裕を持たせた係数を乗算してサイクル数を算出する制約。", "inputNames": ["base_cycles", "multiplier"], "outputNames": ["cycle_count"], "parameters": {}, "code": "cycle_count = round(base_cycles * multiplier)", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:21:25.502656", "ref": null}, "className": "ConstraintBlock"}
