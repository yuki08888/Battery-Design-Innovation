{"id": "fa76c542-54ec-4b84-a154-55225fb64d48", "name": "錘重量算出制約", "description": "端子1個に締結する錘の重量を算出するための計算式。総プラスW/Hの重量、ナットの重量、バスバーの重量、絶縁カバーの重量、および総端子数から錘の重量を算出する。", "inputNames": ["harness_weight", "nut_weight", "busbar_weight", "cover_weight", "terminal_count"], "outputNames": ["weight"], "parameters": {}, "code": "weight = harness_weight + nut_weight + ((busbar_weight + cover_weight) / terminal_count)", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:21:25.521209", "ref": null}, "className": "ConstraintBlock"}
