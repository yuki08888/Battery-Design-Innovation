{"id": "c8c6a27a-0503-4e70-8617-07540ae27e2f", "name": "25年相当温湿度サイクル数要求", "text": "温度差が最大になるロシア・ヤクーツクでの25年間の積算温度差ストレスを模擬し、安全マージンおよび冷却性能変化を包含した温湿度サイクル試験回数を3000サイクルとすること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.462463", "ref": null}, "className": "Requirement"}
{"id": "40c8dee1-4f9f-4537-97f6-385c5f023820", "name": "温湿度サイクル試験パターン要求", "text": "温湿度サイクル試験において、65℃(15.5hr)→-40℃(7.5hr)→65℃ 95%RH(15.5hr)→-40℃(15.5hr)の試験パターンを適用すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.466325", "ref": null}, "className": "Requirement"}
{"id": "4c02c71c-82a4-41d9-8d24-cc794fa78781", "name": "温湿度サイクル試験サイクル数要求", "text": "温湿度サイクル試験の保持時間は、10サイクルとすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.466435", "ref": null}, "className": "Requirement"}
{"id": "a973e661-f941-47c8-b756-a1ac471b970d", "name": "温湿度サイクル試験電池SOC要求", "text": "温湿度サイクル試験における電池SOCは、満充電の100%と設定すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.466568", "ref": null}, "className": "Requirement"}
{"id": "930b2c11-5d6a-4160-94c5-7a999596ecd7", "name": "温湿度サイクル試験拘束条件要求", "text": "温湿度サイクル試験において、Li6.A/Bではセル厚みセンター定寸、Li7.A/Bでは3.0kNの拘束を加えること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.466684", "ref": null}, "className": "Requirement"}
