{"id": "53e3ed1b-816b-4804-aba8-4256dba765f5", "name": "要求", "description": "要求要素", "isReferenceModel": false, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:34:34.991628", "ref": null}, "className": "Package"}
{"id": "8e8f490e-f794-4156-b8aa-818771e3a7cd", "name": "電池データ規定要求", "text": "Pin充電の電圧リプル算出、満充電判定制御に必要な電池データを規定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:35:14.709003", "ref": null}, "className": "Requirement"}
{"id": "50df6d36-8902-4217-b979-b4748c0dccb2", "type": "containment", "sourceId": "53e3ed1b-816b-4804-aba8-4256dba765f5", "targetId": "8e8f490e-f794-4156-b8aa-818771e3a7cd", "name": null, "description": null, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:35:14.709298", "ref": null}, "connectorType": null, "flowType": null, "guard": null, "edgeType": null, "sequenceOrder": null, "className": "Relationship"}
{"id": "c4bcbf32-4879-41e7-b62a-e3eba8a4310b", "name": "開発目標提示要求", "text": "MBVで使用するPin充電の電圧リプル算出、満充電判定制御に必要な電池データ（AC充電中のリプル100HzにおけるリアクタンスR(Ω)、インダクタンスL(H)）を提示すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:35:14.709440", "ref": null}, "className": "Requirement"}
{"id": "108c2cf0-0589-48e0-8ad8-fb0d189ae592", "name": "測定温度条件要求", "text": "測定条件として、-30℃, -10℃, 0℃, 10℃, 25℃ @95%SOCで測定を行うこと。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:35:14.709594", "ref": null}, "className": "Requirement"}
{"id": "9ae79037-1aaf-49c8-a217-d2b39e947d80", "name": "提示データ条件要求", "text": "100Hz パック抵抗 (セル抵抗×96直＋パック配線抵抗) 10年/25年を提示データ条件とすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:35:14.709860", "ref": null}, "className": "Requirement"}
{"id": "b20aacd9-e866-4554-ab83-2ef1938413bb", "name": "温調時間要求", "text": "温調時間を5時間とすること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:35:14.710075", "ref": null}, "className": "Requirement"}
{"id": "8842e662-adec-4a31-8c5d-fa485788546c", "name": "周波数範囲要求", "text": "周波数範囲を10m Hz ~ 100k Hzとすること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:35:14.710303", "ref": null}, "className": "Requirement"}
{"id": "c2d21eb3-058d-48d6-addf-c46857805008", "name": "制御方式要求", "text": "制御方式は電流制御とすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:35:14.710437", "ref": null}, "className": "Requirement"}
{"id": "a98a6d59-538d-497e-bc16-69c30d9d9b0d", "name": "電流制限要求", "text": "電圧振幅の場合、測定装置に大電流が流れる可能性があるため、高容量セルでは電流振幅を±1 Aで制限すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:35:14.710578", "ref": null}, "className": "Requirement"}
{"id": "04ab8479-9959-4f51-b81c-fa2a7d81c03f", "name": "100Hz抵抗提示方法検討要求", "text": "100Hz抵抗の提示について、HEV電池セルがほぼインダクタンス成分を含まず測定系の配線情報であることを考慮した適切な方法を検討すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:35:14.710744", "ref": null}, "className": "Requirement"}
{"id": "c2803699-acdd-4b3e-b8b1-21e31a756186", "name": "到達上限電圧安全要求", "text": "パック抵抗が高いほどPin充電の電圧リプルが大きくなり到達上限電圧が上がるため、安全性を考慮した設計とすること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:35:14.710971", "ref": null}, "className": "Requirement"}
{"id": "de8ba0fd-ba6c-4c0f-92ac-b289ed3732df", "type": "containment", "sourceId": "53e3ed1b-816b-4804-aba8-4256dba765f5", "targetId": "c2803699-acdd-4b3e-b8b1-21e31a756186", "name": null, "description": null, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:35:14.711080", "ref": null}, "connectorType": null, "flowType": null, "guard": null, "edgeType": null, "sequenceOrder": null, "className": "Relationship"}
{"id": "e315e348-183f-4523-a76f-96956a819560", "name": "100Hz抵抗算出要求", "text": "100Hzの抵抗として、実軸と虚軸の抵抗成分を合成したインピーダンス絶対値|Z|を算出すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:35:14.711280", "ref": null}, "className": "Requirement"}
{"id": "3f7e8c2a-4165-4ffc-8f77-1ef9e5354821", "name": "測定SOC要件", "text": "電池実SOCの5〜95%を車両上の0〜100%と定義するシステムにおいて、車両の満充電に相当するSOC95%でデータを測定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:35:14.711405", "ref": null}, "className": "Requirement"}
{"id": "227180f1-d50c-4d15-8fb7-0abbbcae24db", "name": "SOC10%におけるセルの等価回路パラメータフィッティング解析要求", "text": "SOC10%において、-35℃、-30℃、-20℃の各温度環境下で、Zviewを用いてセルのCole-coleプロット（fitting込み）および等価回路パラメータ（R1, CPE1-T, CPE1-P, R2, CPE2-T, CPE2-P, R3, L1）のフィッティング解析を実施すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:35:14.711520", "ref": null}, "className": "Requirement"}
{"id": "98c26f77-57a9-430a-987f-b6f4cefcf7e5", "name": "低温等価回路パラメータフィッティング精度要求", "text": "温度-10℃環境下での等価回路パラメータR1のフィッティングにおける誤差率（Error %）を2.53%以下とすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:35:14.711774", "ref": null}, "className": "Requirement"}
{"id": "5da69062-1994-4098-820f-3118e0d11530", "name": "常温等価回路パラメータフィッティング精度要求", "text": "温度0℃環境下での等価回路パラメータR1のフィッティングにおける誤差率（Error %）を2.10%以下とすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:35:14.711895", "ref": null}, "className": "Requirement"}
{"id": "46ceb868-9199-4819-b9d3-2ed31ee9260c", "name": "高温等価回路パラメータフィッティング精度要求", "text": "温度10℃環境下での等価回路パラメータR1のフィッティングにおける誤差率（Error %）を2.29%以下とすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:35:14.712005", "ref": null}, "className": "Requirement"}
{"id": "0a626cb8-80d6-406f-a04d-47e66a612da6", "name": "25度フィッティングパラメータ要求", "text": "25℃におけるCole-coleプロットのフィッティングパラメータ値は、R1が0.0003053、CPE1-Tが504.4、CPE1-Pが0.49279、R3が0.00033171、L1が9.4469E-7とすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:35:14.712232", "ref": null}, "className": "Requirement"}
