{"id": "e1bd722d-7f26-4f9d-b65a-99553254b428", "name": "外形寸法要件", "text": "システムおよび構成部品の外形寸法が規定の範囲内であること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:29:53.340704", "ref": null}, "className": "Requirement"}
