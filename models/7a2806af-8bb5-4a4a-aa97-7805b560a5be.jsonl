{"id": "e5ab9543-b4be-40c9-ba3f-cbedd7700a0e", "name": "負極側サーミスタ設置範囲要求（max/min表記修正）", "text": "サーミスタ設置範囲（負極側）は、設置可能な最低限の範囲を確保するために、max寸法表記からmin寸法表記（82.90min.および25.60min.）へ変更すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:29:53.341870", "ref": null}, "className": "Requirement"}
{"id": "cd7727e3-d441-4030-a011-5009df6e1eb3", "name": "負極側サーミスタ設置範囲採寸基準要求", "text": "サーミスタ設置範囲（負極側）の採寸位置は、セル中心から斜線部端までとし、71.4max.に設定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:29:53.342264", "ref": null}, "className": "Requirement"}
{"id": "5ad58c29-4407-4112-8439-ecc7168435a8", "name": "陽極側サーミスタ設置範囲記載要求", "text": "サーミスタの設置は負極側のみとするが、将来の必要性に備えて陽極側サーミスタ設置範囲の記載を残すこと。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:29:53.342748", "ref": null}, "className": "Requirement"}
{"id": "3a625f09-05da-448d-9e02-97b2d90d24a1", "name": "外部端子カバー側面公差要求（BBMケース干渉防止）", "text": "外部端子カバー側面からセル外形までの公差は、BBMケースとの干渉およびケース削り量を低減するために、±1.00から±0.8に低減すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:29:53.343120", "ref": null}, "className": "Requirement"}
{"id": "270af8f0-c45d-4640-bba8-71b7557ec722", "name": "外部端子樹脂カバー寸法公差要求", "text": "外部端子樹脂カバー寸法について、BBMケースとの干渉を防ぐため、公差を41±0.2とすること（検討の結果41±0.4にて決定）。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:29:53.343671", "ref": null}, "className": "Requirement"}
{"id": "7089e154-336e-4d7e-9cbc-3f5a8a52c511", "name": "端子平行度・平面度要求", "text": "セル平行度・平面度は溶接性確保および干渉防止のため、平行度//0.4[データムY]、平面度▢0.06に修正反映すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:29:53.344014", "ref": null}, "className": "Requirement"}
{"id": "0ba2f928-3193-4feb-9dac-4bcea9615ffd", "name": "セル上面突起高さ要求", "text": "セル注液口とBBMケースの干渉を避けるため、セル上面の突起（注液口）高さを1.0max.指示に変更すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:29:53.344333", "ref": null}, "className": "Requirement"}
{"id": "750046fb-dd22-49b7-911c-a971a68af7a4", "name": "セル上面突起径要求", "text": "BBMケース最下面と注液口の干渉を回避するため、セル上面の突起径（注液口）をΦ8maxに変更すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:29:53.345034", "ref": null}, "className": "Requirement"}
{"id": "23d3e792-3c3f-43e3-855b-24ef0d02e648", "name": "セル幅公差要求", "text": "BBMケースの乗り上げや溶接ずれ、スタック拘束荷重低減を考慮し、単セル公差±0.6mm、スタック積層時のみなし公差±0.55mmに設定すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:29:53.345233", "ref": null}, "className": "Requirement"}
{"id": "1c0009e9-392c-4857-b7f3-8819dc32d7e8", "name": "外部端子カバー高さ要求", "text": "バスバー設置時の溶接干渉を防ぐため、外部端子厚みをmin0.1に設定して溶接要件を成立させること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:29:53.345415", "ref": null}, "className": "Requirement"}
{"id": "731336bb-b625-4f45-b03d-983cbf6cf947", "name": "フタ平面度要求", "text": "BBMケースの引っかかりを防ぐため、高さ公差の範囲内であっても、蓋単品図面にてフタの平面度を指示すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:29:53.345591", "ref": null}, "className": "Requirement"}
{"id": "f82d6b75-1aae-436f-8611-636ae15a3bd6", "name": "外部端子カバー高さ公差の提示", "text": "外部端子カバーの高さ公差のmax値を回答・提示すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:29:53.345765", "ref": null}, "className": "Requirement"}
{"id": "5ca7286e-55c1-4c56-965d-a4b0fea7896a", "name": "溶接不可設定範囲の根拠確認", "text": "φ4白丸の溶接不可設定範囲の根拠として、設定理由のφ4の円が凹であり、へこみが生産上の位置決めであることを確認すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:29:53.346166", "ref": null}, "className": "Requirement"}
{"id": "62a59fc0-ab47-4c32-88f9-e5aa67af12f4", "name": "仕入先への指定品採用要望", "text": "テープ寸法以外の仕様（材質メーカー）に関して、6.AではTMCポリシーとして仕入先に指定品として採用を要望すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:29:53.346592", "ref": null}, "className": "Requirement"}
{"id": "b2038f3d-dc82-47e3-bef7-7e4a44be4e70", "name": "セル厚み測定条件の模擬要求", "text": "セルの厚み測定条件は、極力モジュール組付け時にセルへ印加される荷重パターンを模擬すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:29:53.347037", "ref": null}, "className": "Requirement"}
{"id": "8962537e-4144-4fa2-b8d9-fa90f8903410", "name": "測定条件パラメータ設定要求", "text": "測定における圧縮・解放速度は5mm/minとし、過圧縮区間（40sec）およびセル厚み測定区間（60sec）を確保して設定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:29:53.347210", "ref": null}, "className": "Requirement"}
