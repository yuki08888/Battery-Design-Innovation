{"id": "f18f8671-995f-4c51-aaa9-9395efc9b5dc", "name": "端子発熱性能要求", "text": "要求された通電状態において、端子の発熱量が規定の要求値を達成すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:29:53.341655", "ref": null}, "className": "Requirement"}
