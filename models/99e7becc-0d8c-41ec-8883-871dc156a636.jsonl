{"id": "99e7becc-0d8c-41ec-8883-871dc156a636", "name": "要求", "description": "要求要素", "isReferenceModel": false, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:10:51.716566", "ref": null}, "className": "Package"}
{"id": "0f35991d-4d7f-4ffe-9a5d-2bcdad888c17", "name": "600sLi析出評価要求", "text": "600s通電サイクル試験において、Li析出が発生しない電流を確認し、最大許容電流および許容CCVを決定できること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:11:52.298337", "ref": null}, "className": "Requirement"}
{"id": "18d70667-d8e9-473b-b311-68e3475ae514", "name": "最大許容電流決定要求", "text": "急速充電波形を決定するため、各SOCに対する最大許容電流を決定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:11:52.298568", "ref": null}, "className": "Requirement"}
{"id": "c399bbec-c960-4c7a-992d-1dcce1b0c9f5", "name": "充電時間評価要求", "text": "拡散飽和状態を考慮し、600秒以上の通電時間による評価を実施すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:11:52.298711", "ref": null}, "className": "Requirement"}
{"id": "6501af0c-8a81-4ac8-beee-6f6b02441aeb", "name": "試験サイクル数要求", "text": "図3, 図4, 図5で定義される600sサイクル試験パターンにおいて、少なくとも100サイクル試験を行うこと。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:11:52.298838", "ref": null}, "className": "Requirement"}
{"id": "2d757613-1a0a-4896-883f-8f038fcdd504", "name": "最低拘束荷重の設定要求", "text": "車両からの入力及び電極群に必要な最低拘束荷重を下限荷重として設定すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:11:52.299190", "ref": null}, "className": "Requirement"}
{"id": "c3a9a584-8aaa-42df-8866-1b353dfeb70b", "type": "containment", "sourceId": "99e7becc-0d8c-41ec-8883-871dc156a636", "targetId": "2d757613-1a0a-4896-883f-8f038fcdd504", "name": null, "description": null, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:11:52.299268", "ref": null}, "connectorType": null, "flowType": null, "guard": null, "edgeType": null, "sequenceOrder": null, "className": "Relationship"}
{"id": "47c54328-5ace-4977-a4be-2d9f5acaad9b", "name": "衝撃・振動試験による荷重決定要求", "text": "車両からの最大入力Gを考慮した衝撃・振動試験を実施して最低拘束荷重を決定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:11:52.299350", "ref": null}, "className": "Requirement"}
{"id": "15c9a705-bffb-41f9-a1e1-192e7201f2a0", "name": "充電過多抑制のための荷重設定要求", "text": "充電過多ハイレートになりにくい低荷重を下限荷重として設定すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:11:52.299489", "ref": null}, "className": "Requirement"}
{"id": "7e7a1cef-e0fa-40c4-bccd-74a71c6769e3", "name": "到達SOC80%以上の充電制御要求", "text": "到達SOC80%以上の際には、SOC80%要求電流値でSOC80%に到達するまで充電した後、続けてSOC95%要求電流値でSOC95%に到達するまで充電を実施すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:11:52.299629", "ref": null}, "className": "Requirement"}
{"id": "2561701f-4a24-42a7-b3ef-b485444c825d", "type": "containment", "sourceId": "99e7becc-0d8c-41ec-8883-871dc156a636", "targetId": "7e7a1cef-e0fa-40c4-bccd-74a71c6769e3", "name": null, "description": null, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:11:52.299704", "ref": null}, "connectorType": null, "flowType": null, "guard": null, "edgeType": null, "sequenceOrder": null, "className": "Relationship"}
{"id": "3dbfb6bd-89b9-4a09-85e3-2a1ffb13a152", "name": "Li6.A電池セルの必要拘束最低荷重要求", "text": "Li6.Aの必要拘束最低荷重は、0.8KN以上とすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:11:52.299778", "ref": null}, "className": "Requirement"}
{"id": "f89ae6f7-6860-4c6d-b895-beccac5c177b", "name": "急速充電におけるリチウム析出抑制要求", "text": "急速充電電流波形に対して、各SOC40, 60, 80およびその他の温度帯において解体時にLi析出が発生しないこと。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:11:52.299917", "ref": null}, "className": "Requirement"}
{"id": "f2157d97-8a0d-47c9-9110-0434ed1a6400", "type": "containment", "sourceId": "99e7becc-0d8c-41ec-8883-871dc156a636", "targetId": "f89ae6f7-6860-4c6d-b895-beccac5c177b", "name": null, "description": null, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:11:52.299977", "ref": null}, "connectorType": null, "flowType": null, "guard": null, "edgeType": null, "sequenceOrder": null, "className": "Relationship"}
{"id": "d190aec7-5b03-49bc-b910-15754b711ed2", "name": "MOL通電サイクル劣化評価要求", "text": "劣化後品（MOL）において、『BEV設計コンセプト_劣化後電池の析出評価方法』内で示した通電サイクル劣化品を用いて同様に問題無き事を確認すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:11:52.300044", "ref": null}, "className": "Requirement"}
{"id": "d529ca52-c975-4e46-81e9-0d31b4225656", "type": "containment", "sourceId": "99e7becc-0d8c-41ec-8883-871dc156a636", "targetId": "d190aec7-5b03-49bc-b910-15754b711ed2", "name": null, "description": null, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:11:52.300278", "ref": null}, "connectorType": null, "flowType": null, "guard": null, "edgeType": null, "sequenceOrder": null, "className": "Relationship"}
{"id": "63d4421b-e81c-425d-b356-71127896c64d", "name": "MOL電流条件検証要求", "text": "10年間は初期と同じ電流値であるため、MOLに関しても初期と同電流条件にて確認を行うこと。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:11:52.300519", "ref": null}, "className": "Requirement"}
{"id": "8595f680-a8c1-4699-9178-8a8bebe7be6b", "name": "EOL析出耐性評価要求", "text": "容量劣化とともに負極抵抗が下がり続けLi析出耐性はケミカルとして良化する傾向に基づき、EOLにおいても析出耐性に問題がないことを確認すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:11:52.300684", "ref": null}, "className": "Requirement"}
