{"id": "6edd0ef3-45d2-4340-b6c7-d6d97d468a5f", "type": "action", "name": "部品別熱容量を計算する", "description": "各部品の比熱と重量から、それぞれの熱容量を算出する。", "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T08:55:05.414388", "ref": null}, "actionSubType": "opaque", "body": "各部品の比熱にそれぞれの重量を乗算し、部品ごとの熱容量を算出する。", "language": "text", "behaviorRef": null, "objectType": null, "objectBlockRef": null, "inState": null, "upperBound": null, "ordering": null, "isFlowFinal": null, "decisionInput": null, "joinSpec": null, "className": "ActivityNode"}
