{"id": "38cc1cd4-cf16-47dc-8c7d-e7b4a4d46363", "type": "action", "name": "構成材料と重量を取得する", "description": "各構成部品の構成材料と重量データを取得する。", "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T08:55:05.412059", "ref": null}, "actionSubType": "opaque", "body": "各構成部品の材質および重量を取得する。", "language": "text", "behaviorRef": null, "objectType": null, "objectBlockRef": null, "inState": null, "upperBound": null, "ordering": null, "isFlowFinal": null, "decisionInput": null, "joinSpec": null, "className": "ActivityNode"}
