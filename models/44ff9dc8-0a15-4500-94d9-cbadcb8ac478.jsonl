{"id": "ff54053e-442c-4878-8cd7-6c3a23f3bb21", "type": "action", "name": "比熱を算出する", "description": "各部品の構成材料から比熱を算出する。", "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T08:55:05.412224", "ref": null}, "actionSubType": "opaque", "body": "各構成材料に対応する比熱データベース、または実測データから比熱を取得し、各材料の比熱を算出する。", "language": "text", "behaviorRef": null, "objectType": null, "objectBlockRef": null, "inState": null, "upperBound": null, "ordering": null, "isFlowFinal": null, "decisionInput": null, "joinSpec": null, "className": "ActivityNode"}
