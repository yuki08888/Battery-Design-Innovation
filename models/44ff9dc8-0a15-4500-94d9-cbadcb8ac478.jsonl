{"id": "3dab3d0f-652a-4e9a-956b-7876147af349", "type": "action", "name": "構成部品を特定する", "description": "電池セルを構成する部品一覧を特定する。", "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T08:55:05.411941", "ref": null}, "actionSubType": "opaque", "body": "電池セルを構成する各部品（捲回体、ケース、カバー、絶縁フィルム、電解液、端子類など）を特定する。", "language": "text", "behaviorRef": null, "objectType": null, "objectBlockRef": null, "inState": null, "upperBound": null, "ordering": null, "isFlowFinal": null, "decisionInput": null, "joinSpec": null, "className": "ActivityNode"}
