{"id": "ebd0d353-80e8-43d0-9b47-e66d2e1631e3", "name": "リプル電流耐性要求", "text": "力行・回生時におけるリプル電流耐性を確保すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:57:30.591203", "ref": null}, "className": "Requirement"}
