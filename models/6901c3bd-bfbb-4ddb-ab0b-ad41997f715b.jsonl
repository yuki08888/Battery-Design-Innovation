{"id": "4ef97d75-78f1-4493-ac96-8d92d90f252a", "name": "電池特性影響検証要求", "text": "発生したリプル電流（全周波数）により電池特性（抵抗増加・容量維持率）に影響がないことを確認すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:57:30.592124", "ref": null}, "className": "Requirement"}
{"id": "3df9a559-30ef-4d6d-92f9-160dcb3aa63d", "name": "発熱影響検証要求", "text": "発生したリプル電流（全周波数）により発熱影響がないことを確認すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:57:30.602013", "ref": null}, "className": "Requirement"}
{"id": "b3422098-2402-4e92-b9b0-a4092424208f", "name": "Li析出耐性検証要求", "text": "発生したリプル電流（1kHz以下）によりLi析出耐性に影響がないことを実セル評価にて確認すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:57:30.606153", "ref": null}, "className": "Requirement"}
{"id": "00a7b272-84eb-45fc-8c0b-3b0ee2119868", "name": "負荷変動考慮評価要求", "text": "モーター回転数やトルクで変動するリプル電流の負荷変動に沿った評価を行うこと。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:57:30.609160", "ref": null}, "className": "Requirement"}
{"id": "82875af3-16a8-4f69-b149-db52b4ce38de", "name": "電池特性影響のサイクル評価比較要求", "text": "通常のパターンとリプルを乗せたパターンの2パターンでサイクル評価を行い比較すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:57:30.612950", "ref": null}, "className": "Requirement"}
{"id": "78bd5f67-51fc-4981-a0fb-198d4e55cf3a", "name": "電池特性影響要求", "text": "容量維持率・抵抗増加率共に、リップル有無による有意差無きこと。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:57:30.615160", "ref": null}, "className": "Requirement"}
{"id": "818707ba-801d-4361-b237-26616f7dd28a", "name": "熱影響制限要求", "text": "サーミスタ部温度においてΔTが7℃以下であり、かつ40℃スタートでもWout制限が無いこと。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:57:30.617401", "ref": null}, "className": "Requirement"}
{"id": "b6f6047f-7a86-4196-b571-8fc6d1869419", "name": "Li析出耐性評価要求", "text": "回生時のLi析出耐性へのリプル電流影響を確認するため、電池温度が上がらない短秒数（Win_MAX：250A付近）においてリプル電流の有無による析出耐性の変化を評価すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:57:30.617553", "ref": null}, "className": "Requirement"}
{"id": "99137d4c-18c9-429b-9055-d2dd9ee4d32d", "name": "回生パターンリプル電流算出要求", "text": "リプル電流を算出するため、車速80km/hからのフル回生パターン（250A×10secを狙うパターン）を基準とすること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:57:30.617726", "ref": null}, "className": "Requirement"}
