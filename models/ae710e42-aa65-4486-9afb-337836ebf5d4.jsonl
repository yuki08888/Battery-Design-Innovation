{"id": "ffcff3fa-eec9-46e9-860e-685bb2d68935", "name": "初期内圧試算におけるヤード放置前提適用要求", "text": "Li7.Aにおいては、欧州仕向けがないため、北米ヤード放置前提（合計日数210日：30℃で180日、40℃で30日）を初期内圧の計算に使用すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:41:17.798157", "ref": null}, "className": "Requirement"}
{"id": "4e6a5bfa-8059-4b5f-8b0a-84977742d442", "name": "安全弁作動圧力仕様要求", "text": "初期状態（BOL）かつ25℃における安全弁の作動圧力は0.9±0.2MPaとすること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:41:17.798645", "ref": null}, "className": "Requirement"}
{"id": "8044bbd9-38bd-4fef-ab87-578d47492d67", "name": "電解液中水分量管理要求", "text": "電解液中の水分濃度は20ppm未満とすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:41:17.798827", "ref": null}, "className": "Requirement"}
{"id": "9d8bdd1d-f88c-4843-88cd-d044e3a5e7d9", "name": "各SOCレンジに対応する内圧上昇速度の適用要求", "text": "市場頻度の各SOCレンジに対して、一律適用ではなく、対応する内圧上昇速度を適用して寿命見積を計算すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:41:17.800388", "ref": null}, "className": "Requirement"}
{"id": "956a2a90-b593-4b27-91cb-9c63c151b219", "name": "評価水準設定制約要求", "text": "アレニウスプロットを作成する際、推定バラつきを防ぐために、ガス発生が過剰に少ない条件(室温×低SOC)や、多量の条件(高温×高SOC)を評価水準に含まないようにすること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:41:17.800957", "ref": null}, "className": "Requirement"}
{"id": "0721c960-9997-44b5-822c-88a941fdc7ac", "name": "ラミネート型セルの内圧算出に関する要求", "text": "ラミネート型セルの内圧は、耐久後セルのガスを採集し体積およびガス種を計測し、電解液中に溶解するガス量分を補正してセル残空間と合わせて算出すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:41:17.801280", "ref": null}, "className": "Requirement"}
{"id": "1cfd6f6e-572b-4816-b0d4-b23ac1ee6ed9", "name": "セル残空間値の採用に関する要求", "text": "Li9.Aにおけるセルの残空間は、開封まで十分余裕を持った値を一定値として採用すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:41:17.801618", "ref": null}, "className": "Requirement"}
