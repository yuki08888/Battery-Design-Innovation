{"id": "dae42c54-1ea6-48dd-981f-6ba8e1a10bbe", "name": "溶解ガス量算出要求", "text": "溶解ガス量は、温度と圧力に依存するため、溶解量を補正した内圧が一致する点を溶解ガス量とすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:41:17.784655", "ref": null}, "className": "Requirement"}
{"id": "9823d6fe-85bb-47ed-ab48-c30a3e91f18e", "name": "ガス排出弁および溶接部の機能設計要求", "text": "市場において排出弁から開弁し圧力を逃がせるよう、開弁圧が「ガス排出弁 ＜ 封缶およびその他溶接部」の順に設計されていること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:41:17.786600", "ref": null}, "className": "Requirement"}
{"id": "319d2bd7-e612-47b6-8219-ae36c982b238", "name": "市場耐圧寿命要求", "text": "仕向け最悪地域において「市場内圧上昇 ＜ 排出弁 ＜ 封缶及びその他溶接部」となり、耐圧寿命が保証年数25年を満たしていること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:41:17.787542", "ref": null}, "className": "Requirement"}
{"id": "aade4580-42b3-4787-9df2-48d70b60df92", "name": "ラーソンミラーダメージ指数要求（6.B）", "text": "ラーソンミラーダメージ指数が0.5以下であること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:41:17.788781", "ref": null}, "className": "Requirement"}
{"id": "a2ad9483-5eff-4cd5-ad61-664d75848360", "name": "溶接部破断回避要求（7.B）", "text": "溶接部破断無きこと。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:41:17.790739", "ref": null}, "className": "Requirement"}
{"id": "849a18fa-2583-4fba-b560-74abfe244f03", "name": "ラーソンミラーダメージパウチ開封回避要求（9.A）", "text": "ラーソンミラーダメージパウチ開封無きこと。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:41:17.793145", "ref": null}, "className": "Requirement"}
{"id": "ded5d4ec-9215-44cb-a498-5dc3e94e9e2b", "name": "耐久年数要求（共通）", "text": "耐久寿命が25年であること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:41:17.795392", "ref": null}, "className": "Requirement"}
{"id": "0183ca78-20ca-499e-91cf-c99ee429b3a3", "name": "耐久距離要求（共通）", "text": "耐久走行距離が100万kmであること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:41:17.796075", "ref": null}, "className": "Requirement"}
{"id": "b26519cb-5a05-4c5f-a774-0d1503813cb6", "name": "セル仕様耐圧下限要求（6.B）", "text": "耐圧下限が-5σ以上であること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:41:17.797220", "ref": null}, "className": "Requirement"}
{"id": "b1c3c05a-8273-49d6-adc2-4ff1e4917ac7", "name": "セル仕様耐圧下限要求（7.B）", "text": "耐圧下限が-3σ以上であること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:41:17.797410", "ref": null}, "className": "Requirement"}
{"id": "3115a2c6-1359-44d6-8fab-7a68de4430b7", "name": "セル仕様耐圧下限要求（9.A）", "text": "耐圧下限が-3σであること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:41:17.797561", "ref": null}, "className": "Requirement"}
{"id": "ca5eccc5-0997-46fc-994b-c3ae8c95c3f4", "name": "耐圧寿命保証要求", "text": "残車率≒0のコンセプトを維持し、保証定義を25年または100万kmとすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:41:17.797752", "ref": null}, "className": "Requirement"}
