{"id": "1884a524-bc71-464f-8987-74c2153738fd", "name": "セル内圧推定要求", "text": "セルの内圧を推定すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:41:17.782799", "ref": null}, "className": "Requirement"}
