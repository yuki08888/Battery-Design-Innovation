{"id": "f31b0110-5d7f-449a-b3d8-6f6dce028d48", "name": "温度依存性同等性確認要求", "text": "40℃・60℃でグラフを引いた際に、他SOCの傾きと比較し、温度依存が同等になるかの観点でも確認すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:41:17.772258", "ref": null}, "className": "Requirement"}
{"id": "fb7765ff-b95c-4ef5-9a85-5554b9f59745", "name": "中間温度値内挿算出要求", "text": "内挿により中間の温度値を求めること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:41:17.774704", "ref": null}, "className": "Requirement"}
{"id": "71330276-f06b-49c4-b7d9-205cc10714c4", "name": "SOC依存性取得評価準備要求", "text": "設計上ガス発生がしやすいと想定される場合には、SOC依存性取得の評価を構えること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:41:17.780428", "ref": null}, "className": "Requirement"}
