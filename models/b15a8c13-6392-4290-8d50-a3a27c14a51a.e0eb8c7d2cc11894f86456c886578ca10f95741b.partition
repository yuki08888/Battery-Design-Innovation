{"id": "ccc10095-612e-4461-ac6b-5905d377cb56", "name": "CTR-IC-001 絶縁カバー絶縁抵抗維持", "text": "絶縁カバーは熱拡散試験後も絶縁抵抗100MΩ以上を維持すること。", "description": "絶縁カバーは熱拡散試験後も絶縁抵抗100MΩ以上を維持すること。", "stereotypes": [], "risk": null, "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:38:09.541881", "ref": null}, "className": "Requirement"}
{"id": "c392ad07-6e0d-40be-bbe5-27d83a65d52c", "name": "CTR-IC-002 活電部・アッパーケース間絶縁保護", "text": "絶縁カバーは熱拡散試験後も活電部とアッパーケース・PN間の絶縁保護を維持すること。", "description": "絶縁カバーは熱拡散試験後も活電部とアッパーケース・PN間の絶縁保護を維持すること。", "stereotypes": [], "risk": null, "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:38:09.543367", "ref": null}, "className": "Requirement"}
{"id": "eaf6ee62-be06-4427-97a7-26858ef199f7", "name": "CTR-IC-004 衝突変形後絶縁抵抗維持", "text": "絶縁カバーは衝突変形後も活電部とアッパーカバーの接触を防止し、絶縁抵抗100MΩ以上を維持すること。", "description": "絶縁カバーは衝突変形後も活電部とアッパーカバーの接触を防止し、絶縁抵抗100MΩ以上を維持すること。", "stereotypes": [], "risk": null, "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:38:09.544678", "ref": null}, "className": "Requirement"}
{"id": "b3b6a56c-c623-4c9f-9412-249e52c7c1e0", "name": "CTR-IC-005 高温金属片破損防止・絶縁抵抗維持", "text": "絶縁カバーは高温金属片による破損を生じず、絶縁抵抗100MΩ以上を維持すること。", "description": "絶縁カバーは高温金属片による破損を生じず、絶縁抵抗100MΩ以上を維持すること。", "stereotypes": [], "risk": null, "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:38:09.545978", "ref": null}, "className": "Requirement"}
{"id": "3c84c5f1-578c-4d9a-87e8-ed4aac4cc1f2", "name": "CTR-IC-006 短絡経路形成防止", "text": "絶縁カバーは熱暴走発生時にセル間、MOD間、BBMコネクタ周辺で短絡経路を形成しないこと。", "description": "絶縁カバーは熱暴走発生時にセル間、MOD間、BBMコネクタ周辺で短絡経路を形成しないこと。", "stereotypes": [], "risk": null, "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:38:09.547257", "ref": null}, "className": "Requirement"}
{"id": "d2301f96-e2d4-47d8-a435-559b01b7afaa", "name": "CTR-IC-007 噴出物堆積熱パス形成防止構造", "text": "絶縁カバーは噴出物の堆積による熱パス形成を防止する構造を有すること。", "description": "絶縁カバーは噴出物の堆積による熱パス形成を防止する構造を有すること。", "stereotypes": [], "risk": null, "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:38:09.548448", "ref": null}, "className": "Requirement"}
{"id": "51a92525-0e76-461b-ad58-65b302e7dc8e", "name": "CTR-IC-008 セル間短絡防止絶縁保護構造", "text": "絶縁カバーはセル間短絡の発生を防止する絶縁・保護構造を有すること。", "description": "絶縁カバーはセル間短絡の発生を防止する絶縁・保護構造を有すること。", "stereotypes": [], "risk": null, "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:38:09.549531", "ref": null}, "className": "Requirement"}
{"id": "fd71fbc9-3828-4c45-96ae-9e3b6e1e5504", "name": "CTR-IC-009 モジュール間短絡防止・リークパス形成防止", "text": "絶縁カバーはモジュール間短絡を防止し、リークパスを形成しないこと。", "description": "絶縁カバーはモジュール間短絡を防止し、リークパスを形成しないこと。", "stereotypes": [], "risk": null, "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:38:09.551147", "ref": null}, "className": "Requirement"}
{"id": "8d7e0c7c-feca-415c-83db-2e729e91b2b7", "name": "CTR-IC-010 保護材内部噴出物侵入防止構造", "text": "絶縁カバーは保護材内部への噴出物侵入を防止する構造を有し、静隙を3mm以下に抑えること。", "description": "絶縁カバーは保護材内部への噴出物侵入を防止する構造を有し、静隙を3mm以下に抑えること。", "stereotypes": [], "risk": null, "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:38:09.552675", "ref": null}, "className": "Requirement"}
{"id": "c43319e1-e7a7-4ba3-959a-5759fcadd010", "name": "CTR-IC-003 熱拡散中状態変化防止", "text": "絶縁カバーは熱拡散試験中に脱落・剥離・破損を生じず、短絡および熱連鎖を引き起こす状態変化を生じないこと。", "description": "絶縁カバーは熱拡散試験中に脱落・剥離・破損を生じず、短絡および熱連鎖を引き起こす状態変化を生じないこと。", "stereotypes": [], "risk": null, "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:38:14.297495", "ref": null}, "className": "Requirement"}
