{"id": "3ae2f3e3-7a97-4d9e-a050-e1ba68fe47a0", "name": "高温保存試験の試験温度設定要求", "text": "高温保持試験において、試験温度はLi6.A/Bでは75℃、Li7.A/BおよびLi9.Aでは70℃に設定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.463476", "ref": null}, "className": "Requirement"}
{"id": "795d9402-2a69-4db6-a55a-1c780adff52f", "name": "高温保存試験の保持時間設定要求", "text": "高温保持試験において、保持時間はLi6.A/Bでは850時間、Li7.A/Bでは1000時間に設定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.464260", "ref": null}, "className": "Requirement"}
{"id": "baffa652-df4a-4331-8fc4-965df0e0ca90", "name": "高温保存試験の電池SOC設定要求", "text": "高温保持試験における電池のSOCは100%（満充電状態）に設定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.464403", "ref": null}, "className": "Requirement"}
{"id": "fdfafe6d-2e7d-4986-aec8-0a0297d5c964", "name": "高温保存試験の拘束条件要求", "text": "高温保持試験における拘束条件は、Li6.A/Bではセル厚みセンター定寸、Li7.A/Bでは3.0kNに設定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.464527", "ref": null}, "className": "Requirement"}
