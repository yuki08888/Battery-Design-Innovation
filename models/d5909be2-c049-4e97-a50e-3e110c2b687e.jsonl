{"id": "174b209e-d040-4c66-a854-9c17468048e5", "name": "eta1算出式", "description": "熱膨張による液の流出項(面方向)の算出式", "inputNames": ["R", "I"], "outputNames": ["eta_1"], "parameters": {}, "code": "eta_1 = R * (I ** 2)", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:47:16.831567", "ref": null}, "className": "ConstraintBlock"}
