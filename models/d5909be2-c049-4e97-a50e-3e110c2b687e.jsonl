{"id": "3d81db62-9a54-4239-8574-aa15ba58cd2d", "name": "ガード電流要求適合制約", "description": "充電側および放電側の要求適合評価において、望ましい要求値(Want)から必須として満たすべきガード閾値(Must)の値を評価・決定します。本設計ではWant値をベースにMust値を適合します。", "inputNames": ["charge_limit_want", "discharge_limit_want"], "outputNames": ["charge_limit_must", "discharge_limit_must"], "parameters": {}, "code": "charge_limit_must = charge_limit_want\ndischarge_limit_must = discharge_limit_want", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:51:01.909209", "ref": null}, "className": "ConstraintBlock"}
