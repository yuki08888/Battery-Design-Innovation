{"id": "895ec09b-25f6-4ebe-9b13-006bf2e66dac", "name": "SigmaD推定式", "description": "時刻 n+1 におけるΣD累積値（図29 ΣD制御式の一部）を、前時刻の累積値、電流、劣化指標D、および各種定数を用いて計算する。", "inputNames": ["gamma", "sigmad", "eta1", "eta2", "current", "dn"], "outputNames": ["sigmad_next"], "parameters": {}, "code": "sigmad_next = gamma * sigmad + (eta1 * (current ** 2) + eta2 * current) * dn", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:47:16.827815", "ref": null}, "className": "ConstraintBlock"}
