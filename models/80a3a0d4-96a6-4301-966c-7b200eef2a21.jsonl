{"id": "3ed4ca8c-074a-464d-be43-0cef3b1aabe9", "name": "連続通電試験を実施する", "description": "一定の電流（264Aで1800秒、または232Aで2725秒）を連続して流し、電極群とシール部の温度差および温度制限を確認する試験を行う。", "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:07:35.658669", "ref": null}, "messageOrder": [], "className": "UseCase"}
{"id": "f644f777-d324-427d-b1d3-9575b8ad2de2", "name": "断続通電試験を実施する", "description": "大電流を断続的（短時間）に流し、シール部の温度上昇や集電部の溶断、熱暴走が無いことを確認する試験を行う。", "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:07:35.658845", "ref": null}, "messageOrder": [], "className": "UseCase"}
{"id": "867c5a23-df3a-4546-8885-adbf564bdb5e", "name": "底面を冷却する", "description": "底面を冷却するために、3セルMODの底面に冷却プレートを設置し、LLCを6L/minで循環させて評価を行う。", "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:07:35.690989", "ref": null}, "messageOrder": [], "className": "UseCase"}
{"id": "97f9255e-86ff-4259-b087-a25fceb8834e", "name": "熱の籠り方を模擬する", "description": "セルがパックで密閉されることによる熱の籠り方をある程度模擬するため、3セルMODの上に風防を設置して試験を行う。", "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:07:35.691805", "ref": null}, "messageOrder": [], "className": "UseCase"}
{"id": "a01ff1bd-a443-4a5a-bde5-7b7da9275bd6", "name": "冷却を模擬しながらモジュール試験を行う", "description": "パウチフィルムの表面に熱電対を貼り付け、トヨタ車両の冷却性能を模擬できるモジュールベンチで無冷却ではなく冷却を模擬しながら試験を行う。", "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:07:35.714852", "ref": null}, "messageOrder": [], "className": "UseCase"}
{"id": "953a6250-17a5-417a-8f06-cef972d28aec", "name": "短時間通電試験を実施する", "description": "発熱と冷却が釣り合う最悪条件（50℃、SOC100%から開始）において、電流を繰り返し印加し、短時間通電時の温度変化を評価・検証する。", "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:07:35.715279", "ref": null}, "messageOrder": [], "className": "UseCase"}
{"id": "95a63bf3-290a-4e90-8f06-fb4daf702277", "name": "長時間通電試験を実施する", "description": "発熱と冷却が釣り合う最悪条件（50℃、SOC50%から開始）において、規定の電流を一定時間連続して印加し、長時間通電時の温度変化を評価・検証する。", "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:07:35.715462", "ref": null}, "messageOrder": [], "className": "UseCase"}
{"id": "4e0dcb40-1c8b-473f-bedf-cc3f59cfb457", "name": "テストピースにて試験を行う", "description": "電池セルまたは、電極体相当の熱マスを集電体に取り付けたテストピースにて試験を行う。", "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:07:35.719068", "ref": null}, "messageOrder": [], "className": "UseCase"}
{"id": "e2a6e41d-de6b-4ca0-aebc-8392849e904f", "name": "風防を取り付けて評価を行う", "description": "評価単セルまたはモジュールに風防を取り付けて、恒温槽の風が直接当たらないように対策をした状態で評価を実施する。", "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:07:35.723866", "ref": null}, "messageOrder": [], "className": "UseCase"}
{"id": "baa947ea-78fc-425d-a4ca-0c24554c7996", "name": "テストピース", "description": "セル試作が評価日程に間に合わない場合に、CAE解析用のデータ取得に用いられた代替試験用のピース。", "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:09:29.725618", "ref": null}, "className": "Block"}
{"id": "5c20b266-7ed3-4937-b15a-50199957acdf", "name": "モジュールベンチ", "description": "車両の冷却性能を模擬し、実機に近い冷却環境下での試験を可能にするために仕入先が構築したモジュール評価用のベンチ。", "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:09:29.725939", "ref": null}, "className": "Block"}
{"id": "7b97d660-ed6e-42d0-98da-ffce56083bcf", "name": "冷却プレート", "description": "LLCを循環させて底面を冷却するためのプレート。試験形態において3セルMODの底面に設置される。", "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:09:29.726020", "ref": null}, "className": "Block"}
{"id": "15a6210e-ae6d-4f91-a61c-0b9b7e396689", "name": "風防", "description": "セルはパックで密閉されるため、熱の籠り方をある程度模擬するために3セルMODの上に設置される防風器具。", "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:09:29.726153", "ref": null}, "className": "Block"}
