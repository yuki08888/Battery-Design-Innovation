{"id": "230e059c-3832-43fc-898a-5d4b78807a32", "name": "低温衝撃試験温度要求", "text": "低温衝撃試験の試験温度は-40℃とすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.468745", "ref": null}, "className": "Requirement"}
{"id": "b7ab4914-292c-461c-a01d-f45147d46c87", "name": "低温衝撃試験加速度要求", "text": "低温衝撃試験の加振加速度は30G（294.0m/s²）とすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.468852", "ref": null}, "className": "Requirement"}
{"id": "561961cf-f603-4817-a79b-7d50686f9376", "name": "低温衝撃試験作用時間要求", "text": "低温衝撃試験の作用時間は20msecとすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.468957", "ref": null}, "className": "Requirement"}
{"id": "f6053dc5-b0b4-49a7-86d3-a65e5f2d680e", "name": "低温衝撃試験回数要求", "text": "低温衝撃試験の回数は各方向10回とすること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.469063", "ref": null}, "className": "Requirement"}
{"id": "4482925a-16e1-4369-8818-492cac541d7c", "name": "低温衝撃試験錘質量要求", "text": "低温衝撃試験で使用する錘の質量は40gとすること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.469166", "ref": null}, "className": "Requirement"}
{"id": "1b39ea33-ed01-44b0-8949-4c49eefd590f", "name": "低温衝撃試験電池SOC要求", "text": "低温衝撃試験時の電池SOCは0%とすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.469270", "ref": null}, "className": "Requirement"}
{"id": "01d7a556-32c4-4097-8de4-f95f79f00ad4", "name": "低温衝撃試験拘束条件要求", "text": "低温衝撃試験はLi6.A/B、Li7.A/Bにおける拘束下限の拘束条件下で実施すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.469374", "ref": null}, "className": "Requirement"}
{"id": "b672944f-6319-421e-9018-efcef9090ae3", "name": "衝撃試験波形要求", "text": "衝撃試験で用いる波形はハーフサイン波に設定すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.469524", "ref": null}, "className": "Requirement"}
{"id": "300a24ad-ba81-4f45-b3e1-68fd4c8fbe1e", "name": "衝撃試験回数要求", "text": "衝撃試験の回数は、前輪と後輪での衝撃を考慮して合計10回とすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.469640", "ref": null}, "className": "Requirement"}
