{"id": "cd9a9445-01f0-4abe-88cc-f6ed4d939eb3", "name": "等価回路時定数算出", "description": "CPE1-TとR3の組み合わせによる等価回路の近似時定数(秒)を算出します。", "inputNames": ["r3", "cpe1_t"], "outputNames": ["time_constant"], "parameters": {}, "code": "# 時定数 tau = R3 * CPE1_T\ntime_constant = r3 * cpe1_t", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:37:11.517274", "ref": null}, "className": "ConstraintBlock"}
