{"id": "9289b780-c194-483b-9d51-627faf2771a4", "name": "交流インピーダンス算出制約", "description": "100Hz等の特定の周波数において、セルの100Hz抵抗とインダクタンス成分から交流インピーダンスの絶対値を算出します。", "inputNames": ["resistance_100hz", "inductance", "frequency"], "outputNames": ["impedance_magnitude"], "parameters": {}, "code": "import math\nomega = 2 * 3.141592653589793 * frequency\nreactance = omega * inductance\nimpedance_magnitude = (resistance_100hz**2 + reactance**2)**0.5", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:37:09.068706", "ref": null}, "className": "ConstraintBlock"}
