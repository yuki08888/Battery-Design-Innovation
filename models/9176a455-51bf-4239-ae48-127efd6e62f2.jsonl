{"id": "8fe47056-08ef-4a78-9bc0-f85b21cda24f", "name": "100Hzパック抵抗算出制約", "description": "パック抵抗は、セル抵抗の96倍にパック配線抵抗を加算したものとして算出される。", "inputNames": ["cell_resistance", "wiring_resistance"], "outputNames": ["pack_resistance"], "parameters": {}, "code": "pack_resistance = cell_resistance * 96 + wiring_resistance", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:35:42.199055", "ref": null}, "className": "ConstraintBlock"}
