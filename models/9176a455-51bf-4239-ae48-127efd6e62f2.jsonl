{"id": "7aff7fce-fb97-47c1-a6b3-80cece514d4c", "name": "高周波特性周波数算出", "description": "配線抵抗R1と寄生インダクタンスL1による高周波遮断周波数(Hz)の目安を算出します。", "inputNames": ["r1", "l1"], "outputNames": ["high_freq_cutoff"], "parameters": {}, "code": "# L1とR1の直列接続部分における特性周波数\n# 特性周波数 f_l1 = R1 / (2 * pi * L1)\n# pi = 3.1415926535\nhigh_freq_cutoff = r1 / (2.0 * 3.1415926535 * l1)", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:37:11.518091", "ref": null}, "className": "ConstraintBlock"}
