{"id": "d8ad6e68-61ad-4c66-9765-87c02c1aea69", "name": "インピーダンス算出制約", "description": "100Hzの抵抗として、実軸と虚軸の抵抗成分を合成したインピーダンス絶対値|Z|を算出する。 |Z| = sqrt(Z'^2 + Z''^2)", "inputNames": ["z_real", "z_imag"], "outputNames": ["z_mag"], "parameters": {}, "code": "import math\nz_mag = math.sqrt(pow(z_real, 2) + pow(z_imag, 2))", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:35:42.199662", "ref": null}, "className": "ConstraintBlock"}
