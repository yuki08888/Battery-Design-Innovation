{"id": "d54f2052-927a-440e-ac62-3d8787bb49c5", "name": "BOL拘束荷重算出制約", "description": "劣化等に伴うスタック膨張を見越し、EOL（End of Life）時点での狙い拘束荷重から、BOL（Beginning of Life）初期の必要拘束荷重を算出する（設計比率1.5倍を仮定）。", "inputNames": ["eol_force"], "outputNames": ["bol_force"], "parameters": {}, "code": "bol_force = eol_force * 1.5", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:33:51.685512", "ref": null}, "className": "ConstraintBlock"}
