{"id": "87adafcc-a7e9-40ce-8ab6-ef4942b2e978", "name": "セル幅許容範囲制約", "description": "セルの基準幅と幅公差から、許容される最小幅および最大幅を算出します。", "inputNames": ["base_width", "width_tolerance"], "outputNames": ["cell_width_min", "cell_width_max"], "parameters": {}, "code": "cell_width_min = base_width - width_tolerance\ncell_width_max = base_width + width_tolerance", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:33:51.484555", "ref": null}, "className": "ConstraintBlock"}
