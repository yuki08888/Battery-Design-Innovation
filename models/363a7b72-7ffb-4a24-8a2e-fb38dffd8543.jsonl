{"id": "81ae6db5-08b7-4d79-bd50-3d7e73c1654a", "name": "総膨化量算出制約", "description": "劣化膨化量とSOC膨化量の合計をセル総膨化量として算出します。", "inputNames": ["degradation_expansion", "soc_expansion"], "outputNames": ["total_expansion_amount"], "parameters": {}, "code": "total_expansion_amount = degradation_expansion + soc_expansion", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:33:53.216086", "ref": null}, "className": "ConstraintBlock"}
