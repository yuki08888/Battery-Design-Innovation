{"id": "bbe0908d-6070-4c74-a945-a70db5e2311f", "name": "荷重健全性評価制約", "description": "最低拘束荷重が耐荷重上限以下に収まっているかを確認します (1.0: 正常, 0.0: 異常)。", "inputNames": ["minimum_constraint_load", "max_allowable_load"], "outputNames": ["is_safe_load"], "parameters": {}, "code": "is_safe_load = 1.0 if minimum_constraint_load <= max_allowable_load else 0.0", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:33:53.221845", "ref": null}, "className": "ConstraintBlock"}
