{"id": "0dd8ee9e-c00a-4d3b-983c-894af551cf0e", "name": "封口板-外部端子高さ計算制約", "description": "封口板-外部端子間の高さ（④）は、封口板-端子板（①）、外部端子厚み（②）、端子板-外部端子隙間（③）の合計値に等しい。", "inputNames": ["plate_to_board", "terminal_thickness", "board_to_terminal_gap"], "outputNames": ["seal_to_terminal"], "parameters": {}, "code": "seal_to_terminal = plate_to_board + terminal_thickness + board_to_terminal_gap", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:30:42.863275", "ref": null}, "className": "ConstraintBlock"}
