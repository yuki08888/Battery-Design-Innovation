{"id": "031363b9-55f4-4c08-b470-1e62f96e5e18", "name": "上郷倉庫保管温度要求", "text": "上郷倉庫での保管温度は空調設備を考慮し、年平均25℃に設定すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:14:44.136286", "ref": null}, "className": "Requirement"}
{"id": "063f9157-4abc-4df1-a18c-9b883ead9e2f", "name": "海運輸送温度要求", "text": "海運による輸送時の保証温度は40℃に設定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:14:44.139892", "ref": null}, "className": "Requirement"}
{"id": "f83af0ab-be88-4809-a6fe-98586cee5450", "name": "冬季現地輸送温度要求", "text": "冬季の現地輸送時および倉庫・代理店間等の温度は、将来の空調導入を考慮し25℃に設定すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:14:44.140240", "ref": null}, "className": "Requirement"}
{"id": "518c8eeb-e0fc-4396-811b-0c478b9bb8a6", "name": "日本国内保管環境温度条件の維持", "text": "日本（豊田市）の倉庫において、最暑月平均気温31℃、年間平均気温16℃の温度環境下で補給品を保管できること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:14:44.142557", "ref": null}, "className": "Requirement"}
{"id": "127b0ae9-78dd-4340-bc01-1ec643406359", "name": "北米保管環境温度条件の維持", "text": "北米（加州 Brea）の倉庫において、最暑月平均気温31℃、年間平均気温18℃の温度環境下で補給品を保管できること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:14:44.144441", "ref": null}, "className": "Requirement"}
{"id": "f3ecadea-6c17-4a7d-b317-eb2efca79363", "name": "欧州保管環境温度条件の維持", "text": "欧州（ベルギー Diest）の倉庫において、最暑月平均気温22℃、年間平均気温11℃の温度環境下で補給品を保管できること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:14:44.147976", "ref": null}, "className": "Requirement"}
{"id": "44c1433b-7445-42e6-a264-8595c9754961", "name": "出荷容量維持要求", "text": "保管後の補給品容量が出荷下限容量（205Ah-4%）を上回ること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:14:44.150015", "ref": null}, "className": "Requirement"}
{"id": "813ebbd1-b498-417a-a242-958c736336a0", "name": "車載時自走可能要求", "text": "交換直後の補給品電池から-10℃環境下において12.9kW以上の出力を確保するため、SOC 11.2%以上を維持すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:14:44.151992", "ref": null}, "className": "Requirement"}
{"id": "f2384ad5-8eee-4e59-840c-9ced5083ef23", "name": "下限拘束荷重維持要求", "text": "保管による補給品モジュール（MDL）の拘束緩みを防ぎ、設計下限荷重（0.30kN）を上回る拘束荷重を維持すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:14:44.152335", "ref": null}, "className": "Requirement"}
{"id": "76081bf6-11f1-4433-8359-642eb1c486dc", "name": "Li析出防止要求", "text": "補給品劣化時のIwin制御の破綻を防ぐため、実容量を測定して析出制御を行うこと。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:14:44.153999", "ref": null}, "className": "Requirement"}
{"id": "86b6823b-fb96-4d7d-92e0-9185526f6034", "name": "過充電保護多重故障防止要求", "text": "部品故障、セル電圧監視故障、ブロック電圧監視故障、およびVL検知不成立の3フェール（多重故障）が発生した場合でも、過充電を防止すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:14:44.154340", "ref": null}, "className": "Requirement"}
{"id": "fd6a87e2-b187-497f-8abb-42d54af51d46", "name": "水分透過防止要求", "text": "構造信頼性確保のため、水分透過量をクライテリアである1000ppm未満に抑制すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:14:44.154973", "ref": null}, "className": "Requirement"}
{"id": "6f91cd53-f88c-47b3-8898-e1abbaded587", "name": "電解液透過防止要求", "text": "液漏れによる急激な抵抗増加を防ぐため、電解液透過量をクライテリアである40.5g未満に抑制すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:14:44.156569", "ref": null}, "className": "Requirement"}
{"id": "91b35e03-8c51-4195-aee8-aed13de011e2", "name": "補給品電池スタック/パック出荷要求", "text": "補給品電池スタック/パックは速やかに出荷すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:14:44.158118", "ref": null}, "className": "Requirement"}
{"id": "3f3868d8-7183-44c8-abc8-4236d782f0e3", "name": "部品倉庫保管温度要求", "text": "部品倉庫保管条件は、電池表面温度35℃以下、倉庫内温度41℃以下とし、乾燥した倉庫に保管すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:14:44.158656", "ref": null}, "className": "Requirement"}
