{"id": "da489a76-8ab5-4cfd-9416-104529efec40", "name": "試験温度要求", "text": "試験温度は25℃±5℃（室温）とすること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.466805", "ref": null}, "className": "Requirement"}
{"id": "787b3e41-2eae-449e-8f98-d5aa729777a8", "name": "試験加速度要求", "text": "加振加速度は98.0m/s²(10G)に設定すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.466918", "ref": null}, "className": "Requirement"}
{"id": "861c4fe7-975e-494b-87ff-47757b1c86f9", "name": "試験周波数要求", "text": "周波数は25Hz（正弦波）とすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.467024", "ref": null}, "className": "Requirement"}
{"id": "8a9b116e-b01a-4150-95db-3cbc07b5f6cc", "name": "試験回数要求", "text": "各方向1125万回の加振を行うこと。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.467129", "ref": null}, "className": "Requirement"}
{"id": "e1eb167b-8565-41b0-9832-8a1e7a4f6189", "name": "試験錘重量要求", "text": "錘は40gとすること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.467234", "ref": null}, "className": "Requirement"}
{"id": "c338ada6-5816-48ac-82bf-7ac9d848c34d", "name": "試験電池SOC要求", "text": "電池SOCは0%とすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.467341", "ref": null}, "className": "Requirement"}
{"id": "918f5d04-1d04-4f41-85d2-9334dab06a97", "name": "試験拘束条件要求", "text": "Li6.A/BおよびLi7.A/Bの拘束下限にて拘束すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.467447", "ref": null}, "className": "Requirement"}
{"id": "da91c779-2ad2-4ac6-9343-daa9079ef9b8", "name": "加振周波数設定要求", "text": "実車試験結果に基づき、加振周波数を25Hzに設定すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.467575", "ref": null}, "className": "Requirement"}
{"id": "3d1f8dc8-abce-4f97-9b3a-5349c67cf72a", "name": "加振波形選定要求", "text": "加振波形には、一定の加振加速度および周波数で振動させる正弦波形を採用すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.467684", "ref": null}, "className": "Requirement"}
{"id": "9c2324ce-8544-4ced-8528-e46318cc56e7", "name": "総振動回数設定要求", "text": "西ロシアの市場データに基づき、波状路振動回数を1125万回に設定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.467791", "ref": null}, "className": "Requirement"}
{"id": "22aa7a79-efae-4539-bd3b-4e411b907c3d", "name": "同一サンプル連続試験要求（方向別）", "text": "車両搭載時の全方向振動入力を模擬するため、各方向の試験は同一サンプルを用いて実施すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.467896", "ref": null}, "className": "Requirement"}
{"id": "b336988b-0393-4ed5-a4e2-2a4eb37c81ab", "name": "全軸方向加振要求", "text": "電池の搭載方向によらず問題がないことを確認するため、同一サンプルに対して全軸方向（X、Y、Z軸）で加振試験を実施すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.468002", "ref": null}, "className": "Requirement"}
{"id": "d5f38774-b76b-449b-a51b-064f9cb23df1", "name": "端子模擬錘重量設定要求", "text": "ボルト締結を前提とした外部端子の場合、バスバやハーネス類の重量負荷を模擬するため、端子1個に締結する錘の重量を40gとすること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.468106", "ref": null}, "className": "Requirement"}
{"id": "4e6f6851-8cc6-4431-b447-1bb53cfd415a", "name": "模擬錘形状重心整合要求", "text": "振動による外部端子の破損モードがセル単体試験とスタック試験で同一になるよう、錘の形状および重心を設定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.468211", "ref": null}, "className": "Requirement"}
{"id": "d2dc1251-b644-4887-a581-dfeb8e857998", "name": "試験時SOC設定要求", "text": "電極体保持力が下限となる最も厳しい状態を模擬するため、電池のSOCは下限SOCに設定すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.468319", "ref": null}, "className": "Requirement"}
{"id": "201b873c-177e-43bd-8935-1503fc1040b2", "name": "下限SOC設定要求", "text": "電極体保持力下限の状態でセルが振動されるときが最も厳しい試験条件であることを考慮し、下限SOCを設定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.468423", "ref": null}, "className": "Requirement"}
{"id": "1b669cce-5848-46b5-918d-30e9e2fa24e0", "name": "スタック搭載状態模擬要求", "text": "拘束形態はスタック搭載状態を模擬すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.468529", "ref": null}, "className": "Requirement"}
{"id": "c5ecc616-bd39-4512-bffa-c1e7d7e0ece3", "name": "荷重測定治具要件", "text": "試験前後で狙い荷重になっているか確認できるように、治具にロードセル、軸力ボルトなどで荷重を測定できるようにしておくこと。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.468635", "ref": null}, "className": "Requirement"}
