{"id": "4f8e7a5a-7f4c-44de-a220-0e8a417dd744", "name": "構造信頼性評価要求", "text": "製品の構造信頼性を十分に評価すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.446761", "ref": null}, "className": "Requirement"}
{"id": "5365ec87-0ce2-454d-b676-d8636f40266f", "name": "シール性能要求", "text": "構造信頼性評価において、シール機能の市場負荷に対する耐性を担保すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.447068", "ref": null}, "className": "Requirement"}
{"id": "f3746a61-903e-466d-8b2f-7612c100be9a", "name": "耐圧性能要求", "text": "構造信頼性評価において、耐圧機能の市場負荷に対する耐性を担保すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.447337", "ref": null}, "className": "Requirement"}
{"id": "bafc6c64-4513-4c8d-809e-7aa1d8bb1ccf", "name": "絶縁性能要求", "text": "構造信頼性評価において、絶縁機能の市場負荷に対する耐性を担保すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.447525", "ref": null}, "className": "Requirement"}
{"id": "8fa01377-7076-422f-93a0-f5b64252a8df", "name": "導通性能要求", "text": "構造信頼性評価において、導通機能の市場負荷に対する耐性を担保すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.447640", "ref": null}, "className": "Requirement"}
{"id": "a052162d-e386-449e-a37a-fc0035018750", "name": "密封性保持要求", "text": "ラミネートフィルム（熱溶着部）によってセル内部と外部の密封性を保持すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.447749", "ref": null}, "className": "Requirement"}
{"id": "f9296c69-11f2-41d5-8120-b554567d3972", "name": "絶縁保持要求", "text": "ラミネートフィルムおよびセパレータによってケース-電極間、正負極間の絶縁を保持すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.447852", "ref": null}, "className": "Requirement"}
{"id": "d1fa020e-1453-410e-9981-3b15341b231f", "name": "導通経路保持要求", "text": "集電端子、外部端子、および電極箔における通電経路を保持すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.447956", "ref": null}, "className": "Requirement"}
{"id": "212bd242-11c4-4105-b39f-f0a1a9f6f043", "name": "セル構造保持要求", "text": "安全弁、封缶部、およびケースにおいてセル構造を保持すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.448060", "ref": null}, "className": "Requirement"}
{"id": "b29cefb1-a3f0-457f-a06a-88ea92e8d314", "name": "シール部Heリーク要求", "text": "各試験を実施した後にHeリーク測定を行い、リーク量が1.0×10⁻⁵ Pa・m³/sec以下であること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.448162", "ref": null}, "className": "Requirement"}
{"id": "795c9cc9-8f7c-44f0-8071-6289247104ee", "name": "安全弁開弁圧要求", "text": "各試験を実施した後に破断圧測定を行い、安全弁の開弁圧が設計値範囲内（Li7,8例においては0.9MPa±0.2MPa）であること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.448268", "ref": null}, "className": "Requirement"}
{"id": "5b07d483-4009-4a5b-bfcb-535924b8e1cf", "name": "封缶部破断強度要求", "text": "各試験を実施した後に破断圧測定を行い、封缶部の破断強度が安全弁以上であること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.448600", "ref": null}, "className": "Requirement"}
{"id": "3de67ef5-9d2c-4786-8b06-a25d39221bb0", "name": "導通抵抗要求", "text": "各試験を実施した後に導通測定を行い、導通抵抗が設計値範囲内であること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.449447", "ref": null}, "className": "Requirement"}
{"id": "e51e92ba-1aed-498d-9bc2-9bce71e66ae2", "name": "導通経路亀裂無要求", "text": "各試験を実施した後に目視確認（導通経路、ヒューズ）を行い、亀裂が無いこと。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.449666", "ref": null}, "className": "Requirement"}
{"id": "6065f3ec-21c4-447b-a17a-976b4848c6b0", "name": "ケース・電極間電圧要求", "text": "各試験を実施した後にケース・電極間電圧測定を行い、ケース・電極間電圧が1.0V〜セル電圧の間であること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.450734", "ref": null}, "className": "Requirement"}
{"id": "642d215c-27c8-493a-b951-30314cba23e3", "name": "ケース・外部端子間絶縁抵抗要求", "text": "各試験を実施した後に外部端子・蓋サブ間絶縁抵抗測定を行い、ケース・外部端子間の絶縁抵抗が10MΩ以上であること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.452433", "ref": null}, "className": "Requirement"}
{"id": "e91a3d77-e49f-46a2-a512-291f3d0c6eff", "name": "外挿フィルム亀裂無要求", "text": "各試験を実施した後に目視確認を行い、外挿フィルムに亀裂が無いこと。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.453066", "ref": null}, "className": "Requirement"}
{"id": "9c691ff3-d843-435c-8a15-2ea57a44afad", "name": "熱衝撃試験評価条件要求", "text": "Li6.A/BおよびLi7.A/Bでは-40℃（5分以上）⇔65℃（5分以上）を3000サイクル、Li9.Aでは-40℃（5分以上）⇔45℃（5分以上）を3500サイクルとし、電池SOCは100%かつパック搭載状態を模擬したセンター値相当の荷重で拘束して試験を行うこと。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.454749", "ref": null}, "className": "Requirement"}
{"id": "6604b3b4-0564-4652-9e65-e754a21f242f", "name": "熱衝撃試験昇降温速度要求", "text": "熱衝撃試験における昇温および降温速度は50℃/h以上とすること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.456767", "ref": null}, "className": "Requirement"}
{"id": "7f7b834e-47fe-4438-8a69-6312939f8592", "name": "熱衝撃試験温度保持要求", "text": "試験サンプル温度が温度上限値または下限値に達するまで温度を保持すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.458769", "ref": null}, "className": "Requirement"}
{"id": "f91222f1-b6e6-4bb0-9fa9-06d961b5fbb1", "name": "温度測定箇所特定要求", "text": "熱衝撃試験におけるサンプル温度は、シール部の温度として代替ができる外部端子等の箇所で測定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.460806", "ref": null}, "className": "Requirement"}
{"id": "ec1c5f90-713c-4b7d-a97e-69f69844c896", "name": "熱衝撃試験装置選定要求", "text": "熱衝撃試験を行う際は、市場の挙動を模擬するため気槽の試験装置を使用すること。液槽を使用する場合は結果に対して注意深く評価を行うこと。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.461895", "ref": null}, "className": "Requirement"}
{"id": "76b3fcfe-ec5d-42eb-896d-d1800ef7689f", "name": "設計拘束荷重下限値設定要求", "text": "拘束荷重下限(電極体保持力下限)の状態でセルが振動されるときを考慮し、設計拘束荷重下限値を設定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.469747", "ref": null}, "className": "Requirement"}
{"id": "98b0e650-6b4d-45f1-b8fb-765ce2d77888", "name": "複合試験I要求", "text": "複合試験Iでは、高温保存、低温保存（非必須）、温湿度サイクルの順で試験を実施し、樹脂のへたり、低温収縮による隙間への水分侵入および氷結ダメージに対する耐性を評価すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.469852", "ref": null}, "className": "Requirement"}
{"id": "664ea574-12ee-42e2-a7be-a3b4a2559235", "name": "複合試験II要求", "text": "複合試験IIでは、熱衝撃試験の後に振動試験を実施し、温度変化の繰り返しによる疲労と振動による機械的な疲労という2つの疲労ダメージに対する耐性を評価すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.469962", "ref": null}, "className": "Requirement"}
{"id": "d6c18f39-3b3d-480c-9935-cbacc742bdce", "name": "Li6.A・Li6.B・Li7.A・Li7.B熱衝撃試験要求", "text": "SOC100%かつ拘束Cen.にて、-40℃から65℃の熱衝撃試験を3000サイクル実施すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.470067", "ref": null}, "className": "Requirement"}
{"id": "37611f6b-9a9f-46b8-ac17-91f5cca82c0a", "name": "Li9.A熱衝撃試験要求", "text": "SOC100%にて、-40℃から45℃の熱衝撃試験を3500サイクル実施すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.470173", "ref": null}, "className": "Requirement"}
{"id": "cda7f672-2c76-4790-9374-2b4d9917961b", "name": "Li6.A・Li6.B高温保存試験要求", "text": "SOC100%かつ拘束Cen.にて、75℃での高温保存試験を850時間実施すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.470279", "ref": null}, "className": "Requirement"}
{"id": "ac7c17d4-346e-4360-a852-4ed7a92f7d75", "name": "Li7.A・Li7.B高温保存試験要求", "text": "SOC100%かつ拘束Cen.にて、70℃での高温保存試験を1000時間実施すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.470384", "ref": null}, "className": "Requirement"}
{"id": "3b9eb1ce-e4aa-4444-bd43-59c8b3646855", "name": "Li6・Li7高温高湿試験要求", "text": "SOC100%かつ拘束Cen.にて、60℃、95%RHの環境下で2000時間の高温高湿試験を実施すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.470502", "ref": null}, "className": "Requirement"}
{"id": "f8e69ddf-0d81-494a-99a6-37f36aadc316", "name": "Li6・Li7温湿度サイクル試験要求", "text": "SOC100%かつ拘束Cen.にて、(1) 65℃×15.5h、(2) -40℃×7.5h、(3) 65℃95%RH×15.5h、(4) -40℃×15.5h の温湿度サイクルを10サイクル実施すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.470622", "ref": null}, "className": "Requirement"}
{"id": "33a62128-9044-4b06-a69a-9684e811c9a0", "name": "Li6・Li7振動試験要求", "text": "SOC0%かつ拘束下限にて、25℃環境下で、98.1m/s²/25Hzの加振条件により、X/Y/Zの各方向に1125万回の振動試験を実施すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.470726", "ref": null}, "className": "Requirement"}
{"id": "e00d6220-3604-4338-bd10-f04d6e10c499", "name": "Li6・Li7低温衝撃試験要求", "text": "SOC0%かつ-40℃、拘束下限において、加振条件294.3m/s²、0.02秒にて、X/Y/Zの各方向に10回の低温衝撃試験を実施すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.470831", "ref": null}, "className": "Requirement"}
{"id": "2869e569-1dac-4582-8b97-ebb28641c037", "name": "Li6.A・Li6.B複合試験1要求", "text": "拘束Cen.にて、(1)高温保存、(2)低温保存、(3)温湿度サイクルの順に複合試験1を実施すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.470936", "ref": null}, "className": "Requirement"}
{"id": "0c9f3c3a-40cc-46ed-9b30-92125ec3e689", "name": "Li7.A・Li7.B複合試験1要求", "text": "拘束Cen.にて、(1)高温保存、(2)温湿度サイクルの順に複合試験1を実施すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.471048", "ref": null}, "className": "Requirement"}
{"id": "3789cd01-90ad-4de7-ad36-96676919f4ec", "name": "Li6・Li7複合試験2要求", "text": "拘束下限にて、(1)熱衝撃、(2)振動の順に複合試験2を実施すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.471156", "ref": null}, "className": "Requirement"}
{"id": "8bb9967d-8a01-4b3f-86b8-2ff43a747e83", "name": "熱負荷によるシール強度確保要求", "text": "ラミネート型セルの耐圧評価(55℃×180日)において、EOL(End of Life)までの熱負荷でシール部が破損しないこと。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.471274", "ref": null}, "className": "Requirement"}
{"id": "e5195383-954b-4f7f-a08d-3d710a2b468e", "name": "温度変化によるラミネートフィルム破断防止要求", "text": "応力解析等により、低温時に発生する引っ張り方向のひずみが、ラミネートフィルムの破断につながらないことを確認すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.471379", "ref": null}, "className": "Requirement"}
{"id": "255f3c21-1107-4ea7-b517-7ddcddebe068", "name": "熱衝撃試験温度範囲要求", "text": "熱衝撃試験の温度範囲は-40℃⇔45℃とすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.471485", "ref": null}, "className": "Requirement"}
{"id": "d3a54d23-e33a-40dd-80af-08b6b187d0ea", "name": "熱衝撃試験サイクル数要求", "text": "熱衝撃試験のサイクル数は3500サイクルとすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:20:24.471590", "ref": null}, "className": "Requirement"}
