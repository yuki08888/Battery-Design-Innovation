{"id": "cbc02e67-1855-49c8-b040-66c819e0d386", "name": "CTR-RV-001 排煙バルブ開弁圧力制限", "text": "排煙バルブは熱拡散発生圧力より低い圧力で開弁すること。", "description": "排煙バルブは熱拡散発生圧力より低い圧力で開弁すること。", "stereotypes": [], "risk": null, "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:38:24.384540", "ref": null}, "className": "Requirement"}
{"id": "11fdc424-cd60-49be-a888-b8c5fabaaec4", "name": "CTR-RV-002 単セル発生ガス開弁圧力設定", "text": "排煙バルブは単セル発生ガス流量およびパック余剰体積から決まる圧力で開弁すること。", "description": "排煙バルブは単セル発生ガス流量およびパック余剰体積から決まる圧力で開弁すること。", "stereotypes": [], "risk": null, "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:38:24.388457", "ref": null}, "className": "Requirement"}
{"id": "430eca7c-c6b7-4d6a-b1a9-f763d3af67d3", "name": "CTR-RV-003 酸素逆流防止構造", "text": "排煙バルブは外部からパック内への酸素逆流を防止すること。", "description": "排煙バルブは外部からパック内への酸素逆流を防止すること。", "stereotypes": [], "risk": null, "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:38:24.389696", "ref": null}, "className": "Requirement"}
{"id": "3400a8d7-5970-414d-a4df-03958c2f0018", "name": "CTR-RV-004 排煙バルブ・呼吸膜同一方向配置", "text": "排煙バルブは呼吸膜と同一方向に配置すること。", "description": "排煙バルブは呼吸膜と同一方向に配置すること。", "stereotypes": [], "risk": null, "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:38:24.391259", "ref": null}, "className": "Requirement"}
{"id": "4512ed7a-ca69-4fb8-abbc-da3265b5d921", "name": "CTR-RV-006 筐体耐圧以下開弁制御", "text": "排煙バルブはシール部、アッパーケース、ロアケースの耐圧以下で解放すること。", "description": "排煙バルブはシール部、アッパーケース、ロアケースの耐圧以下で解放すること。", "stereotypes": [], "risk": null, "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:38:24.394157", "ref": null}, "className": "Requirement"}
{"id": "e751b1a0-c029-42cd-b1b3-c54536b1086c", "name": "CTR-RV-007 規定圧力確実開放機能", "text": "排煙バルブは規定圧力以上で確実に開放できること。", "description": "排煙バルブは規定圧力以上で確実に開放できること。", "stereotypes": [], "risk": null, "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:38:24.395468", "ref": null}, "className": "Requirement"}
{"id": "2c2faef9-0cfb-44eb-a026-b99a8684666d", "name": "CTR-RV-008 セルガス耐熱配置", "text": "排煙バルブはセルガス温度に耐えられる位置へ配置すること。", "description": "排煙バルブはセルガス温度に耐えられる位置へ配置すること。", "stereotypes": [], "risk": null, "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:38:24.396729", "ref": null}, "className": "Requirement"}
{"id": "3419387d-fc62-45c1-a921-4a2c0d2dd401", "name": "CTR-RV-009 排煙バルブ耐熱温度仕様", "text": "排煙バルブの耐熱温度は排煙ガス温度以上とすること。", "description": "排煙バルブの耐熱温度は排煙ガス温度以上とすること。", "stereotypes": [], "risk": null, "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:38:24.398006", "ref": null}, "className": "Requirement"}
{"id": "2d570620-a9f6-4f4b-a69b-d132ba40ebda", "name": "CTR-RV-010 パック内圧力上昇抑制機能", "text": "排煙バルブは排煙ガス量の増大によるパック内圧力上昇を抑制できること。", "description": "排煙バルブは排煙ガスの増大によるパック内圧力を構造耐圧規定値以下に抑制すること。", "stereotypes": [], "risk": null, "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:38:24.399551", "ref": null}, "className": "Requirement"}
