{"id": "0eb2345b-a664-48be-9976-d0f90c834a4e", "name": "CCCV満充電容量および劣化係数要求", "text": "Li7.Aセルの経過年数（0〜25年）におけるCCCV満充電容量およびCCCV満充電容量劣化係数の推定結果を提示すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.453286", "ref": null}, "className": "Requirement"}
{"id": "0d5fc943-2686-499d-8740-63a11a8fabce", "name": "スタック内容量バラツキ要求", "text": "スタック内の容量バラツキを明確にすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.453849", "ref": null}, "className": "Requirement"}
{"id": "987781ba-04df-4763-9f12-252198b4a9e1", "name": "抵抗劣化係数要求", "text": "抵抗劣化係数を算出すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.453993", "ref": null}, "className": "Requirement"}
{"id": "1abc8976-a33f-4ab0-b3f6-54994d5e4f2d", "name": "スタック内抵抗劣化バラツキ要求", "text": "スタック内の抵抗劣化バラツキを定義すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.454114", "ref": null}, "className": "Requirement"}
{"id": "5418c294-e490-44d5-9995-4845c99fe7a1", "name": "市場情報用満充電容量推定要求", "text": "市場情報を用いた満充電容量の推定を行うこと。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.454246", "ref": null}, "className": "Requirement"}
{"id": "4d622ac3-b3a2-4b75-9b5a-cbed493a6e39", "name": "北米認証輸送時の容量劣化量算出要求", "text": "北米で認証を受ける際の「セル完」から「認証試験」までの期間でのセル容量劣化量を算出し、結果をAESへフィードバックすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.454668", "ref": null}, "className": "Requirement"}
{"id": "96d4fa65-f5be-4640-89e6-1d892c976a16", "name": "開発目標達成要求", "text": "定義された開発目標を達成すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.454862", "ref": null}, "className": "Requirement"}
{"id": "3931a019-b2b0-44ad-88b5-d04c0602bf63", "type": "containment", "sourceId": "eb42363b-db5c-4f65-b8c5-d1a6565c4321", "targetId": "96d4fa65-f5be-4640-89e6-1d892c976a16", "name": null, "description": null, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.454921", "ref": null}, "connectorType": null, "flowType": null, "guard": null, "edgeType": null, "sequenceOrder": null, "className": "Relationship"}
{"id": "2ca5dd9f-77ca-4042-9d4c-55e5529a2b58", "name": "保証要件適合要求", "text": "保証期間の設定や品質実力、競合状況に基づき、保証要件を満たすこと。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.454997", "ref": null}, "className": "Requirement"}
{"id": "3fec501f-53ac-454d-99be-cce359e78247", "type": "containment", "sourceId": "eb42363b-db5c-4f65-b8c5-d1a6565c4321", "targetId": "2ca5dd9f-77ca-4042-9d4c-55e5529a2b58", "name": null, "description": null, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.455054", "ref": null}, "connectorType": null, "flowType": null, "guard": null, "edgeType": null, "sequenceOrder": null, "className": "Relationship"}
{"id": "e396fb4a-711a-4613-8516-38f6c30a7dc8", "name": "要求性能達成要求", "text": "市場における車両の使われ方を考慮したうえで寿命推定（容量維持率・抵抗増加率）を行い、要求性能の達成可否を判断すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.455122", "ref": null}, "className": "Requirement"}
{"id": "7b9f4a1f-45c1-411d-8e57-708373fabec5", "name": "寿命計算精度確保要求", "text": "加州の都市（ロサンゼルス、サンフランシスコ、計2通り）における走行区分（14通り）とI2頻度（3通り）の計84通りについて、マイナー則に基づき劣化を足し合わせて劣化後性能を推定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.455239", "ref": null}, "className": "Requirement"}
{"id": "e7144349-ef0b-4709-b21a-9da3373df30b", "name": "寿命計算パラメータ定義要求", "text": "寿命計算に使用するパラメータのうち、ΔSOCに合わせた通電量と時間を実走行パターン（LA#4、HWY、US06の3パターン）から定義すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.455355", "ref": null}, "className": "Requirement"}
{"id": "21e6daf9-6eaa-4f85-968d-e6290b1db985", "name": "非常用在庫時の制限下限SOC要求", "text": "非常用在庫において、車両組立前から検査時の自己放電分を除いた容量分(0.725Ah)を担保するため、制限下限SOCを11.9%以上とすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.455479", "ref": null}, "className": "Requirement"}
{"id": "300f7709-1f81-418f-8c41-4462a50c2990", "name": "車両組立・検査時の制限下限SOC要求", "text": "車両組立・検査において、制限下限SOCを10.0%とし、車両状態での初回ON時に下限SOCを切らない（P-chargeを防止する）こと。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.455602", "ref": null}, "className": "Requirement"}
{"id": "5bc562d9-cfc3-40a1-9c61-793a3ae8e469", "name": "輸送ヤード保管時の制限下限SOC要求", "text": "船降ろし後のヤード保管において、制限下限SOC（19PL AS値 10.0%）に補機バッテリ汲み出し分（295.3Whを保証するSOC 2.0%）を加えた12.0%以上を確保すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.455718", "ref": null}, "className": "Requirement"}
{"id": "a56c4302-f2cb-4992-8c78-15ef1b146070", "name": "補機バッテリ汲み出し時の制限下限SOC要求", "text": "補機バッテリ汲み出しにおいて、下限SOCを切ると汲み出しが終了するため、制限下限SOCを10.0%以上とすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.455836", "ref": null}, "className": "Requirement"}
{"id": "6dff36e5-8a76-4b4b-8a98-cb599317b061", "name": "ディーラー在庫時の極低温エンジン始動SOC要求", "text": "ディーラー在庫（最長713日の保証前期間）において、極低温エンジン始動可能電力（19PL AS値 5.47kW）を確保するためのSOC 2.7%以上を維持すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.455953", "ref": null}, "className": "Requirement"}
{"id": "b2273dfe-76f0-43c1-b935-3728c475a799", "name": "27PL寿命計算セル前提要求", "text": "寿命計算において、セルはLi7.A（CCCV容量維持率）を用い、初期ばらつき±4%、保存劣化ばらつき1.2倍、通電劣化ばらつき1.4倍とすること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.456079", "ref": null}, "className": "Requirement"}
{"id": "53dbd91e-a613-4a84-803e-4ae29497fa5c", "name": "27PL寿命計算地域前提要求", "text": "寿命計算における地域前提は、Typ.を北米加州（ロサンゼルス：サンフランシスコ＝6：4）、最悪地域を北米加州（ライアン）とすること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.456195", "ref": null}, "className": "Requirement"}
{"id": "82924ecd-b7aa-4675-a1e7-224930b977dc", "name": "27PL寿命計算期間・距離要求", "text": "寿命計算の計算年数および距離は、25年または60万km（安全率1.2倍適用時は30年または72万km）とすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.456313", "ref": null}, "className": "Requirement"}
{"id": "8b3a9f7e-1273-437e-8269-46b4d6bb86ef", "name": "27PL保証前期間前提要求", "text": "保証前期間の前提として、セル出荷検査からディーラー在庫までの生産日数、保管期間、輸送、ヤード放置、補給品を考慮した累計期間を440日とすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.456453", "ref": null}, "className": "Requirement"}
{"id": "b0de74e7-43d8-4db6-bf6d-84ed6ae9c50e", "name": "スタック内セル間電圧差異常検出要求", "text": "スタック内のセル間電圧差異常を検出する制御(bdeltav_pre_ng_map0)に使用されるパラメータを決定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.456577", "ref": null}, "className": "Requirement"}
{"id": "08d21af9-fd54-4867-8570-a09e309e6f9c", "name": "温度ばらつき算出要求", "text": "Li6.A/Li7.Aはスタック内の温度ばらつきを「センター」と「センター-5℃」で算出すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.456755", "ref": null}, "className": "Requirement"}
{"id": "bb1eaecf-26e6-4ea9-8e90-3989bc5d00a3", "name": "スタック内温度ばらつき要求", "text": "スタック内温度ばらつきは、マージンを含めて差分5℃と設定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.456885", "ref": null}, "className": "Requirement"}
{"id": "f2d757ae-fa96-42f3-8dbd-5954222644d7", "name": "保存劣化係数の記入要求", "text": "保存劣化係数γについて、SOC毎に各温度の劣化係数を記入すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.457006", "ref": null}, "className": "Requirement"}
{"id": "23cd153e-408f-4a8e-8035-9371c2f23699", "name": "通電劣化係数の記入要求", "text": "通電劣化係数γについて、保存劣化分を差し引いた通電劣化分における各温度の劣化係数を記入すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.457137", "ref": null}, "className": "Requirement"}
{"id": "930e14a5-6515-4af4-8dd5-33776a8e6db4", "name": "電池容量維持率目標（10年または15万マイル）", "text": "容量維持率（航続距離）90%を、10年または15万マイル、かつ典型的な(typ.)地域で達成すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.457257", "ref": null}, "className": "Requirement"}
{"id": "69011f58-fca0-4fd8-98cd-aca799cbe48a", "name": "新車保証期間・条件の競合同等要求", "text": "新車保証期間・条件は、競合他社の平均レベル（デファクトスタンダードである8年16万km）と同等とすること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.457379", "ref": null}, "className": "Requirement"}
{"id": "6e6accfe-b2c2-4a49-b706-64def295da33", "name": "各国法規適合要求", "text": "消費者保護法、排ガス関連法規、中国三包法規などの各国の法規に適合すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.457498", "ref": null}, "className": "Requirement"}
{"id": "758872e5-4666-4e0f-9f83-e7b72f3d1e83", "name": "サービス容量測定精度向上要求", "text": "サービス（販売店）での容量測定精度を向上させること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.457922", "ref": null}, "className": "Requirement"}
{"id": "ddbd7c3c-bee2-4dff-813f-ac3d427aa9f1", "name": "8年16万km70%容量保証要求", "text": "バッテリーの容量保証条件は、8年16万km走行後に容量維持率70%以上とすること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.458132", "ref": null}, "className": "Requirement"}
{"id": "53ed7bac-96a3-436d-9831-f39240447538", "name": "10年24万km70%容量保証要求", "text": "バッテリーの容量保証条件を10年24万km走行後に設定する場合は、容量維持率70%以上とすること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.458271", "ref": null}, "className": "Requirement"}
{"id": "f979a80e-3f6b-4c3c-bff1-8cf337ebd022", "name": "BEV機能保証期間要求", "text": "BEV(27PL)の機能保証期間は8年16万kmに設定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.458645", "ref": null}, "className": "Requirement"}
{"id": "c709b29d-4af7-4c14-860f-e5e5c215c6f2", "name": "BEV容量保証期間要求", "text": "BEV(27PL)の容量保証期間および保証値は8年16万km・70%に設定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.458817", "ref": null}, "className": "Requirement"}
{"id": "b2c404bc-6735-4357-b536-0912b3d12b7a", "name": "寿命推定精度向上要求", "text": "寿命推定の精度を向上させるため、従来寿命推定におけるAh/kmばらつきとI^2ばらつきの重複計算（ばらつきの二重取り）を解消すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.459061", "ref": null}, "className": "Requirement"}
{"id": "66f06f4e-b436-45ac-a2f1-dc8a7975ca49", "name": "I2頻度分布表現要求", "text": "I^2頻度分布を、LA#4、HWY、US06のI^2による3分割（耐久パターン／走行パターンでの分割）で表現すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.459206", "ref": null}, "className": "Requirement"}
{"id": "173a2f68-b590-4378-8e4b-c88631a2c468", "name": "EV走行別劣化係数算出要求", "text": "Ah/kmのばらつきを廃止し、EV走行（LA#4、HWY、US06）毎に劣化係数を算出すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.459346", "ref": null}, "className": "Requirement"}
{"id": "1b14544c-5250-45d6-9e60-6463a137623b", "name": "市場全般表現要求", "text": "計算した劣化係数に対し、市場におけるEV走行のI^2比率を掛け合わせることで、市場全般の劣化率を表現できるようにすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:26:58.459470", "ref": null}, "className": "Requirement"}
