{"id": "dc945c6c-0f92-40d0-976e-1657e7fec5da", "name": "要求", "description": "要求要素", "isReferenceModel": false, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:03:18.428524", "ref": null}, "className": "Package"}
{"id": "4f442b8a-1bef-4da0-a96e-5112a4f1a972", "name": "極低温時仕様要求", "text": "極低温状態（電解液の凍結が懸念される環境など）において、電池システムの起動可否を安全に評価し、適切な情報表示（メータへの表示等）および電池制御（READY-ON待ち等の制御）を行うこと。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:03:55.818929", "ref": null}, "className": "Requirement"}
{"id": "e60ae5f1-e371-42d5-8696-99388df1ca85", "type": "containment", "sourceId": "dc945c6c-0f92-40d0-976e-1657e7fec5da", "targetId": "4f442b8a-1bef-4da0-a96e-5112a4f1a972", "name": null, "description": null, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:03:55.819293", "ref": null}, "connectorType": null, "flowType": null, "guard": null, "edgeType": null, "sequenceOrder": null, "className": "Relationship"}
{"id": "c52c7504-3243-4307-a106-089f6ebc185e", "name": "上限電池温度保護閾値（劣化限界）設定要求", "text": "電池セルを任意温度、作動保証電圧範囲環境下で保存耐久試験を実施し、異常劣化せず性能劣化速度がアレニウス則に従う上限温度として、上限電池保護閾値を60℃に設定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:03:55.820551", "ref": null}, "className": "Requirement"}
{"id": "31a7c0b7-9f7d-4cfe-b3d2-3363f79f474c", "name": "上限電池温度保護閾値（発煙限界）設定要求", "text": "電池内部でLi金属が析出している場合を考慮し、電池内部温度が充放電停止で制御可能な上限値（セル内部上限温度110℃）未満となるよう、車両保護温度閾値 110℃におけるLi析出許容量を設定すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:03:55.821143", "ref": null}, "className": "Requirement"}
{"id": "0e58abb6-7a33-44df-89c9-f812e7594ec3", "name": "Li析出許容量設定要求", "text": "Li析出許容量を4.5%に設定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:03:55.822522", "ref": null}, "className": "Requirement"}
{"id": "02913f7f-51c9-4812-b28e-658149c53fbd", "name": "極低温起動禁止制御値設定要求", "text": "電池機能限界温度下限(-35℃)に対して、温度センサ誤差やサーミスタ測温値と最低温度差などの温度公差を考慮し、制御値-33℃でREADY-ON待ち要求(SMR ON禁止)を取り下げる制御を実施すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:03:55.824861", "ref": null}, "className": "Requirement"}
{"id": "7de62fb7-c29e-4c6d-bf14-7b273d101351", "name": "極低温時電池評価要求", "text": "極低温下における電解液の凍結状態および極低温履歴による電池抵抗の評価、ならびに電池構成部材の物性変化の確認を行うこと。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:03:55.825108", "ref": null}, "className": "Requirement"}
{"id": "aafd6bbf-6789-4df7-848e-bf9314d82194", "name": "電解液分離凍結・膨張防止要求", "text": "任意温度に電解液を放置し、放置後の電解液の観察で分離凍結なく、凍結時に電解液膨張なきこと。ただし、使用する電解液は経年使用による電解質塩濃度および溶媒組成変化等を考慮すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:03:55.825467", "ref": null}, "className": "Requirement"}
{"id": "85894579-edeb-48b8-b26f-7f8448a8cf4e", "name": "極低温履歴起因物性変化防止要求", "text": "任意温度に電池構成部材を放置し、放置後の電池構成部材物性変化有無を確認し、極低温履歴に起因する物性変化なきこと。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:03:55.826652", "ref": null}, "className": "Requirement"}
{"id": "db4d9426-e0d0-4315-9370-cf5c7a89831c", "name": "作動保証温度要求", "text": "電池システムの容量維持率が加州-3σ_72%@25年である場合においても、作動保証温度-33℃を満足すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:03:55.826878", "ref": null}, "className": "Requirement"}
