{"id": "34f54d34-a773-433c-949c-3f45d860e6e1", "name": "極間起因によるLi析出要因解析要求", "text": "電極捲回体の中央部における極間距離の増加（拘束緩みやガス溜まり）に起因するLi析出要因を解析すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:08:47.475963", "ref": null}, "className": "Requirement"}
{"id": "0db76717-acb8-49bb-8589-b60338a12d7b", "name": "負極高抵抗起因によるLi析出要因解析要求", "text": "電極中央部の高抵抗被膜や局所的な抵抗成分の存在など、負極高抵抗に起因するLi析出要因を解析すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:08:47.476132", "ref": null}, "className": "Requirement"}
{"id": "61728bb2-bcbc-41ff-919a-672a041249b6", "name": "電極中央部への水分・ガス溜まり抑制要求", "text": "電極端部から電極中央部への距離が長い電池において、液浸透時に電極中央部へ水分が集まることを抑制し、極間でのガス溜まりの発生を防ぐこと。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:08:47.476275", "ref": null}, "className": "Requirement"}
{"id": "282e83b5-1121-4146-af6f-b6d9ad35ca83", "name": "負極良質被膜形成要求", "text": "水の分解によるガス溜まりの発生を防止し、負極表面における良質な被膜形成の阻害を防ぐこと。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:08:47.476497", "ref": null}, "className": "Requirement"}
{"id": "6fd5a22c-d999-4595-acfb-e78383a261eb", "name": "負極高抵抗被膜・金属溶出抑制要求", "text": "充電および高温環境下における中央部分解反応の加速を抑制し、負極表面での高抵抗被膜の生成および正極からの金属溶出・負極への堆積（黒色点の発生）を防ぐこと。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:08:47.477174", "ref": null}, "className": "Requirement"}
{"id": "94908d40-f562-447f-bb0d-684bf36b5822", "name": "接着セパレータによる電極うねり防止要求", "text": "電極/セパレータ間をセパレータのPVDFで接着させることで、電極うねりの発生を防止すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:08:47.478050", "ref": null}, "className": "Requirement"}
{"id": "ddabfe84-2d10-46ed-9596-2deec22fa3a5", "name": "保存劣化品・急速充電サイクル劣化後の極間距離およびガス排出機能要求", "text": "保存中におけるガス発生時にガスを群外に排出させ、極間距離の拡大を抑制すること、また、通電サイクルにおいて充放電に伴い動的に電極合材を膨潤収縮させることで残留ガスを群外に排出し、急速充電サイクル等の実行時にもLi析出が発生しないようにすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:08:47.478355", "ref": null}, "className": "Requirement"}
{"id": "e682a10b-1810-494f-80e2-6a5e4ccfae24", "name": "実市場環境における評価要求", "text": "劣化後電池の評価において、単一の保存劣化のみならず、実市場の稼働実態を考慮した通電サイクルを織り交ぜて評価すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:08:47.480993", "ref": null}, "className": "Requirement"}
