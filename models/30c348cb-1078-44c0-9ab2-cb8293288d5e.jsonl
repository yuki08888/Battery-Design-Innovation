{"id": "704b0afe-3ae5-4a89-9630-d8dcf8660fa0", "name": "劣化後電池の評価方法確立要求", "text": "劣化後電池の評価方法（Li析出評価方法等）を確立すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:08:47.475750", "ref": null}, "className": "Requirement"}
