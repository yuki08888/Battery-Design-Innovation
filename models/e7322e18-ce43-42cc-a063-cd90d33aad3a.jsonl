{"id": "b2ca1b78-a9be-427b-9953-6dc8563b8d3a", "name": "劣化拡散抵抗算出制約", "description": "初期品の拡散抵抗に劣化係数を乗じて劣化後の拡散抵抗を算出する計算式", "inputNames": ["initial_diffusion_resistance", "degradation_coefficient"], "outputNames": ["degraded_diffusion_resistance"], "parameters": {}, "code": "degraded_diffusion_resistance = initial_diffusion_resistance * degradation_coefficient", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:32:22.800863", "ref": null}, "className": "ConstraintBlock"}
