{"id": "66c5be18-9f61-41e4-b704-b28266606008", "name": "総配線抵抗算出制約", "description": "パック全体の配線抵抗（Ω）は、1セルあたりのパック配線抵抗（mΩ）をΩ単位に変換し、構成セル数を掛け合わせることで算出されます。", "inputNames": ["wire_resistance_m_ohm", "cell_count"], "outputNames": ["total_resistance_ohm"], "parameters": {}, "code": "total_resistance_ohm = (wire_resistance_m_ohm / 1000.0) * cell_count", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:34:28.745818", "ref": null}, "className": "ConstraintBlock"}
