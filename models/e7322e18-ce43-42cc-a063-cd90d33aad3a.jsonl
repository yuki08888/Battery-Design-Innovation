{"id": "7025cc55-fe19-47e7-bcf9-e112ec08050b", "name": "制御誤差込みLi析出保護電圧制約", "description": "制御誤差込みのLi析出保護電圧は、電池生値（安全率込）のLi析出保護電圧に、配線抵抗、制御誤差、およびSOC誤差を加算して算出される。", "inputNames": ["base_protection_voltage", "wiring_resistance_loss", "control_error", "soc_error"], "outputNames": ["li_deposition_protection_voltage_with_error"], "parameters": {}, "code": "li_deposition_protection_voltage_with_error = base_protection_voltage + wiring_resistance_loss + control_error + soc_error", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:32:22.802722", "ref": null}, "className": "ConstraintBlock"}
