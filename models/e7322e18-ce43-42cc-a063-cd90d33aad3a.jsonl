{"id": "c99c1ef1-cd3c-4157-9dd9-202bbc9e6f1c", "name": "単セル配線抵抗換算制約", "description": "パックの配線抵抗分を単セル当たりに換算するための計算式", "inputNames": ["total_wiring_resistance", "cell_count"], "outputNames": ["single_cell_wiring_resistance"], "parameters": {}, "code": "single_cell_wiring_resistance = total_wiring_resistance / cell_count", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:32:22.800458", "ref": null}, "className": "ConstraintBlock"}
