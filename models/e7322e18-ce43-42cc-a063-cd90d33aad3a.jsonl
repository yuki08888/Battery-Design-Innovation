{"id": "3901d24d-7fb7-43f7-aacf-9a7087bc6792", "name": "抵抗閾値反映制約", "description": "拡散抵抗マップに対して、抵抗倍率（抵抗閾値）を拡散抵抗に加味する。", "inputNames": ["base_diffusion_resistance", "resistance_multiplier"], "outputNames": ["diffusion_resistance_with_margin"], "parameters": {}, "code": "diffusion_resistance_with_margin = base_diffusion_resistance * resistance_multiplier", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:32:22.800196", "ref": null}, "className": "ConstraintBlock"}
