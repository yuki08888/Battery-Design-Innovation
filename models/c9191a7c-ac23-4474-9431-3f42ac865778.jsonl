{"id": "c9191a7c-ac23-4474-9431-3f42ac865778", "name": "要求", "description": "要求要素", "isReferenceModel": false, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:17:06.706937", "ref": null}, "className": "Package"}
{"id": "51344975-1f22-4a3b-b53c-e9d7dcceb769", "name": "製造時電解液量設計要求", "text": "製造段階でEOLまで必要な電解液量を添加すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:17:54.778227", "ref": null}, "className": "Requirement"}
{"id": "7667ebe3-df25-47d3-9752-f3ef534c0a72", "type": "containment", "sourceId": "c9191a7c-ac23-4474-9431-3f42ac865778", "targetId": "51344975-1f22-4a3b-b53c-e9d7dcceb769", "name": null, "description": null, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:17:54.778871", "ref": null}, "connectorType": null, "flowType": null, "guard": null, "edgeType": null, "sequenceOrder": null, "className": "Relationship"}
{"id": "72a8e1a0-16c5-49c3-9b60-3d6e61d94780", "name": "電解液充足要求", "text": "常に各構成部材の空隙に電解液が、EOLまで浸透・存在していること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:17:54.779412", "ref": null}, "className": "Requirement"}
{"id": "bd1bf272-64df-4131-be6a-bd4c1a696555", "name": "電解液充填要求", "text": "電極（正極・負極）およびセパレータの空隙に対して、正極-負極間でリチウムイオンが移動できるよう、空隙を十分に満たす電解液量を確保すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:17:54.780884", "ref": null}, "className": "Requirement"}
{"id": "d14949df-5e2c-41a6-a136-51473881e39a", "name": "電極体材料空隙量算出要求", "text": "部材体積（材料使用量×真密度）を空孔込の材料体積（材料厚み×面積）から減算することによって材料空隙量を求めること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:17:54.782237", "ref": null}, "className": "Requirement"}
{"id": "08852196-06c7-4498-9dd4-96c267ad82c5", "name": "電極体膨張割り分け算出要求", "text": "活性化前の電極体状態から活性化-出荷状態後に膨張した電極膨張をすべて負極に割り分けて、活性化前後での電極体の膨張および空隙の増加量を算出すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:17:54.783308", "ref": null}, "className": "Requirement"}
{"id": "20a1494d-5d27-4768-abd0-fac4bfc3aaab", "name": "活性化後負極空隙量算出要求", "text": "活性化後出荷状態の負極空隙量は、活性化前空隙に電極膨張による空隙増分を加算して算出すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:17:54.784895", "ref": null}, "className": "Requirement"}
{"id": "d5ddf99c-3ff0-4bf8-ac4a-4443b17d0fbb", "name": "必要電解液量算出要求", "text": "活性化出荷状態後の正極、負極、およびセパレータの各空隙量の合計値に電解液の比重を乗じて、必要電解液量を算出すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:17:54.786226", "ref": null}, "className": "Requirement"}
{"id": "9ec0b8bf-085b-459a-aed7-844293f38be8", "name": "液消費速度算出要求", "text": "液量違いセルのサイクル試験結果、または電極空隙量とBOL必要量の推定値を用いて液消費速度を計算すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:17:54.786893", "ref": null}, "className": "Requirement"}
{"id": "f80bdaef-c7dd-45c7-a818-0fe64af1dc3e", "name": "方法選択検討要求", "text": "セル重量と天秤の測定精度などの状況に応じて、保存セルの重量変化測定（方法①）か、シール材テストピースを用いたカップ法試験（方法②）のいずれがベターか検討すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:17:54.788209", "ref": null}, "className": "Requirement"}
{"id": "0f55590f-1a45-48b6-97cf-b2ce578e4899", "name": "界面透過影響見積要求", "text": "カップ法による試験（方法②）を採用する場合は、シール材バルクの透過しか測定できないため、界面の電解液透過の影響度合いをヘリウムリーク試験などによって別途見積もること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:17:54.788923", "ref": null}, "className": "Requirement"}
{"id": "0dc29b6e-8080-4595-bbcc-7469f365643e", "name": "ストレス定義温度考慮要求", "text": "ストレスの定義にあたっては、カバーレンジ最悪の温度頻度分布をベースとし、シール部が導通経路に近い場合は通電による発熱影響を加味すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:17:54.790286", "ref": null}, "className": "Requirement"}
{"id": "4af278e4-aee4-49bd-ac93-f389a9a6c381", "name": "最新前提寿命計算要求", "text": "仕向け、車種、用途(V2H/V2G等)の開発途中での追加・変更に対応するため、指示書や各種連絡会での指示に基づき、その都度最新の前提で計算すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:17:54.790869", "ref": null}, "className": "Requirement"}
{"id": "67bde194-195c-4309-828f-394bdfbe0aa6", "name": "液枯れ時車両安全停止要求", "text": "液枯れが発生した電池を使用し続けた場合に発煙発火に至る不安全な事象を避けるため、適切な制御を介入させて車両を安全に停止すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:17:54.791310", "ref": null}, "className": "Requirement"}
{"id": "3cfa2d21-a36b-4468-ab26-235f1261e86c", "name": "液枯れ時最悪ケース考慮安全性確認要求", "text": "液枯れ時の安全性試験においては、起きうる最悪のLi析出量を考慮して高温保持等の安全性試験を確認すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:17:54.793016", "ref": null}, "className": "Requirement"}
{"id": "b18eed87-8fb0-4add-ae7c-f80bee8671e1", "name": "満充電容量ダイアグ閾値設計要求", "text": "液枯れ発生後の安全性を満充電容量推定で担保するため、(Fullcapダイアグ閾値) - (液枯れ発生点) < (安全性限界のLi析出量) の相関関係を満たすように閾値を設計すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:17:54.794421", "ref": null}, "className": "Requirement"}
{"id": "9232512f-393c-49e2-8f00-8de821d32e6b", "name": "ダイアグ閾値設計時の劣化要因考慮要求", "text": "製造上避けられないLi析出や、ハイレート劣化による析出が生じる場合はその析出量も考慮して、ダイアグ閾値について関係部署と協議し合意すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:17:54.795039", "ref": null}, "className": "Requirement"}
