{"id": "51a025d1-64fe-4183-b425-8bdf11a9b0ef", "name": "劣化量算出制約", "description": "満充電容量、抵抗劣化係数、およびスタック内抵抗劣化バラツキから、電池の総劣化量を推定します。バラツキ要因を安全マージンとして加味した劣化量の算出式です。", "inputNames": ["max_capacity", "resistance_degradation_factor", "stack_resistance_variation"], "outputNames": ["degradation_amount"], "parameters": {}, "code": "degradation_amount = max_capacity * resistance_degradation_factor * (1.0 + stack_resistance_variation)", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:30:52.041888", "ref": null}, "className": "ConstraintBlock"}
