{"id": "e64e450a-5774-4e16-900f-4ce71395f053", "name": "EOL拘束荷重制約", "description": "耐荷重超過によるMOD部品破損防止のため、MOD耐荷重上限がEOL拘束荷重を上回ることを確認する制約。", "inputNames": ["max_module_load", "eol_binding_load"], "outputNames": ["is_safe"], "parameters": {}, "code": "is_safe = max_module_load > eol_binding_load", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T09:07:11.570018", "ref": null}, "className": "ConstraintBlock"}
{"id": "5a2bb058-082b-4482-9e11-87db0106af25", "name": "最小拘束荷重制約", "description": "車両振動による電極集電箔等の破損防止のため、最小拘束荷重が電極体保持必要荷重を上回ることを確認する制約。", "inputNames": ["min_binding_load", "required_electrode_holding_load"], "outputNames": ["is_safe"], "parameters": {}, "code": "is_safe = min_binding_load > required_electrode_holding_load", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T09:07:11.570144", "ref": null}, "className": "ConstraintBlock"}
{"id": "90315503-fa9a-49ec-af87-8cbd25fe866e", "name": "拘束力F1算出制約", "description": "拘束力F1は、拘束力Fから缶の剛性(F3)を差し引いた値である。", "inputNames": ["f", "f_3"], "outputNames": ["f_1"], "parameters": {}, "code": "f_1 = f - f_3", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T09:07:11.570260", "ref": null}, "className": "ConstraintBlock"}
{"id": "75b3a433-de08-4487-8b3c-f0de02e87d74", "name": "電極体保持必要拘束力制約", "description": "電極体が動かないための必要拘束力Fを算出する。", "inputNames": ["f_3", "m", "x", "mu"], "outputNames": ["required_f"], "parameters": {}, "code": "required_f = f_3 + (m * 9.8 * x) / (mu * 2)", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T09:07:11.570374", "ref": null}, "className": "ConstraintBlock"}
{"id": "5d10ca27-07c0-4881-a8ac-3bb31fb0d692", "name": "静止摩擦係数算出制約", "description": "デジタルフォースゲージによる静止摩擦係数の算出。", "inputNames": ["max_pull_force", "weight"], "outputNames": ["mu_static"], "parameters": {}, "code": "mu_static = max_pull_force / (weight * 9.8)", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T09:07:11.570490", "ref": null}, "className": "ConstraintBlock"}
{"id": "a6fa7529-0c5c-4474-bd65-969a569efd53", "name": "必要最低拘束力制約", "description": "必要最低拘束力を算出する式。必要最低拘束力 = 缶-電極体接触に必要な荷重 + 電極体固定に必要な静止摩擦力", "inputNames": ["can_electrode_contact_load", "static_friction_force_for_electrode_fixation"], "outputNames": ["required_minimum_binding_force"], "parameters": {}, "code": "required_minimum_binding_force = can_electrode_contact_load + static_friction_force_for_electrode_fixation", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T09:07:11.570606", "ref": null}, "className": "ConstraintBlock"}
{"id": "48b80521-c98f-4ed7-a0dc-ce37589d73cb", "name": "電極体固定必要静止摩擦力制約", "description": "電極体固定に必要な静止摩擦力を算出する概念式。電極体重量＋電解液重量に静止摩擦係数と衝撃加速度を考慮して得られる関係。", "inputNames": ["electrode_weight", "electrolyte_weight", "gravity_acceleration", "impact_acceleration", "static_friction_coefficient"], "outputNames": ["static_friction_force_for_electrode_fixation"], "parameters": {}, "code": "static_friction_force_for_electrode_fixation = (electrode_weight + electrolyte_weight) * gravity_acceleration * impact_acceleration * static_friction_coefficient", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T09:07:11.570726", "ref": null}, "className": "ConstraintBlock"}
{"id": "b6b12eb8-27d7-4abc-a5fc-6e854d76d917", "name": "スタック耐荷重算出制約", "description": "強度下限値と安全率からスタック耐荷重を算出する関係式。", "inputNames": ["strength_lower_limit", "safety_factor"], "outputNames": ["stack_load_capacity"], "parameters": {}, "code": "stack_load_capacity = strength_lower_limit / safety_factor", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T09:07:11.570840", "ref": null}, "className": "ConstraintBlock"}
{"id": "22ffd681-14f2-4dc7-8f9b-cee1cdc6c094", "name": "反力合計制約", "description": "3つのロードセルの測定荷重を合計して反力を算出する。", "inputNames": ["load1", "load2", "load3"], "outputNames": ["total_load"], "parameters": {}, "code": "total_load = load1 + load2 + load3", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T09:07:11.571650", "ref": null}, "className": "ConstraintBlock"}
