{"id": "e3d87324-3a3d-462b-a6f8-3566a33b4ca9", "name": "要求", "description": "要求要素", "isReferenceModel": false, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-24T22:06:28.288799", "ref": null}, "className": "Package"}
{"id": "74288e6a-52e2-4fa9-93d7-1dada2c091fc", "name": "SOC-OCPデータ提供要求", "text": "電池データ要求書に基づき、SOC（セル基準、SOC1%刻み）に対する正極電位及び負極電位を回答すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-24T22:07:25.333679", "ref": null}, "className": "Requirement"}
{"id": "176763c7-4794-431e-9a3d-6e21a2497d24", "type": "containment", "sourceId": "e3d87324-3a3d-462b-a6f8-3566a33b4ca9", "targetId": "74288e6a-52e2-4fa9-93d7-1dada2c091fc", "name": null, "description": null, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-24T22:07:25.334201", "ref": null}, "connectorType": null, "flowType": null, "guard": null, "edgeType": null, "sequenceOrder": null, "className": "Relationship"}
{"id": "d0fc3adc-8ed5-455b-9776-f580e5c97206", "name": "正極・負極単極測定条件要求", "text": "正極（vs. Li/Li+）および負極（vs. Li/Li+）の単極電位測定は、指定されたPtn①および②の充放電条件（電圧、電流、終止条件、温度）に従って測定すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-24T22:07:25.334431", "ref": null}, "className": "Requirement"}
{"id": "c17c978a-379f-4e63-a219-5c0679d11c9a", "name": "参照極入り電池セル測定条件要求", "text": "参照極入り電池セルの測定（SOC-OCV測定）は、指定されたPtn①の充放電条件（電流:1/3C、容量:1%、休止:5h、温度:25℃）にて、SOC0⇔100%の間で繰り返し測定すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-24T22:07:25.334946", "ref": null}, "className": "Requirement"}
{"id": "87fac919-3be6-46a9-9481-5c544b41eaa0", "name": "参照極入り電池セル作成要求", "text": "解体したセルから正・負極電極を取り出し、作業要領書「01 ラボラミセル」に従って参照極入り電池セル（ラミ）を作成すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-24T22:07:25.335323", "ref": null}, "className": "Requirement"}
{"id": "26626bd2-b0c6-4874-9292-2ff00a959758", "name": "参照極入り電池セル測定条件適合要求（Ptn1）", "text": "Ptn1の条件として、充電時はCC充電（電流：0.1C、温度：50℃）、放電時はCC放電（電流：0.1C、温度：50℃）にて正極電位及び負極電位を取得すること。ただしSOC-OCVと大幅に乖離する場合はPtn2を採用すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-24T22:07:25.335558", "ref": null}, "className": "Requirement"}
{"id": "6b41d53f-3d25-46ca-ac19-4c39d2775d5d", "name": "参照極入り電池セル測定条件適合要求（Ptn2）", "text": "Ptn2の条件として、充電時はCC充電（電流：1/3C、容量：1~5%、休止：90分、温度：25℃、SOC0⇒100%繰り返し）、放電時はCCCV放電（電流：1/3C、容量：1~5%、休止：90分、温度：25℃、SOC100⇒0%繰り返し）にて正極電位及び負極電位を取得すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-24T22:07:25.335834", "ref": null}, "className": "Requirement"}
{"id": "424c509e-ee52-468e-ac58-6b003c845f4d", "name": "Li量シータ算出要求", "text": "正極および負極のLi量（実測容量/理論容量）を、各材料の理論容量に基づいて算出すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-24T22:07:25.336798", "ref": null}, "className": "Requirement"}
{"id": "40df55b6-65b7-41c5-a9ea-dbe9a9ecaae0", "name": "対応点算出要求", "text": "セルSOC0%における電圧値（3V）における正極および負極のLi量対応点を求めること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-24T22:07:25.337116", "ref": null}, "className": "Requirement"}
{"id": "63533d74-1318-4827-9674-a9c9bb9c1ce8", "name": "SOC別電位算出要求", "text": "対応点からSOC毎の正極電位及び負極電位を算出すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-24T22:07:25.337353", "ref": null}, "className": "Requirement"}
{"id": "6452b8ed-155e-46d7-80dd-c868cd3106ed", "name": "適合結果回答要求", "text": "算出したSOCと正極電位および負極電位の関係を電池データ要求書にて回答すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-24T22:07:25.337588", "ref": null}, "className": "Requirement"}
{"id": "cdb4c04f-55cd-4e4c-93ad-2b47de7aa1ef", "name": "正極電位及びセル電圧測定要求", "text": "参照極入り電池セルを用いて電池セル電圧とともに負極電位もしくは正極電位を測定により取得すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-24T22:07:25.337843", "ref": null}, "className": "Requirement"}
{"id": "f7eac31f-b787-4d9e-a66f-9151684c8ed1", "name": "負極電位計算要求", "text": "セル電圧から片方の電位からもう一方の電位を計算で求めること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-24T22:07:25.338157", "ref": null}, "className": "Requirement"}
{"id": "62aab465-04c2-4f56-97bc-9b9e6cc3b0de", "name": "SOCデータ修正・回答要求", "text": "求めた電位結果をSOC毎の数値に修正し、電池データ要求書に回答すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-24T22:07:25.338467", "ref": null}, "className": "Requirement"}
