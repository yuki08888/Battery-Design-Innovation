{"id": "1da7f7ed-d82e-4cdb-b6a3-2a802dc3ce66", "name": "BATs-001-02 排煙バルブ開弁圧力", "text": "熱拡散試験中、排煙バルブの開弁圧力は、熱拡散発生圧力より小さくすること。", "description": "熱拡散試験中、対象部品のシール部引張強度は、セル開弁圧力によってシール部に発生する引張荷重より高くなければならない。", "stereotypes": [], "risk": null, "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:29:35.625860", "ref": null}, "className": "Requirement"}
{"id": "43381194-5e8b-46be-8f91-81be56b61db7", "type": "containment", "sourceId": "cfcb364e-7491-4244-9119-3813b56a5247", "targetId": "1da7f7ed-d82e-4cdb-b6a3-2a802dc3ce66", "name": null, "description": null, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:29:35.625959", "ref": null}, "connectorType": null, "flowType": null, "guard": null, "edgeType": null, "sequenceOrder": null, "className": "Relationship"}
{"id": "8afeddb7-9692-488b-9ccd-c19e0f727ac9", "name": "BATs-004-02 絶縁保護材の耐熱要求確認", "text": "熱拡散試験後、活電部に絶縁保護材がある場合、対象部品の耐熱要件を確認し、耐熱要求の設定要否を判断すること。", "description": "熱拡散試験後、対象部品では、活電部とアッパーケースおよびPN間が絶縁材で保護されていなければならない。ただし、GNDとセル間の絶縁担保は除く。", "stereotypes": [], "risk": null, "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:29:35.630237", "ref": null}, "className": "Requirement"}
{"id": "eebcdc2c-1d70-4ba0-891b-11359a7e24b5", "type": "containment", "sourceId": "cfcb364e-7491-4244-9119-3813b56a5247", "targetId": "8afeddb7-9692-488b-9ccd-c19e0f727ac9", "name": null, "description": null, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:29:35.630284", "ref": null}, "connectorType": null, "flowType": null, "guard": null, "edgeType": null, "sequenceOrder": null, "className": "Relationship"}
{"id": "2164e247-a449-408f-9c4d-fbaf6da8dae8", "name": "BATs-006 衝突変形後の絶縁抵抗維持", "text": "衝突変形後、対象部品は絶縁抵抗を100MΩ以上に維持すること。", "description": null, "stereotypes": [], "risk": null, "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:29:35.632543", "ref": null}, "className": "Requirement"}
{"id": "7d1f5a85-7fa3-4809-ac1c-e68f209432c3", "type": "containment", "sourceId": "cfcb364e-7491-4244-9119-3813b56a5247", "targetId": "2164e247-a449-408f-9c4d-fbaf6da8dae8", "name": null, "description": null, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:29:35.632586", "ref": null}, "connectorType": null, "flowType": null, "guard": null, "edgeType": null, "sequenceOrder": null, "className": "Relationship"}
{"id": "3ef512f7-f1ac-4e77-8fe6-4e5ad8f93c87", "name": "BATs-006-02 衝突変形後のリークパス防止", "text": "対象部品は、衝突による割れ、変形または破損によって、保護対象範囲にリークパスを形成しないこと。", "description": null, "stereotypes": [], "risk": null, "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:29:35.634430", "ref": null}, "className": "Requirement"}
{"id": "c5c3aea4-6b7e-4c2b-a3f7-f16e39184e10", "type": "containment", "sourceId": "cfcb364e-7491-4244-9119-3813b56a5247", "targetId": "3ef512f7-f1ac-4e77-8fe6-4e5ad8f93c87", "name": null, "description": null, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:29:35.634465", "ref": null}, "connectorType": null, "flowType": null, "guard": null, "edgeType": null, "sequenceOrder": null, "className": "Relationship"}
{"id": "032c9f41-cd0a-434a-a7a4-10e73d6fd5dd", "name": "BATs-009-02 ブラスト後の絶縁抵抗維持", "text": "熱拡散試験後、対象部品は絶縁抵抗を100MΩ以上に維持すること。", "description": "熱拡散試験後、対象部品はブラストによる破損を生じてはならない。", "stereotypes": [], "risk": null, "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:29:35.648641", "ref": null}, "className": "Requirement"}
{"id": "1379d581-e8eb-4b6a-90b8-aadf27172bbf", "type": "containment", "sourceId": "cfcb364e-7491-4244-9119-3813b56a5247", "targetId": "032c9f41-cd0a-434a-a7a4-10e73d6fd5dd", "name": null, "description": null, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:29:35.648695", "ref": null}, "connectorType": null, "flowType": null, "guard": null, "edgeType": null, "sequenceOrder": null, "className": "Relationship"}
{"id": "f2e5f97a-b089-4c56-95bf-aaf1ca442a45", "name": "BATs-010-02 排煙バルブからの酸素逆流防止", "text": "熱拡散試験中、排煙バルブは外部から電池パック内部への酸素逆流を防止すること。", "description": "熱拡散試験後、対象部品ではシールの破損を生じてはならない。", "stereotypes": [], "risk": null, "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:29:35.651240", "ref": null}, "className": "Requirement"}
{"id": "f109ecd9-3cea-47fa-80d1-671a09858b28", "type": "containment", "sourceId": "cfcb364e-7491-4244-9119-3813b56a5247", "targetId": "f2e5f97a-b089-4c56-95bf-aaf1ca442a45", "name": null, "description": null, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:29:35.651288", "ref": null}, "connectorType": null, "flowType": null, "guard": null, "edgeType": null, "sequenceOrder": null, "className": "Relationship"}
{"id": "99aae3b2-2694-47b1-920a-c050cb9239b8", "name": "BATs-013-02 セル排煙箇所の限定", "text": "熱拡散試験中、セルからの排煙は安全弁からのみ行うこと。", "description": "熱拡散試験中、セルは安全弁以外の箇所に開口を生じてはならない。", "stereotypes": [], "risk": null, "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:29:35.653613", "ref": null}, "className": "Requirement"}
{"id": "a32754f7-2d7b-4967-bf79-767df0b7f5e5", "type": "containment", "sourceId": "cfcb364e-7491-4244-9119-3813b56a5247", "targetId": "99aae3b2-2694-47b1-920a-c050cb9239b8", "name": null, "description": null, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:29:35.653656", "ref": null}, "connectorType": null, "flowType": null, "guard": null, "edgeType": null, "sequenceOrder": null, "className": "Relationship"}
{"id": "6c0b8bd9-b5c2-4e39-aa49-6ed95f78ce89", "name": "BATs-015-02 測定条件およびばらつきの考慮", "text": "BATs-015の評価において、測定開始温度および部品ばらつきを考慮すること。", "description": "熱拡散試験中、対象部品は、隣接セルの腹両面における左右温度の平均値を150℃以下に維持しなければならない。", "stereotypes": [], "risk": null, "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:29:35.655577", "ref": null}, "className": "Requirement"}
{"id": "b5860a3c-b33f-46e6-8833-fc20b7d1ff2f", "type": "containment", "sourceId": "cfcb364e-7491-4244-9119-3813b56a5247", "targetId": "6c0b8bd9-b5c2-4e39-aa49-6ed95f78ce89", "name": null, "description": null, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:29:35.655624", "ref": null}, "connectorType": null, "flowType": null, "guard": null, "edgeType": null, "sequenceOrder": null, "className": "Relationship"}
{"id": "af3f811e-e41e-4b5e-8099-45fadcd79a19", "name": "BATs-017-02 シール部圧力の制限", "text": "熱暴走発生時、対象部品はシール部圧力をシール部の溶損・破損圧力未満に維持すること。", "description": "熱暴走発生時、対象部品はシール部温度をシール材の溶損温度未満に維持しなければならない。", "stereotypes": [], "risk": null, "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:29:35.659731", "ref": null}, "className": "Requirement"}
{"id": "70eee738-2bb2-4110-9020-40c78e7927ff", "type": "containment", "sourceId": "cfcb364e-7491-4244-9119-3813b56a5247", "targetId": "af3f811e-e41e-4b5e-8099-45fadcd79a19", "name": null, "description": null, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:29:35.659841", "ref": null}, "connectorType": null, "flowType": null, "guard": null, "edgeType": null, "sequenceOrder": null, "className": "Relationship"}
{"id": "55538b2a-eff4-428b-9776-15ff10a19b44", "name": "BATs-019-02 排煙バルブの噴出範囲外配置", "text": "Any positionにおいて、セルのブラスト角度±35度の範囲外に排煙バルブを配置すること。", "description": "対象部品は、排煙口と点火源との最短距離を45PL以上確保しなければならない。", "stereotypes": [], "risk": null, "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:29:35.662834", "ref": null}, "className": "Requirement"}
{"id": "97d6b668-8552-48b2-9cfb-6daddfa9cbdd", "type": "containment", "sourceId": "cfcb364e-7491-4244-9119-3813b56a5247", "targetId": "55538b2a-eff4-428b-9776-15ff10a19b44", "name": null, "description": null, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:29:35.662881", "ref": null}, "connectorType": null, "flowType": null, "guard": null, "edgeType": null, "sequenceOrder": null, "className": "Relationship"}
{"id": "312a62a3-86d1-4d00-a1a0-f6c8f4d98110", "name": "BATs-024-02 セル噴出範囲の制限", "text": "熱暴走発生時、セルからの噴出範囲をLi6.Bと同等以下とすること。", "description": "熱暴走発生時、セルから発生するガス圧力はLi6.Bと同等以下でなければならない。", "stereotypes": [], "risk": null, "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-08-22T14:29:35.664783", "ref": null}, "className": "Requirement"}
