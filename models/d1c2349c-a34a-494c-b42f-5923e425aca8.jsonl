{"id": "39f5a23e-af91-497a-8b41-5e4576cd2cf4", "name": "透過抵抗算出制約", "description": "シール高さH、シール外径r2、シール内径r1から透過抵抗Rを算出する式。", "inputNames": ["H", "r2", "r1"], "outputNames": ["R"], "parameters": {}, "code": "import math\nR = 1 / (2 * 3.141592653589793 * H) * math.log(r2 / r1)", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:58:11.051307", "ref": null}, "className": "ConstraintBlock"}
