{"id": "643499df-fbaa-4dd5-8b09-69241d5f52ea", "name": "セル外形体積計算", "description": "セルの奥行、横幅、高さから外形体積を算出します。", "inputNames": ["depth", "width", "height"], "outputNames": ["volume"], "parameters": {}, "code": "volume = depth * width * height", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:01:54.419519", "ref": null}, "className": "ConstraintBlock"}
