{"id": "8e67211b-5386-4600-8ee0-d1f8078d0396", "name": "液含浸比率算出制約", "description": "電極体の全体高さに対する電解液面高さの比率（液含浸比率）を算出します。", "inputNames": ["liquid_level", "electrode_height"], "outputNames": ["impregnation_ratio"], "parameters": {}, "code": "# 電極体高さに対する液面高さの比率（含浸比率）を算出する\nimpregnation_ratio = liquid_level / electrode_height", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:01:57.197810", "ref": null}, "className": "ConstraintBlock"}
