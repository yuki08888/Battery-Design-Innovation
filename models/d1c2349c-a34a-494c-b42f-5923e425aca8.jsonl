{"id": "1b1d3de5-f51e-4747-aba5-6e273405af76", "name": "缶底変形・クリアランス制約", "description": "25年および10年の缶底変形量から変形進展比率を算出し、かつセル内部空間高さから25年変形量を差し引いた残余クリアランスを計算します。", "inputNames": ["cell_internal_height"], "outputNames": ["years25_deformation", "years10_deformation", "ratio", "residual_clearance"], "parameters": {}, "code": "years25_deformation = 0.75\nyears10_deformation = 0.45\nratio = years25_deformation / years10_deformation\nresidual_clearance = cell_internal_height - years25_deformation", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:02:00.053321", "ref": null}, "className": "ConstraintBlock"}
