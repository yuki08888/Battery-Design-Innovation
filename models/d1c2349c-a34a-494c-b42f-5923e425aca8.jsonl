{"id": "3b31ecc7-3c36-4290-9bb9-c3406e1d8d61", "name": "戻り量近似式制約", "description": "耐久時間(LN Time)から戻り量を算出する近似式。ここでのxは対数時間LN Time[hr]、yは戻り量[mm]を表す。", "inputNames": ["x"], "outputNames": ["y"], "parameters": {}, "code": "y = -0.0133 * x + 0.2912", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:58:11.050726", "ref": null}, "className": "ConstraintBlock"}
