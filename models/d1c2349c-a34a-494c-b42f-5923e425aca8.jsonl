{"id": "bf5ce000-abb3-4abf-98cd-17b42f4ed1da", "name": "バルク水分浸入量算出制約", "description": "水分のバルク透過による侵入量を透過抵抗、透過係数、湿度、経過時間から算出する。", "inputNames": ["R", "alpha", "psi", "hr"], "outputNames": ["Q"], "parameters": {}, "code": "Q = (1 / R) * alpha * psi * hr", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:58:11.051209", "ref": null}, "className": "ConstraintBlock"}
