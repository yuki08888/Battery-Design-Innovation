{"id": "2d6432be-3720-4990-aabf-c7496bd42cb7", "name": "ピンホール径算出制約", "description": "Heリーククライテリアにおけるピンホール径Dを、Heの漏れ量、分子平均速度、ピンホール長さ、差圧から算出するハーゲン・ポアズイユ式の変形。", "inputNames": ["Q_He", "v", "L", "dP"], "outputNames": ["D"], "parameters": {}, "code": "pi = 3.141592653589793\nD = ( (12 * Q_He * L) / (pi * v * dP) ) ** (1/3.0)\noutputs = [D]", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:58:11.050949", "ref": null}, "className": "ConstraintBlock"}
