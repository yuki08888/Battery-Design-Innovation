{"id": "13015da1-d7d8-4eaa-9c24-3a2bc8ba0e96", "name": "液面初期高さ制約", "description": "液総量から液面初期高さ（mm）を概算・検証する関係を定義します。リチウムイオン電池セルにおける電解液量と初期の充填液面高さの関係を示します。", "inputNames": ["initial_liquid_mass"], "outputNames": ["initial_height"], "parameters": {}, "code": "initial_height = float(initial_liquid_mass) * 0.2046", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:01:54.625523", "ref": null}, "className": "ConstraintBlock"}
