{"id": "e91bb6d4-051e-47a7-8826-b16ea967f604", "name": "液枯れ判定制約", "description": "余剰液量が25年透過量を上回り、液枯れが起きないことを確認する関係式。余剰液残存量＝余剰液量ー25年透過量。", "inputNames": ["surplus_liquid", "penetration_25y"], "outputNames": ["remaining_liquid"], "parameters": {}, "code": "remaining_liquid = surplus_liquid - penetration_25y", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:58:11.051502", "ref": null}, "className": "ConstraintBlock"}
