{"id": "a1abd2b3-8bc8-439b-9bb8-d27af750eb32", "name": "蓋シール受け部厚み規格判定", "description": "蓋シール受け部の厚みが設計規格（例：2.0mm ± 0.2mm）の範囲内にあるかを判定する（1.0で合格、0.0で不合格）。", "inputNames": ["thickness"], "outputNames": ["is_acceptable"], "parameters": {}, "code": "is_acceptable = 1.0 if (thickness >= 1.8 and thickness <= 2.2) else 0.0", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:02:00.048906", "ref": null}, "className": "ConstraintBlock"}
