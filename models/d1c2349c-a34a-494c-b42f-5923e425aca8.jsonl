{"id": "a728fe85-7234-44fa-a3ae-36283ff6628b", "name": "電解液透過量温度依存性制約", "description": "Li7.A 電解液透過量の温度依存性を示すアレニウスプロットから得られた回帰式。温度の逆数から経時重量変化率の自然対数を算出する。", "inputNames": ["x"], "outputNames": ["y"], "parameters": {}, "code": "y = -4.218 * x + 5.2716", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:58:11.051404", "ref": null}, "className": "ConstraintBlock"}
