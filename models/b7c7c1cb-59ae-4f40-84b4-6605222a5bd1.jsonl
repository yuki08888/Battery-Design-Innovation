{"id": "b7c7c1cb-59ae-4f40-84b4-6605222a5bd1", "name": "要求", "description": "要求要素", "isReferenceModel": false, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:05:53.257055", "ref": null}, "className": "Package"}
{"id": "577af82f-5569-4e1c-9eed-4328c9926860", "name": "AC充電分極測定要求", "text": "AC充電時の満充電判定のため、AC充電の分極測定を実施すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:06:18.804431", "ref": null}, "className": "Requirement"}
{"id": "2ac7800f-c4fb-429d-95d3-74f6562b322e", "name": "DC充電分極測定要求", "text": "DC充電時のSOC算出のため、DC充電の分極測定を実施すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:06:18.804732", "ref": null}, "className": "Requirement"}
{"id": "5dd32345-d5df-4d13-b835-344407970d82", "name": "充放電分極測定要求", "text": "SOC推定のため、充放電時の分極測定を実施すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:06:18.805350", "ref": null}, "className": "Requirement"}
{"id": "549b0a2e-9733-4b82-b8ee-d39229e46b1a", "name": "充電最後温度計測要求", "text": "充電最後の温度は、車両搭載時のサーミスタ取付位置で測温すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:06:18.805506", "ref": null}, "className": "Requirement"}
{"id": "c5ca720c-2815-440e-a424-a0de61a50d1c", "name": "放電停止要求", "text": "放電容量は41Ah(SOC20%)とするが、下限電圧2.8Vに当たる場合は途中で放電を停止すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:06:18.805634", "ref": null}, "className": "Requirement"}
{"id": "d804359e-b835-4bcf-8855-56840365926e", "name": "充電電流制約要求", "text": "充電条件はLi析出しない電流範囲で実施すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:06:18.805755", "ref": null}, "className": "Requirement"}
{"id": "b20e0a3d-b442-4cd6-bf97-df958839c7ec", "name": "分極測定時間要求", "text": "充電終了後の分極解消目安として、90000秒程度計測すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:06:18.805876", "ref": null}, "className": "Requirement"}
{"id": "2ea99556-c3be-4b0e-a03e-fcc1bb96697b", "name": "分極解消判定閾値要求", "text": "分極解消の判定目安は、12時間で5mV以内（10000秒で1.16mV）とすること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:06:18.805995", "ref": null}, "className": "Requirement"}
{"id": "18db5689-f6d2-41bf-a86a-f486d626f8ae", "name": "AC充電判定閾値設計要求", "text": "AC充電モード充電電力切替判定OCVマップは、電池最高温度500ms平均値（℃）に対し、-30℃および-10℃で4.167V、0℃で4.161V、10℃で4.158V、25℃で4.155V、40℃および45℃で4.154Vの判定OCVマップ値を設定すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:06:18.806111", "ref": null}, "className": "Requirement"}
{"id": "71c41980-f159-4096-983e-0aa2fa7ebcee", "name": "DC充電判定閾値設計要求", "text": "DC充電モード充電電力切替判定OCVマップは、電池最高温度500ms平均値（℃）に対し、-30℃から45℃までの全指定温度範囲（-30℃, -10℃, 0℃, 10℃, 25℃, 40℃, 45℃）で一律4.143Vの判定OCVマップ値を設定すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:06:18.806225", "ref": null}, "className": "Requirement"}
{"id": "295bcb75-25f1-47f2-9317-311a359ab94e", "name": "放電条件電圧範囲要求", "text": "放電条件(-10℃95%)において、電圧を3.5Vから4.2Vの範囲で測定できること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:06:18.806338", "ref": null}, "className": "Requirement"}
{"id": "ed998f78-86ce-46a6-9002-09077902b4c3", "name": "充電条件電圧範囲要求", "text": "充電条件(10℃10%)において、電圧を3.4Vから3.75Vの範囲で測定できること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:06:18.806450", "ref": null}, "className": "Requirement"}
{"id": "7126bb98-aae5-492e-8a62-4156684b6638", "name": "電池データ要求", "text": "電池物性情報を定義した電池データ要求書を提供すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:06:18.806564", "ref": null}, "className": "Requirement"}
