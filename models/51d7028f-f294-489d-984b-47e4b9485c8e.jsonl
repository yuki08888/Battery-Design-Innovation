{"id": "202e8004-5043-41c6-a187-9c7044f56057", "name": "群外れ規格判定制約", "description": "電池モジュール内の最大セルOCVと最小セルOCVの差（ΔOCV）が、群外れ規格値以下であるかを判定します。", "inputNames": ["max_ocv", "min_ocv", "out_of_group_spec"], "outputNames": ["allowable_delta_ocv", "is_compliant"], "parameters": {}, "code": "allowable_delta_ocv = max_ocv - min_ocv\nis_compliant = 1 if allowable_delta_ocv <= out_of_group_spec else 0", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:39:11.927754", "ref": null}, "className": "ConstraintBlock"}
