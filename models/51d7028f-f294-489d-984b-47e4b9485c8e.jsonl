{"id": "a96fb546-27e7-4e27-bd4f-39691de80e3c", "name": "均等化回路暗電流による到達SOC算出制約", "description": "セル電圧均等化暗電流、放置日数、電池容量から放置後の到達SOCを算出する。 (放置後SOC(%) = 放置開始時SOC(%) - [暗電流I(A) × 24h/日 × 放置日数(日) ÷ 電池容量(Ah) × 100])", "inputNames": ["initial_soc", "dark_current", "elapsed_days", "battery_capacity"], "outputNames": ["remaining_soc"], "parameters": {}, "code": "remaining_soc = initial_soc - (dark_current * 24.0 * elapsed_days / battery_capacity * 100.0)", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:36:05.614618", "ref": null}, "className": "ConstraintBlock"}
