{"id": "115c41c7-0600-457a-8b13-614b189187c9", "name": "SOCばらつき制約", "description": "30日後のSOCばらつき（ΔSOC）が2.2%（上限+3σ - 下限-3σ）であるという関係を表す。", "inputNames": ["upper_limit_soc", "lower_limit_soc"], "outputNames": ["variation_delta_soc"], "parameters": {}, "code": "variation_delta_soc = upper_limit_soc - lower_limit_soc", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:36:05.615942", "ref": null}, "className": "ConstraintBlock"}
