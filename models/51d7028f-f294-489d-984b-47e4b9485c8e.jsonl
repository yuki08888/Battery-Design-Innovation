{"id": "5bd02f80-8bbb-410d-a6df-ebb8e20fc1a9", "name": "出荷SOC下限制約", "description": "モジュールの現在のSOCが、定義されたモジュール出荷SOC下限を上回っているかを検証します。", "inputNames": ["current_soc", "shipping_soc_min"], "outputNames": ["is_valid_shipping_soc"], "parameters": {}, "code": "is_valid_shipping_soc = 1 if current_soc >= shipping_soc_min else 0", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:39:11.929990", "ref": null}, "className": "ConstraintBlock"}
