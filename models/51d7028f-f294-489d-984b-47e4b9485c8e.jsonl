{"id": "2a6d12f8-f83d-4918-8ec8-7f9a2b02e5d3", "name": "パック出荷時電圧制約", "description": "パックの出荷時電圧は、セル単体の出荷時電圧と直列数の積として計算されます。", "inputNames": ["cell_shipping_voltage", "number_of_series_cells"], "outputNames": ["pack_shipping_voltage"], "parameters": {}, "code": "pack_shipping_voltage = cell_shipping_voltage * number_of_series_cells", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:39:13.050176", "ref": null}, "className": "ConstraintBlock"}
