{"id": "d62ab8f0-e361-4a96-92ed-abafa2eba307", "name": "電池セル自己放電による到達SOC算出制約", "description": "拡散方程式に基づき、自己放電係数と放置日数から放置後の到達SOCを算出する。 (放置後SOC(%) = 放置開始時SOC(%) - 自己放電係数(%/√t) × 放置日数(√t))", "inputNames": ["initial_soc", "self_discharge_coefficient", "elapsed_days"], "outputNames": ["remaining_soc"], "parameters": {}, "code": "import math\nremaining_soc = initial_soc - self_discharge_coefficient * math.sqrt(elapsed_days)", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T11:36:05.613280", "ref": null}, "className": "ConstraintBlock"}
