{"id": "bce11838-6420-42f9-b6ef-d57721970c72", "name": "内外温度差制御制約", "description": "電流値や目標内外温度差、遅れ係数などに基づき、現在の内外温度差（ΔT）を算出する。", "inputNames": ["delta_t_prev", "target_delta_t", "delta_time", "delay_coefficient"], "outputNames": ["delta_t_current"], "parameters": {}, "code": "delta_t_current = delta_t_prev + (target_delta_t - delta_t_prev) * delta_time * delay_coefficient", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:24:00.638837", "ref": null}, "className": "ConstraintBlock"}
