{"id": "9a27751f-f84c-443e-9140-53275398754b", "name": "内外温度差・電流関係制約", "description": "通電・冷却OFF評価における、電流の2乗(I²)と内外温度差の関係を定義する制約。内外温度差は電流の2乗に比例する。", "inputNames": ["current", "k"], "outputNames": ["temp_diff"], "parameters": {}, "code": "temp_diff = k * (current ** 2)", "language": "python", "simulationKind": "static", "simulationConfig": {}, "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T13:24:00.639639", "ref": null}, "className": "ConstraintBlock"}
