{"id": "5a196983-f9ad-4e85-84f3-fcdde691e73d", "name": "溶断特性設計要求", "text": "設計者は、想定される過電流に対してセルヒューズが適切に作動するよう、溶断特性を正確に設計すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:03:05.176622", "ref": null}, "className": "Requirement"}
