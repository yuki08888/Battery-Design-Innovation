{"id": "0b3de679-c98a-433f-ade9-d12416bfd9c5", "name": "電池パック短絡保護要求", "text": "電池パックでの短絡時は、電池パックメインヒューズで保護すること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:03:05.195078", "ref": null}, "className": "Requirement"}
{"id": "aa500b13-5604-4ffd-a718-b9f1d3c226a0", "name": "メインヒューズ消弧要求", "text": "電池パックメインヒューズは、導通部溶断時に発生するアークを安全に消し去ること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:03:05.197112", "ref": null}, "className": "Requirement"}
{"id": "2878cce4-ec84-4cce-ab1e-0bde3af7dc96", "name": "セル溶断特性最小保証要求", "text": "セル溶断特性がシステムでの電流時間特性以上であること。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:03:05.201122", "ref": null}, "className": "Requirement"}
{"id": "773817cd-b71e-40a1-a3c5-aa6e5a8568bd", "name": "過放電時セル溶断防止要求", "text": "満充電からVlow検知電圧(2.8V)までの電流時間特性とメインヒューズの電流時間特性 or OVLDの交点(低負荷側)にてセル溶断なきこと。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:03:05.205142", "ref": null}, "className": "Requirement"}
{"id": "f1918fa0-fd41-474c-a58e-3ef97cbabe0e", "name": "SMR遮断境界セル保護要求", "text": "SMR遮断域とメインヒューズの溶断特性の交点にてセル溶断なきこと(2600A×2sec)。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:03:05.207799", "ref": null}, "className": "Requirement"}
{"id": "50dafc44-c4eb-4667-9acb-2bc6516e1f82", "name": "メインヒューズ連動セル保護要求", "text": "ヒューズの溶断特性要求値以上でセルヒューズ溶断なきこと。", "description": null, "stereotypes": [], "risk": "high", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:03:05.208021", "ref": null}, "className": "Requirement"}
{"id": "d628c47b-984c-4e7c-9eac-aaf4d3fa248e", "name": "溶断時間定義整合確認要求", "text": "溶断時間の定義がメインヒューズと異なっている場合、実際のマッチングに不整合が生じるのを防ぐため、溶断時間の定義の整合確認を行うこと。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:03:05.208588", "ref": null}, "className": "Requirement"}
{"id": "4ace403a-f109-4d7e-9112-e50cd4699ed8", "name": "外挿による溶断時間推定要求", "text": "短絡電流が大きすぎてセルメーカーで評価を実施できない場合は、実施できる範囲の評価結果から、外挿により溶断時間を推定すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:03:05.212750", "ref": null}, "className": "Requirement"}
{"id": "cdb9b356-45c7-406b-953c-aa9d233518f3", "name": "セルヒューズ溶断試験波形確認要求", "text": "セルメーカーで実施したセルヒューズ溶断試験の波形データ（時間_電流）を確認すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:03:05.214710", "ref": null}, "className": "Requirement"}
{"id": "dff3a4c1-c02d-48dd-9efc-335d3bed273b", "name": "溶断I2t積算量算出要求", "text": "波形データ（時間_電流）から、ヒューズが溶断するまでのI^2tの積算量を算出すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:03:05.218648", "ref": null}, "className": "Requirement"}
{"id": "ff9e0b8f-315d-46bd-8934-aa100eec42e0", "name": "電流値と積算値の負の相関確認要求", "text": "電流値が大きくなるとlog(ΣI2t)が小さくなっていることを確認すること。", "description": null, "stereotypes": [], "risk": "low", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:03:05.222822", "ref": null}, "className": "Requirement"}
{"id": "f837d787-247d-47f7-b458-31f483f9c732", "name": "溶断積算値の推定要求", "text": "実施した最大電流と、一つ低い電流の電流とlog(ΣI2t)を直線で線形補完して、推定したい電流のlog(ΣI2t)を推定すること。", "description": null, "stereotypes": [], "risk": "medium", "requirementId": null, "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-25T12:03:05.224688", "ref": null}, "className": "Requirement"}
