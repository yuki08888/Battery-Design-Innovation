{"id": "6177f1a5-8546-41cc-b449-31600d64c547", "type": "action", "name": "平均放電電圧を算出する", "description": "1 It(A)放電での平均放電電圧(Wh/Ah)を算出する", "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-24T22:19:52.805460", "ref": null}, "actionSubType": "opaque", "body": "放電中の電力量(Wh)および容量(Ah)から、平均放電電圧(Wh/Ah)を算出し、実測平均放電電圧とする。", "language": "text", "behaviorRef": null, "objectType": null, "objectBlockRef": null, "inState": null, "upperBound": null, "ordering": null, "isFlowFinal": null, "decisionInput": null, "joinSpec": null, "className": "ActivityNode"}
