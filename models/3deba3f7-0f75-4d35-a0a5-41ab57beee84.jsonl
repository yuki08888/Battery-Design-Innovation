{"id": "642a2330-c8f9-4b5e-be34-eb7164cdafa1", "type": "action", "name": "放電容量を算出する", "description": "放電時の電流積算等から実測放電容量を算出する", "stereotypes": [], "metaData": {"version": 1.0, "createdBy": null, "createdDate": "2026-06-24T22:19:52.805116", "ref": null}, "actionSubType": "opaque", "body": "放電中に得られた電流値および時間から総放電容量を算出し、これを実測放電容量とする。", "language": "text", "behaviorRef": null, "objectType": null, "objectBlockRef": null, "inState": null, "upperBound": null, "ordering": null, "isFlowFinal": null, "decisionInput": null, "joinSpec": null, "className": "ActivityNode"}
