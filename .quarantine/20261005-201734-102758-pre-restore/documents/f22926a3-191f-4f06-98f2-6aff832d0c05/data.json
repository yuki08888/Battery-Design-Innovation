            "title": "ページ 4",
            "content": "<h2>第2 衝突性能一覧</h2>\n<p>各国法規・レーティング・社内規の衝突形態</p>\n<table>\n<thead>\n<tr>\n<th>車両仕向け</th>\n<th></th>\n<th></th>\n<th></th>\n<th></th>\n<th>法規名称</th>\n<th>形態</th>\n<th>詳細</th>\n<th>試験方法</th>\n<th>衝突方向</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>日本</td>\n<td>欧州</td>\n<td>米国</td>\n<td>韓国</td>\n<td>中国</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td>L / R</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td>●</td>\n<td></td>\n<td></td>\n<td>FMVSS305<br>[米国法規]</td>\n<td>前突</td>\n<td>30mph フルラップ</td>\n<td>図</td>\n<td></td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td>●</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td>90km/h オフセット</td>\n<td>図</td>\n<td>R</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td>●</td>\n<td></td>\n<td></td>\n<td></td>\n<td>側突</td>\n<td>30mph 右斜突</td>\n<td>図</td>\n<td>L</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td>●</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td>30mph 左斜突</td>\n<td>図</td>\n<td>R</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td>●</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td>54km/h MDB（フラット）</td>\n<td>図</td>\n<td>R</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td>●</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td>32km/h 斜めポール</td>\n<td>図</td>\n<td>L / R</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td>●</td>\n<td></td>\n<td></td>\n<td></td>\n<td>後突</td>\n<td>80km/h MDB</td>\n<td>図</td>\n<td>L / R</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td>●</td>\n<td></td>\n<td></td>\n<td>USNCAP<br>IIHS<br>[米国レーティング]</td>\n<td>前突</td>\n<td>35mph フルラップ</td>\n<td>図</td>\n<td></td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td>●</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td>64km/h ODB</td>\n<td>図</td>\n<td>L / R</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td>●</td>\n<td></td>\n<td></td>\n<td></td>\n<td>側突</td>\n<td>64km/h MDB</td>\n<td>図</td>\n<td>L / R</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td>●</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td>32km/h 斜めポール</td>\n<td>図</td>\n<td>L / R</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td>●</td>\n<td></td>\n<td></td>\n<td>UN-R94,95<br>UN-R135<br>UN-R137<br>[欧州・国内法規]</td>\n<td>前突</td>\n<td>50km/h フルラップ</td>\n<td>図</td>\n<td></td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td>●</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td>56km/h ODB</td>\n<td>図</td>\n<td>L / R</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td>●</td>\n<td></td>\n<td></td>\n<td></td>\n<td>側突</td>\n<td>50km/h MDB</td>\n<td>図</td>\n<td>L / R</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td>●</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td>32km/h 斜めポール</td>\n<td>図</td>\n<td>L / R</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td>●</td>\n<td></td>\n<td></td>\n<td></td>\n<td>後突</td>\n<td>50km/h MRB</td>\n<td>図</td>\n<td></td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td>●</td>\n<td></td>\n<td></td>\n<td>NCAP<br>[各国レーティング]</td>\n<td>前突</td>\n<td>55km/h フルラップ</td>\n<td>図</td>\n<td></td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td>●</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td>64km/h ODB</td>\n<td>図</td>\n<td>L / R</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td>●</td>\n<td></td>\n<td></td>\n<td></td>\n<td>側突</td>\n<td>50km/h MDB</td>\n<td>図</td>\n<td>L / R</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td>●</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td>50km/h M-PDB（50%ラップ→台車toCAR）</td>\n<td>図</td>\n<td>L</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td>●</td>\n<td></td>\n<td></td>\n<td></td>\n<td>後突</td>\n<td>55km/h AE-MDB</td>\n<td>図</td>\n<td>L / R</td>\n</tr>\n<tr>\n<td>●</td>\n<td>●</td>\n<td>●</td>\n<td>●</td>\n<td>●</td>\n<td>社内規格</td>\n<td>前突</td>\n<td>18km/h OLR</td>\n<td>図</td>\n<td>L / R</td>\n</tr>\n<tr>\n<td>●</td>\n<td>●</td>\n<td>●</td>\n<td>●</td>\n<td>●</td>\n<td></td>\n<td></td>\n<td>55km/h Car to Car<br>（50%ラップ→乗用車）</td>\n<td>図</td>\n<td>L / R</td>\n</tr>\n<tr>\n<td>●</td>\n<td>●</td>\n<td>●</td>\n<td>●</td>\n<td>●</td>\n<td></td>\n<td></td>\n<td>32km/h PCU細小ポール</td>\n<td>図</td>\n<td>L</td>\n</tr>\n<tr>\n<td>●</td>\n<td>●</td>\n<td>●</td>\n<td>●</td>\n<td>●</td>\n<td></td>\n<td></td>\n<td>32km/h 電池細小ポール</td>\n<td>図</td>\n<td>L</td>\n</tr>\n<tr>\n<td>●</td>\n<td>●</td>\n<td>●</td>\n<td>●</td>\n<td>●</td>\n<td>社内規格</td>\n<td>側突</td>\n<td>29km/h 直角ポール</td>\n<td>図</td>\n<td>L / R</td>\n</tr>\n<tr>\n<td>●</td>\n<td>●</td>\n<td>●</td>\n<td>●</td>\n<td>●</td>\n<td></td>\n<td></td>\n<td>60km/h SUV</td>\n<td>図</td>\n<td>L / R</td>\n</tr>\n<tr>\n<td>●</td>\n<td>●</td>\n<td>●</td>\n<td>●</td>\n<td>●</td>\n<td></td>\n<td></td>\n<td>60km/h Car to Car</td>\n<td>図</td>\n<td>L</td>\n</tr>\n<tr>\n<td>●</td>\n<td></td>\n<td></td>\n<td></td>\n<td>●</td>\n<td></td>\n<td></td>\n<td>積荷移動試験</td>\n<td>図</td>\n<td></td>\n</tr>\n<tr>\n<td>●</td>\n<td>●</td>\n<td>●</td>\n<td>●</td>\n<td>●</td>\n<td></td>\n<td>後突</td>\n<td>55km/h Car to Car<br>（50%ラップ→乗用車）</td>\n<td>図</td>\n<td>L / R</td>\n</tr>\n<tr>\n<td></td>\n<td></td>\n<td>●</td>\n<td>●</td>\n<td></td>\n<td></td>\n<td></td>\n<td>88km/h MDB（※1）<br>車幅の50%</td>\n<td>図</td>\n<td>L / R</td>\n</tr>\n<tr>\n<td>●</td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td></td>\n<td>ダイナ後突</td>\n<td>—</td>\n<td>—</td>\n</tr>\n</tbody>\n</table>",
