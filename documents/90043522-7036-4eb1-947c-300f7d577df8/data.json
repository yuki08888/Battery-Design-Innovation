    "digest": {
        "overview": {
            "summary": "本書は「EHV電池設備部 電池パック設計基準（3B）」のパック方式における防水シール設計・品質・検査基準を定める文書で、初回制定日は2021年3月31日です。車室外の駆動用バッテリ電池パックを対象に、冠水や高圧洗車を想定したシール耐力、水侵入量、二重保護、製造不良検出の考え方と目標を示します。さらに、フランジおよび接着構造の設計例、プレス接着の工程管理、水入り時の許容基準を記載しています。最後に、リニアチェンジによる全数検査と格盤設置・判定基準を示し、防水保証に必要な確認方法をまとめています。",
            "documentKind": "requirement_spec",
            "purpose": "車室外の駆動用バッテリ電池パックについて、防水シール設計・品質・検査の基本方針と具体的な基準・管理方法を示す。",
            "scope": "床下・車室外搭載の電池パックを対象に、鋼板・アルミ・樹脂製ケースとゴムシール・ウレタン・接着剤による防水構造、工程管理、水入り基準および検査を扱う。",
            "keyTopics": [
                "適用範囲と防水シール設計の基本方針",
                "シール耐力目標と水侵入量の確認",
                "二重保護構造と高電圧部品の被水防止",
                "床下電池パックの実測圧力と高圧洗車条件",
                "フランジ・接着シール構造の設計要件",
                "プレス接着工程の清掃・塗布・圧着・時間管理",
                "パック水入り時の許容水量と検知基準",
                "リニアチェンジ全数検査と格盤設置基準"
            ],
            "keyTerms": [
                {
                    "term": "二重保護構造",
                    "definition": "一次シールで水浸入を防ぎ、シール不良時にも高電圧部品への被水を抑制するための設計方針。"
                },
                {
                    "term": "リークチェッカ",
                    "definition": "製造不良を検出するため、設定したシール規格に基づいて出荷検査を行う装置。"
                },
                {
                    "term": "WRTケース",
                    "definition": "シール部品を組み付け、水侵入量を確認するために用いるケース。"
                },
                {
                    "term": "リニアチェンジ",
                    "definition": "電池パックの防水保証のため、組付け後などに全数実施する漏れ検査。"
                },
                {
                    "term": "リニアチェンジ格盤",
                    "definition": "設備検出限界での出来高を定めるために設置する、リニアチェンジ用の基準設備。"
                },
                {
                    "term": "水入り検知",
                    "definition": "パック内への水の浸入を検知する機能・基準で、関連する品質基準を参照する。"
                }
            ],
            "targetSystem": "EHV電池設備部 電池パック"
        },
